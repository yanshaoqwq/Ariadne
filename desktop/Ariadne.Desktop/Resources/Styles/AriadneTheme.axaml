<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Ariadne.Desktop.Controls">
  <!--
    Ariadne 风格地基（Win11 / Fluent 方向）
    - 设计目标：轻盈、精致、桌面感、阅读舒适，扔掉网页感。
    - 分层而非描边：窗口底为 Mica，内容浮在「层」上，靠极淡背景差 + 发丝边框 + 柔和投影区分。
    - 强调色克制：青绿 teal 仅用于主操作 / 选中指示 / 焦点。
    - 主题：system/light/dark 由 ThemeDictionaries(Light/Dark) 驱动，跟随系统。
      命名主题（ink/azure/rose/…）由 ThemeCatalog + ThemeApplication 在运行时覆盖
      DynamicResource 笔刷（中性底 + 强调色），对齐 settings-theme-spec §6 调色板。
    - UI 整体交互权威：指导性文件/ui设计方案.md（Avalonia 桌面，无 WebUI）。
    - 命名约定：颜色 = Ariadne.Color.* ；笔刷 = Ariadne.* （沿用既有 key，旧视图无需改动）。
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <!-- ========================= 浅色（清昼，默认强调=青绿） ========================= -->
        <ResourceDictionary x:Key="Light">
          <!-- 背景层：明确 5 级阶梯——壳 / 导轨凹槽 / 工作区 / 纸面 / 浮起纸面（U71）。
               关键：相邻层明度差必须够大（≥4 点），否则整屏塌成一片灰。
               导轨(Subtle) 是最深的「凹槽」，浮起的纸片(Elevated) 是最亮的白，
               两者相差 ~10 点明度，撬起动效才有立体依据。 -->
          <Color x:Key="Ariadne.Color.WindowBase">#D4DAD8</Color>
          <Color x:Key="Ariadne.Color.BackgroundMain">#EDF0EE</Color>
          <Color x:Key="Ariadne.Color.BackgroundSurface">#FAFBFA</Color>
          <Color x:Key="Ariadne.Color.BackgroundElevated">#FFFFFF</Color>
          <!-- Win11 毛玻璃菜单：高透明白 + 微冷灰，靠阴影/圆角成形 -->
          <Color x:Key="Ariadne.Color.MenuBackground">#D9F7F9FB</Color>
          <Color x:Key="Ariadne.Color.GlassTint">#E8F4F6F8</Color>
          <Color x:Key="Ariadne.Color.GlassBorder">#66FFFFFF</Color>
          <Color x:Key="Ariadne.Color.Scrim">#59000000</Color>
          <!-- 导轨凹槽：比主内容面明显更深，让纸片能从中「撬」出来 -->
          <Color x:Key="Ariadne.Color.BackgroundSubtle">#E2E7E4</Color>
          <!-- 日志级别 chip 不透明底（保证 caption 对比度 ≥4.5:1，U70） -->
          <Color x:Key="Ariadne.Color.LogErrorBg">#FEE2E2</Color>
          <Color x:Key="Ariadne.Color.LogWarningBg">#FEF3C7</Color>
          <Color x:Key="Ariadne.Color.LogInfoBg">#DBEAFE</Color>
          <Color x:Key="Ariadne.Color.BackgroundHover">#14000000</Color>
          <Color x:Key="Ariadne.Color.BackgroundPressed">#1F000000</Color>
          <Color x:Key="Ariadne.Color.BackgroundCode">#F0F3F6</Color>
          <!-- 文字 -->
          <Color x:Key="Ariadne.Color.TextHeading">#15181B</Color>
          <Color x:Key="Ariadne.Color.TextPrimary">#1B1F22</Color>
          <Color x:Key="Ariadne.Color.TextSecondary">#5B6469</Color>
          <Color x:Key="Ariadne.Color.TextSubtle">#7A848C</Color>
          <Color x:Key="Ariadne.Color.TextOnAccent">#FFFFFF</Color>
          <Color x:Key="Ariadne.Color.BorderDefault">#C5CDCA</Color>
          <Color x:Key="Ariadne.Color.BorderMuted">#D8DEDC</Color>
          <Color x:Key="Ariadne.Color.BorderStrong">#9FAAA6</Color>
          <Color x:Key="Ariadne.Color.BorderCard">#14140A00</Color>
          <Color x:Key="Ariadne.Color.FocusRing">#2E726B</Color>
          <!-- 强调（青绿） -->
          <Color x:Key="Ariadne.Color.AccentPrimary">#2E726B</Color>
          <Color x:Key="Ariadne.Color.AccentHover">#25605A</Color>
          <Color x:Key="Ariadne.Color.AccentPressed">#1F524D</Color>
          <Color x:Key="Ariadne.Color.AccentLight">#1F2E726B</Color>
          <Color x:Key="Ariadne.Color.AccentBorder">#662E726B</Color>
          <!-- 状态 -->
          <Color x:Key="Ariadne.Color.StatusInfo">#2563EB</Color>
          <Color x:Key="Ariadne.Color.StatusSuccess">#0F9D63</Color>
          <Color x:Key="Ariadne.Color.StatusWarning">#D97706</Color>
          <Color x:Key="Ariadne.Color.StatusError">#DC2626</Color>
          <!-- 运行态 -->
          <Color x:Key="Ariadne.Color.RuntimeIdle">#9AA0A8</Color>
          <Color x:Key="Ariadne.Color.RuntimeRunning">#2E726B</Color>
          <Color x:Key="Ariadne.Color.RuntimePaused">#D97706</Color>
          <Color x:Key="Ariadne.Color.RuntimePending">#2563EB</Color>
          <Color x:Key="Ariadne.Color.RuntimeApproved">#0F9D63</Color>
          <Color x:Key="Ariadne.Color.RuntimeRejected">#DC2626</Color>
          <!-- Git -->
          <Color x:Key="Ariadne.Color.GitAuto">#8A8F98</Color>
          <Color x:Key="Ariadne.Color.GitManual">#F59E0B</Color>
          <Color x:Key="Ariadne.Color.GitCurrent">#2E726B</Color>
          <Color x:Key="Ariadne.Color.GitBranch">#6366F1</Color>
          <Color x:Key="Ariadne.Color.GitFolded">#B9C0BB</Color>
          <Color x:Key="Ariadne.Color.CanvasBackground">#E9EEEC</Color>
          <Color x:Key="Ariadne.Color.CanvasGrid">#CCD5D2</Color>
          <Color x:Key="Ariadne.Color.NodeBackground">#FFFFFF</Color>
          <!-- 磨砂玻璃节点底：半透明白，让画布点阵透出，营造玻璃悬浮感。
               U162-D：alpha 从 F2(94.9%) 降到 B8(72%)。原值只让 5% 的画布透出来，
               在 #E9EEEC 底与 #CCD5D2 点阵之间只差 1/255——视觉上等于纯色，
               「玻璃」这个说法名不副实。72% 时两者差 8/255，点阵确实隐隐可见。 -->
          <Color x:Key="Ariadne.Color.NodeGlass">#B8FBFCFD</Color>
          <!-- 节点底渐变的实心端：与玻璃端同色相、全不透明，形成「上透下实」的纵深 -->
          <Color x:Key="Ariadne.Color.NodeGlassSolid">#FFFBFCFD</Color>
          <Color x:Key="Ariadne.Color.NodeBorder">#C9D3DD</Color>
          <Color x:Key="Ariadne.Color.NodeSelected">#2E726B</Color>
          <Color x:Key="Ariadne.Color.EdgeData">#2E726B</Color>
          <Color x:Key="Ariadne.Color.EdgeControl">#8A9490</Color>
          <Color x:Key="Ariadne.Color.EdgeCommunication">#7C3AED</Color>
          <!-- 编辑 / diff -->
          <Color x:Key="Ariadne.Color.EditorBackground">#FAFBFC</Color>
          <Color x:Key="Ariadne.Color.EditorSelection">#2E2E726B</Color>
          <Color x:Key="Ariadne.Color.DiffAddBackground">#24059669</Color>
          <Color x:Key="Ariadne.Color.DiffRemoveBackground">#1FDC2626</Color>

          <!-- 笔刷（引用同字典颜色，随变体切换） -->
          <SolidColorBrush x:Key="Ariadne.WindowBase" Color="{StaticResource Ariadne.Color.WindowBase}" />
          <SolidColorBrush x:Key="Ariadne.BackgroundMain" Color="{StaticResource Ariadne.Color.BackgroundMain}" />
          <SolidColorBrush x:Key="Ariadne.BackgroundSurface" Color="{StaticResource Ariadne.Color.BackgroundSurface}" />
          <SolidColorBrush x:Key="Ariadne.BackgroundElevated" Color="{StaticResource Ariadne.Color.BackgroundElevated}" />
          <SolidColorBrush x:Key="Ariadne.MenuBackground" Color="{StaticResource Ariadne.Color.MenuBackground}" />
          <SolidColorBrush x:Key="Ariadne.GlassTint" Color="{StaticResource Ariadne.Color.GlassTint}" />
          <SolidColorBrush x:Key="Ariadne.GlassBorder" Color="{StaticResource Ariadne.Color.GlassBorder}" />
          <SolidColorBrush x:Key="Ariadne.Scrim" Color="{StaticResource Ariadne.Color.Scrim}" />
          <SolidColorBrush x:Key="Ariadne.BackgroundSubtle" Color="{StaticResource Ariadne.Color.BackgroundSubtle}" />
          <SolidColorBrush x:Key="Ariadne.BackgroundHover" Color="{StaticResource Ariadne.Color.BackgroundHover}" />
          <SolidColorBrush x:Key="Ariadne.BackgroundPressed" Color="{StaticResource Ariadne.Color.BackgroundPressed}" />
          <SolidColorBrush x:Key="Ariadne.BackgroundCode" Color="{StaticResource Ariadne.Color.BackgroundCode}" />
          <SolidColorBrush x:Key="Ariadne.TextHeading" Color="{StaticResource Ariadne.Color.TextHeading}" />
          <SolidColorBrush x:Key="Ariadne.TextPrimary" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <SolidColorBrush x:Key="Ariadne.TextSecondary" Color="{StaticResource Ariadne.Color.TextSecondary}" />
          <SolidColorBrush x:Key="Ariadne.TextSubtle" Color="{StaticResource Ariadne.Color.TextSubtle}" />
          <SolidColorBrush x:Key="Ariadne.TextOnAccent" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="Ariadne.BorderDefault" Color="{StaticResource Ariadne.Color.BorderDefault}" />
          <SolidColorBrush x:Key="Ariadne.BorderMuted" Color="{StaticResource Ariadne.Color.BorderMuted}" />
          <SolidColorBrush x:Key="Ariadne.BorderStrong" Color="{StaticResource Ariadne.Color.BorderStrong}" />
          <SolidColorBrush x:Key="Ariadne.BorderCard" Color="{StaticResource Ariadne.Color.BorderCard}" />
          <SolidColorBrush x:Key="Ariadne.FocusRing" Color="{StaticResource Ariadne.Color.FocusRing}" />
          <!-- U181-C/D：键盘焦点环的 BoxShadows 形态。
               **必须是每个变体各一份**，且必须放在 ThemeDictionaries 里：
               `BoxShadows` 是不可拆的字面量类型，颜色部分**没法**绑到
               `Ariadne.FocusRing` 画刷上 —— 所以这里是「焦点环颜色」在 XAML 侧
               唯一能落脚的地方，`0 0 0 3 #B3xxxxxx` 里那个色值必须与本变体的
               `Ariadne.Color.FocusRing` 同源，B3 = 70% alpha。
               `ThemeApplication.SetFocusRingShadow` 会在个性化换色时按新强调色
               重写这个键，所以它随主题走，不是一处写死的魔法值。
               3px 而非 2px：环画在节点卡外缘，卡片本身已有 1px 描边 + 三层投影，
               2px 会被投影吃掉（暗色主题下尤其明显）。 -->
          <BoxShadows x:Key="Ariadne.Shadow.FocusRing">0 0 0 3 #FF2E726B</BoxShadows>
          <BoxShadows x:Key="Ariadne.Shadow.FocusRingCard">0 0 0 3 #FF2E726B, 0 2 4 0 #1C000000, 0 14 30 -8 #38000000, 0 30 64 -22 #30000000</BoxShadows>
          <SolidColorBrush x:Key="Ariadne.AccentPrimary" Color="{StaticResource Ariadne.Color.AccentPrimary}" />
          <SolidColorBrush x:Key="Ariadne.AccentHover" Color="{StaticResource Ariadne.Color.AccentHover}" />
          <SolidColorBrush x:Key="Ariadne.AccentPressed" Color="{StaticResource Ariadne.Color.AccentPressed}" />
          <SolidColorBrush x:Key="Ariadne.AccentLight" Color="{StaticResource Ariadne.Color.AccentLight}" />
          <SolidColorBrush x:Key="Ariadne.AccentBorder" Color="{StaticResource Ariadne.Color.AccentBorder}" />
          <SolidColorBrush x:Key="Ariadne.StatusInfo" Color="{StaticResource Ariadne.Color.StatusInfo}" />
          <SolidColorBrush x:Key="Ariadne.StatusSuccess" Color="{StaticResource Ariadne.Color.StatusSuccess}" />
          <SolidColorBrush x:Key="Ariadne.StatusWarning" Color="{StaticResource Ariadne.Color.StatusWarning}" />
          <SolidColorBrush x:Key="Ariadne.StatusError" Color="{StaticResource Ariadne.Color.StatusError}" />
          <SolidColorBrush x:Key="Ariadne.LogErrorBg" Color="{StaticResource Ariadne.Color.LogErrorBg}" />
          <SolidColorBrush x:Key="Ariadne.LogWarningBg" Color="{StaticResource Ariadne.Color.LogWarningBg}" />
          <SolidColorBrush x:Key="Ariadne.LogInfoBg" Color="{StaticResource Ariadne.Color.LogInfoBg}" />
          <SolidColorBrush x:Key="Ariadne.RuntimeIdle" Color="{StaticResource Ariadne.Color.RuntimeIdle}" />
          <SolidColorBrush x:Key="Ariadne.RuntimeRunning" Color="{StaticResource Ariadne.Color.RuntimeRunning}" />
          <SolidColorBrush x:Key="Ariadne.RuntimePaused" Color="{StaticResource Ariadne.Color.RuntimePaused}" />
          <SolidColorBrush x:Key="Ariadne.RuntimePending" Color="{StaticResource Ariadne.Color.RuntimePending}" />
          <SolidColorBrush x:Key="Ariadne.RuntimeApproved" Color="{StaticResource Ariadne.Color.RuntimeApproved}" />
          <SolidColorBrush x:Key="Ariadne.RuntimeRejected" Color="{StaticResource Ariadne.Color.RuntimeRejected}" />
          <SolidColorBrush x:Key="Ariadne.GitAuto" Color="{StaticResource Ariadne.Color.GitAuto}" />
          <SolidColorBrush x:Key="Ariadne.GitManual" Color="{StaticResource Ariadne.Color.GitManual}" />
          <SolidColorBrush x:Key="Ariadne.GitCurrent" Color="{StaticResource Ariadne.Color.GitCurrent}" />
          <SolidColorBrush x:Key="Ariadne.GitBranch" Color="{StaticResource Ariadne.Color.GitBranch}" />
          <SolidColorBrush x:Key="Ariadne.GitFolded" Color="{StaticResource Ariadne.Color.GitFolded}" />
          <SolidColorBrush x:Key="Ariadne.CanvasBackground" Color="{StaticResource Ariadne.Color.CanvasBackground}" />
          <SolidColorBrush x:Key="Ariadne.CanvasGrid" Color="{StaticResource Ariadne.Color.CanvasGrid}" />
          <SolidColorBrush x:Key="Ariadne.NodeBackground" Color="{StaticResource Ariadne.Color.NodeBackground}" />
          <SolidColorBrush x:Key="Ariadne.NodeGlass" Color="{StaticResource Ariadne.Color.NodeGlass}" />
          <!-- 节点卡片底：顶部半透明（画布点阵透出）纵向过渡到底部实心，取代类型色晕染。
               U162-D：实心过渡点 0.62 → 0.45。透明段更短但**更透**，
               而节点正文（提示词文本）从 0.45 起就落在完全实心段上——
               这是硬约束：正文压在透出的点阵上会掉可读性，
               「像玻璃」不能拿正文清晰度去换。
               ⚠️ 这条渐变没有任何模糊，本质是「更透的色块」而非亚克力。
               真亚克力要 ExperimentalAcrylicBorder（见 Ariadne.Acrylic.Menu/Dialog），
               但它的 BackgroundSource 只有 None 与 Digger 两种，
               **Digger 是「凿穿所有渲染层去取窗口背景」**——节点后面的画布点阵
               本身就是渲染层的一部分，会被一起凿掉，所以它连原理上都做不到
               「模糊节点身后的点阵」。改用它只会让节点透出桌面壁纸。 -->
          <LinearGradientBrush x:Key="Ariadne.NodeGlassFill" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="{StaticResource Ariadne.Color.NodeGlass}" />
            <GradientStop Offset="0.45" Color="{StaticResource Ariadne.Color.NodeGlassSolid}" />
            <GradientStop Offset="1" Color="{StaticResource Ariadne.Color.NodeGlassSolid}" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="Ariadne.NodeBorder" Color="{StaticResource Ariadne.Color.NodeBorder}" />
          <SolidColorBrush x:Key="Ariadne.NodeSelected" Color="{StaticResource Ariadne.Color.NodeSelected}" />
          <SolidColorBrush x:Key="Ariadne.EdgeData" Color="{StaticResource Ariadne.Color.EdgeData}" />
          <SolidColorBrush x:Key="Ariadne.EdgeControl" Color="{StaticResource Ariadne.Color.EdgeControl}" />
          <SolidColorBrush x:Key="Ariadne.EdgeCommunication" Color="{StaticResource Ariadne.Color.EdgeCommunication}" />
          <SolidColorBrush x:Key="Ariadne.EditorBackground" Color="{StaticResource Ariadne.Color.EditorBackground}" />
          <SolidColorBrush x:Key="Ariadne.EditorSelection" Color="{StaticResource Ariadne.Color.EditorSelection}" />
          <SolidColorBrush x:Key="Ariadne.DiffAddBackground" Color="{StaticResource Ariadne.Color.DiffAddBackground}" />
          <SolidColorBrush x:Key="Ariadne.DiffRemoveBackground" Color="{StaticResource Ariadne.Color.DiffRemoveBackground}" />
          <!-- 微观打磨：深色提示气泡 + 细滚动条滑块（浅色主题下用墨色半透明） -->
          <SolidColorBrush x:Key="Ariadne.TooltipBackground" Color="#F22B3230" />
          <SolidColorBrush x:Key="Ariadne.TooltipText" Color="#F4F7F5" />
          <!-- U184：FluentTheme 的 CheckBox / Slider 资源键覆盖。
               **必须放在 ThemeDictionaries 的 Light/Dark 两份里各一套**，
               不能只在外层 Styles.Resources 放一份 —— 这是截图实测抓出来的：
               外层那份画刷的 `{DynamicResource Ariadne.Color.*}` 只解析一次、
               不带主题变体上下文，于是**暗色主题下拿到的是亮色的值**。
               症状：暗色下已启用复选框的标签文字是深色贴深底、整行看不见
               （而禁用那几行反而看得见，因为走的是另一个键）。
               这里用 StaticResource：同一份字典内的引用，随字典整体切换。
               各键为何取这些 token，见文件下方 Styles.Resources 里的注释块。 -->
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="Transparent" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="{StaticResource Ariadne.Color.BackgroundPressed}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedDisabled" Color="Transparent" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{StaticResource Ariadne.Color.BorderDefault}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{StaticResource Ariadne.Color.BorderStrong}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" Color="{StaticResource Ariadne.Color.BorderStrong}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedDisabled" Color="{StaticResource Ariadne.Color.BorderMuted}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource Ariadne.Color.AccentPrimary}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource Ariadne.Color.AccentHover}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource Ariadne.Color.AccentPressed}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedDisabled" Color="{StaticResource Ariadne.Color.BorderStrong}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{StaticResource Ariadne.Color.AccentHover}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="Transparent" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedDisabled" Color="Transparent" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedDisabled" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminate" Color="{StaticResource Ariadne.Color.AccentPrimary}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePointerOver" Color="{StaticResource Ariadne.Color.AccentHover}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePressed" Color="{StaticResource Ariadne.Color.AccentPressed}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminateDisabled" Color="{StaticResource Ariadne.Color.BorderStrong}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminate" Color="{StaticResource Ariadne.Color.AccentPrimary}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePointerOver" Color="{StaticResource Ariadne.Color.AccentHover}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePressed" Color="{StaticResource Ariadne.Color.AccentPressed}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminateDisabled" Color="Transparent" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminate" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminatePointerOver" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminatePressed" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminateDisabled" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPointerOver" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPressed" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <SolidColorBrush x:Key="CheckBoxForegroundUncheckedDisabled" Color="{StaticResource Ariadne.Color.TextSubtle}" />
          <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <SolidColorBrush x:Key="CheckBoxForegroundCheckedPointerOver" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <SolidColorBrush x:Key="CheckBoxForegroundCheckedPressed" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <SolidColorBrush x:Key="CheckBoxForegroundCheckedDisabled" Color="{StaticResource Ariadne.Color.TextSubtle}" />
          <SolidColorBrush x:Key="CheckBoxForegroundIndeterminate" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <SolidColorBrush x:Key="CheckBoxForegroundIndeterminatePointerOver" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <SolidColorBrush x:Key="CheckBoxForegroundIndeterminatePressed" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <SolidColorBrush x:Key="CheckBoxForegroundIndeterminateDisabled" Color="{StaticResource Ariadne.Color.TextSubtle}" />
          <SolidColorBrush x:Key="SliderTrackFill" Color="{StaticResource Ariadne.Color.BackgroundHover}" />
          <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="{StaticResource Ariadne.Color.BackgroundPressed}" />
          <SolidColorBrush x:Key="SliderTrackFillPressed" Color="{StaticResource Ariadne.Color.BackgroundPressed}" />
          <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="{StaticResource Ariadne.Color.BorderMuted}" />
          <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource Ariadne.Color.AccentPrimary}" />
          <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{StaticResource Ariadne.Color.AccentHover}" />
          <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{StaticResource Ariadne.Color.AccentPressed}" />
          <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="{StaticResource Ariadne.Color.BorderStrong}" />
          <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource Ariadne.Color.AccentPrimary}" />
          <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource Ariadne.Color.AccentHover}" />
          <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{StaticResource Ariadne.Color.AccentPressed}" />
          <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="{StaticResource Ariadne.Color.BorderStrong}" />
          <SolidColorBrush x:Key="SliderTickBarFill" Color="{StaticResource Ariadne.Color.TextSubtle}" />
          <SolidColorBrush x:Key="SliderTickBarFillDisabled" Color="{StaticResource Ariadne.Color.BorderMuted}" />
          <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <!-- U213-E：ToggleSwitch 资源键覆盖（浅色）。理由与键名清单见文件下方
               `Styles.Resources` 里的 U213-E 注释块。与 CheckBox 同因同治：
               必须在 Light/Dark **各放一份**，外层放一份会让暗色拿到亮色的值。 -->
          <SolidColorBrush x:Key="ToggleSwitchContainerBackground" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleSwitchContainerBackgroundPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleSwitchContainerBackgroundPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleSwitchContentForeground" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <SolidColorBrush x:Key="ToggleSwitchHeaderForegroundDisabled" Color="{StaticResource Ariadne.Color.TextSubtle}" />
          <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="{StaticResource Ariadne.Color.BackgroundHover}" />
          <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="{StaticResource Ariadne.Color.BackgroundPressed}" />
          <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{StaticResource Ariadne.Color.BorderDefault}" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="{StaticResource Ariadne.Color.BorderStrong}" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="{StaticResource Ariadne.Color.BorderStrong}" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="{StaticResource Ariadne.Color.BorderMuted}" />
          <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource Ariadne.Color.AccentPrimary}" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource Ariadne.Color.AccentHover}" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource Ariadne.Color.AccentPressed}" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="{StaticResource Ariadne.Color.BorderStrong}" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource Ariadne.Color.AccentPrimary}" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource Ariadne.Color.AccentHover}" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{StaticResource Ariadne.Color.AccentPressed}" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="{StaticResource Ariadne.Color.BorderStrong}" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="{StaticResource Ariadne.Color.TextSecondary}" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled" Color="{StaticResource Ariadne.Color.TextSubtle}" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="Ariadne.ScrollThumb" Color="#38000000" />
          <SolidColorBrush x:Key="Ariadne.ScrollThumbHover" Color="#66000000" />
        </ResourceDictionary>

        <!-- ========================= 深色（夜航，默认强调=青绿） ========================= -->
        <ResourceDictionary x:Key="Dark">
          <!-- 深色同样拉开 5 级阶梯：导轨凹槽最深，浮起纸片最亮 -->
          <Color x:Key="Ariadne.Color.WindowBase">#1C1E21</Color>
          <Color x:Key="Ariadne.Color.BackgroundMain">#15171A</Color>
          <Color x:Key="Ariadne.Color.BackgroundSurface">#212528</Color>
          <Color x:Key="Ariadne.Color.BackgroundElevated">#2F3438</Color>
          <!-- 深色毛玻璃菜单 -->
          <Color x:Key="Ariadne.Color.MenuBackground">#CC1E2328</Color>
          <Color x:Key="Ariadne.Color.GlassTint">#D01C2126</Color>
          <Color x:Key="Ariadne.Color.GlassBorder">#33FFFFFF</Color>
          <Color x:Key="Ariadne.Color.Scrim">#99000000</Color>
          <!-- 导轨凹槽（暗）：比主内容面更深一档 -->
          <Color x:Key="Ariadne.Color.BackgroundSubtle">#191C1E</Color>
          <Color x:Key="Ariadne.Color.BackgroundHover">#14FFFFFF</Color>
          <Color x:Key="Ariadne.Color.BackgroundPressed">#22FFFFFF</Color>
          <Color x:Key="Ariadne.Color.BackgroundCode">#1F2327</Color>
          <Color x:Key="Ariadne.Color.TextHeading">#F4F6F8</Color>
          <Color x:Key="Ariadne.Color.TextPrimary">#ECEEF0</Color>
          <!-- Dark 边色/次级字：提高相对表面对比，避免「线融进底」 -->
          <Color x:Key="Ariadne.Color.TextSecondary">#B4BBC1</Color>
          <Color x:Key="Ariadne.Color.TextSubtle">#8A929A</Color>
          <Color x:Key="Ariadne.Color.TextOnAccent">#07110F</Color>
          <Color x:Key="Ariadne.Color.BorderDefault">#454B52</Color>
          <Color x:Key="Ariadne.Color.BorderMuted">#363B41</Color>
          <Color x:Key="Ariadne.Color.BorderStrong">#606770</Color>
          <Color x:Key="Ariadne.Color.BorderCard">#22FFFFFF</Color>
          <Color x:Key="Ariadne.Color.FocusRing">#6FB9AD</Color>
          <Color x:Key="Ariadne.Color.AccentPrimary">#6FB9AD</Color>
          <Color x:Key="Ariadne.Color.AccentHover">#82C6BB</Color>
          <Color x:Key="Ariadne.Color.AccentPressed">#5BA89C</Color>
          <Color x:Key="Ariadne.Color.AccentLight">#1F6FB9AD</Color>
          <Color x:Key="Ariadne.Color.AccentBorder">#556FB9AD</Color>
          <Color x:Key="Ariadne.Color.StatusInfo">#60A5FA</Color>
          <Color x:Key="Ariadne.Color.StatusSuccess">#34D399</Color>
          <Color x:Key="Ariadne.Color.StatusWarning">#FBBF24</Color>
          <Color x:Key="Ariadne.Color.StatusError">#F87171</Color>
          <Color x:Key="Ariadne.Color.LogErrorBg">#3F1D1D</Color>
          <Color x:Key="Ariadne.Color.LogWarningBg">#3D2E12</Color>
          <Color x:Key="Ariadne.Color.LogInfoBg">#1E2A3D</Color>
          <Color x:Key="Ariadne.Color.RuntimeIdle">#6A7079</Color>
          <Color x:Key="Ariadne.Color.RuntimeRunning">#6FB9AD</Color>
          <Color x:Key="Ariadne.Color.RuntimePaused">#FBBF24</Color>
          <Color x:Key="Ariadne.Color.RuntimePending">#60A5FA</Color>
          <Color x:Key="Ariadne.Color.RuntimeApproved">#34D399</Color>
          <Color x:Key="Ariadne.Color.RuntimeRejected">#F87171</Color>
          <Color x:Key="Ariadne.Color.GitAuto">#6A7079</Color>
          <Color x:Key="Ariadne.Color.GitManual">#FBBF24</Color>
          <Color x:Key="Ariadne.Color.GitCurrent">#6FB9AD</Color>
          <Color x:Key="Ariadne.Color.GitBranch">#818CF8</Color>
          <Color x:Key="Ariadne.Color.GitFolded">#4A525A</Color>
          <Color x:Key="Ariadne.Color.CanvasBackground">#17191C</Color>
          <Color x:Key="Ariadne.Color.CanvasGrid">#2B3137</Color>
          <Color x:Key="Ariadne.Color.NodeBackground">#212427</Color>
          <!-- 磨砂玻璃节点底（暗）：半透明深灰，画布点阵透出。
               U162-D：alpha 从 E6(90.2%) 降到 B0(69%)。原值在 #17191C 底与
               #2B3137 点阵之间只差 2/255，等于纯色；69% 时差 8/255，与亮色同量级。 -->
          <Color x:Key="Ariadne.Color.NodeGlass">#B02A2F33</Color>
          <!-- 节点底渐变的实心端（暗）：同色相全不透明 -->
          <Color x:Key="Ariadne.Color.NodeGlassSolid">#FF2A2F33</Color>
          <Color x:Key="Ariadne.Color.NodeBorder">#4A5159</Color>
          <Color x:Key="Ariadne.Color.NodeSelected">#6FB9AD</Color>
          <Color x:Key="Ariadne.Color.EdgeData">#6FB9AD</Color>
          <Color x:Key="Ariadne.Color.EdgeControl">#8B939D</Color>
          <Color x:Key="Ariadne.Color.EdgeCommunication">#A78BFA</Color>
          <Color x:Key="Ariadne.Color.EditorBackground">#212427</Color>
          <Color x:Key="Ariadne.Color.EditorSelection">#386FB9AD</Color>
          <Color x:Key="Ariadne.Color.DiffAddBackground">#2834D399</Color>
          <Color x:Key="Ariadne.Color.DiffRemoveBackground">#28F87171</Color>

          <SolidColorBrush x:Key="Ariadne.WindowBase" Color="{StaticResource Ariadne.Color.WindowBase}" />
          <SolidColorBrush x:Key="Ariadne.BackgroundMain" Color="{StaticResource Ariadne.Color.BackgroundMain}" />
          <SolidColorBrush x:Key="Ariadne.BackgroundSurface" Color="{StaticResource Ariadne.Color.BackgroundSurface}" />
          <SolidColorBrush x:Key="Ariadne.BackgroundElevated" Color="{StaticResource Ariadne.Color.BackgroundElevated}" />
          <SolidColorBrush x:Key="Ariadne.MenuBackground" Color="{StaticResource Ariadne.Color.MenuBackground}" />
          <SolidColorBrush x:Key="Ariadne.GlassTint" Color="{StaticResource Ariadne.Color.GlassTint}" />
          <SolidColorBrush x:Key="Ariadne.GlassBorder" Color="{StaticResource Ariadne.Color.GlassBorder}" />
          <SolidColorBrush x:Key="Ariadne.Scrim" Color="{StaticResource Ariadne.Color.Scrim}" />
          <SolidColorBrush x:Key="Ariadne.BackgroundSubtle" Color="{StaticResource Ariadne.Color.BackgroundSubtle}" />
          <SolidColorBrush x:Key="Ariadne.BackgroundHover" Color="{StaticResource Ariadne.Color.BackgroundHover}" />
          <SolidColorBrush x:Key="Ariadne.BackgroundPressed" Color="{StaticResource Ariadne.Color.BackgroundPressed}" />
          <SolidColorBrush x:Key="Ariadne.BackgroundCode" Color="{StaticResource Ariadne.Color.BackgroundCode}" />
          <SolidColorBrush x:Key="Ariadne.TextHeading" Color="{StaticResource Ariadne.Color.TextHeading}" />
          <SolidColorBrush x:Key="Ariadne.TextPrimary" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <SolidColorBrush x:Key="Ariadne.TextSecondary" Color="{StaticResource Ariadne.Color.TextSecondary}" />
          <SolidColorBrush x:Key="Ariadne.TextSubtle" Color="{StaticResource Ariadne.Color.TextSubtle}" />
          <SolidColorBrush x:Key="Ariadne.TextOnAccent" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="Ariadne.BorderDefault" Color="{StaticResource Ariadne.Color.BorderDefault}" />
          <SolidColorBrush x:Key="Ariadne.BorderMuted" Color="{StaticResource Ariadne.Color.BorderMuted}" />
          <SolidColorBrush x:Key="Ariadne.BorderStrong" Color="{StaticResource Ariadne.Color.BorderStrong}" />
          <SolidColorBrush x:Key="Ariadne.BorderCard" Color="{StaticResource Ariadne.Color.BorderCard}" />
          <SolidColorBrush x:Key="Ariadne.FocusRing" Color="{StaticResource Ariadne.Color.FocusRing}" />
          <!-- U181-C/D：键盘焦点环的 BoxShadows 形态。
               **必须是每个变体各一份**，且必须放在 ThemeDictionaries 里：
               `BoxShadows` 是不可拆的字面量类型，颜色部分**没法**绑到
               `Ariadne.FocusRing` 画刷上 —— 所以这里是「焦点环颜色」在 XAML 侧
               唯一能落脚的地方，`0 0 0 3 #B3xxxxxx` 里那个色值必须与本变体的
               `Ariadne.Color.FocusRing` 同源，B3 = 70% alpha。
               `ThemeApplication.SetFocusRingShadow` 会在个性化换色时按新强调色
               重写这个键，所以它随主题走，不是一处写死的魔法值。
               3px 而非 2px：环画在节点卡外缘，卡片本身已有 1px 描边 + 三层投影，
               2px 会被投影吃掉（暗色主题下尤其明显）。 -->
          <BoxShadows x:Key="Ariadne.Shadow.FocusRing">0 0 0 3 #FF6FB9AD</BoxShadows>
          <BoxShadows x:Key="Ariadne.Shadow.FocusRingCard">0 0 0 3 #FF6FB9AD, 0 2 4 0 #1C000000, 0 14 30 -8 #38000000, 0 30 64 -22 #30000000</BoxShadows>
          <SolidColorBrush x:Key="Ariadne.AccentPrimary" Color="{StaticResource Ariadne.Color.AccentPrimary}" />
          <SolidColorBrush x:Key="Ariadne.AccentHover" Color="{StaticResource Ariadne.Color.AccentHover}" />
          <SolidColorBrush x:Key="Ariadne.AccentPressed" Color="{StaticResource Ariadne.Color.AccentPressed}" />
          <SolidColorBrush x:Key="Ariadne.AccentLight" Color="{StaticResource Ariadne.Color.AccentLight}" />
          <SolidColorBrush x:Key="Ariadne.AccentBorder" Color="{StaticResource Ariadne.Color.AccentBorder}" />
          <SolidColorBrush x:Key="Ariadne.StatusInfo" Color="{StaticResource Ariadne.Color.StatusInfo}" />
          <SolidColorBrush x:Key="Ariadne.StatusSuccess" Color="{StaticResource Ariadne.Color.StatusSuccess}" />
          <SolidColorBrush x:Key="Ariadne.StatusWarning" Color="{StaticResource Ariadne.Color.StatusWarning}" />
          <SolidColorBrush x:Key="Ariadne.StatusError" Color="{StaticResource Ariadne.Color.StatusError}" />
          <SolidColorBrush x:Key="Ariadne.LogErrorBg" Color="{StaticResource Ariadne.Color.LogErrorBg}" />
          <SolidColorBrush x:Key="Ariadne.LogWarningBg" Color="{StaticResource Ariadne.Color.LogWarningBg}" />
          <SolidColorBrush x:Key="Ariadne.LogInfoBg" Color="{StaticResource Ariadne.Color.LogInfoBg}" />
          <SolidColorBrush x:Key="Ariadne.RuntimeIdle" Color="{StaticResource Ariadne.Color.RuntimeIdle}" />
          <SolidColorBrush x:Key="Ariadne.RuntimeRunning" Color="{StaticResource Ariadne.Color.RuntimeRunning}" />
          <SolidColorBrush x:Key="Ariadne.RuntimePaused" Color="{StaticResource Ariadne.Color.RuntimePaused}" />
          <SolidColorBrush x:Key="Ariadne.RuntimePending" Color="{StaticResource Ariadne.Color.RuntimePending}" />
          <SolidColorBrush x:Key="Ariadne.RuntimeApproved" Color="{StaticResource Ariadne.Color.RuntimeApproved}" />
          <SolidColorBrush x:Key="Ariadne.RuntimeRejected" Color="{StaticResource Ariadne.Color.RuntimeRejected}" />
          <SolidColorBrush x:Key="Ariadne.GitAuto" Color="{StaticResource Ariadne.Color.GitAuto}" />
          <SolidColorBrush x:Key="Ariadne.GitManual" Color="{StaticResource Ariadne.Color.GitManual}" />
          <SolidColorBrush x:Key="Ariadne.GitCurrent" Color="{StaticResource Ariadne.Color.GitCurrent}" />
          <SolidColorBrush x:Key="Ariadne.GitBranch" Color="{StaticResource Ariadne.Color.GitBranch}" />
          <SolidColorBrush x:Key="Ariadne.GitFolded" Color="{StaticResource Ariadne.Color.GitFolded}" />
          <SolidColorBrush x:Key="Ariadne.CanvasBackground" Color="{StaticResource Ariadne.Color.CanvasBackground}" />
          <SolidColorBrush x:Key="Ariadne.CanvasGrid" Color="{StaticResource Ariadne.Color.CanvasGrid}" />
          <SolidColorBrush x:Key="Ariadne.NodeBackground" Color="{StaticResource Ariadne.Color.NodeBackground}" />
          <SolidColorBrush x:Key="Ariadne.NodeGlass" Color="{StaticResource Ariadne.Color.NodeGlass}" />
          <!-- 节点卡片底（暗）：与亮色同构，实心过渡点同为 0.45（U162-D）。
               两套变体的 offset 必须保持一致，否则切主题时节点的「透明段高度」会跳。
               U162-D 顺带删掉了 Ariadne.NodeGlassHeader（亮 #D6FFFFFF / 暗 #26FFFFFF）：
               它全项目零引用——节点标题栏样式 Border.node-card-header 明确写着
               Background="Transparent"，为的是让卡片这道渐变一路透上去。
               按死代码四分类属「被取代的设计」，故删而不接线：接上去会给标题栏
               加一层与当前设计冲突的底。 -->
          <LinearGradientBrush x:Key="Ariadne.NodeGlassFill" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="{StaticResource Ariadne.Color.NodeGlass}" />
            <GradientStop Offset="0.45" Color="{StaticResource Ariadne.Color.NodeGlassSolid}" />
            <GradientStop Offset="1" Color="{StaticResource Ariadne.Color.NodeGlassSolid}" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="Ariadne.NodeBorder" Color="{StaticResource Ariadne.Color.NodeBorder}" />
          <SolidColorBrush x:Key="Ariadne.NodeSelected" Color="{StaticResource Ariadne.Color.NodeSelected}" />
          <SolidColorBrush x:Key="Ariadne.EdgeData" Color="{StaticResource Ariadne.Color.EdgeData}" />
          <SolidColorBrush x:Key="Ariadne.EdgeControl" Color="{StaticResource Ariadne.Color.EdgeControl}" />
          <SolidColorBrush x:Key="Ariadne.EdgeCommunication" Color="{StaticResource Ariadne.Color.EdgeCommunication}" />
          <SolidColorBrush x:Key="Ariadne.EditorBackground" Color="{StaticResource Ariadne.Color.EditorBackground}" />
          <SolidColorBrush x:Key="Ariadne.EditorSelection" Color="{StaticResource Ariadne.Color.EditorSelection}" />
          <SolidColorBrush x:Key="Ariadne.DiffAddBackground" Color="{StaticResource Ariadne.Color.DiffAddBackground}" />
          <SolidColorBrush x:Key="Ariadne.DiffRemoveBackground" Color="{StaticResource Ariadne.Color.DiffRemoveBackground}" />
          <!-- 深色主题下气泡反过来用亮底深字；滚动条滑块用白色半透明 -->
          <SolidColorBrush x:Key="Ariadne.TooltipBackground" Color="#F0E9EDEB" />
          <SolidColorBrush x:Key="Ariadne.TooltipText" Color="#181C1E" />
          <!-- U184：FluentTheme 的 CheckBox / Slider 资源键覆盖。
               **必须放在 ThemeDictionaries 的 Light/Dark 两份里各一套**，
               不能只在外层 Styles.Resources 放一份 —— 这是截图实测抓出来的：
               外层那份画刷的 `{DynamicResource Ariadne.Color.*}` 只解析一次、
               不带主题变体上下文，于是**暗色主题下拿到的是亮色的值**。
               症状：暗色下已启用复选框的标签文字是深色贴深底、整行看不见
               （而禁用那几行反而看得见，因为走的是另一个键）。
               这里用 StaticResource：同一份字典内的引用，随字典整体切换。
               各键为何取这些 token，见文件下方 Styles.Resources 里的注释块。 -->
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="Transparent" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="{StaticResource Ariadne.Color.BackgroundPressed}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedDisabled" Color="Transparent" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{StaticResource Ariadne.Color.BorderDefault}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{StaticResource Ariadne.Color.BorderStrong}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" Color="{StaticResource Ariadne.Color.BorderStrong}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedDisabled" Color="{StaticResource Ariadne.Color.BorderMuted}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource Ariadne.Color.AccentPrimary}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource Ariadne.Color.AccentHover}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource Ariadne.Color.AccentPressed}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedDisabled" Color="{StaticResource Ariadne.Color.BorderStrong}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{StaticResource Ariadne.Color.AccentHover}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="Transparent" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedDisabled" Color="Transparent" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedDisabled" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminate" Color="{StaticResource Ariadne.Color.AccentPrimary}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePointerOver" Color="{StaticResource Ariadne.Color.AccentHover}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePressed" Color="{StaticResource Ariadne.Color.AccentPressed}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminateDisabled" Color="{StaticResource Ariadne.Color.BorderStrong}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminate" Color="{StaticResource Ariadne.Color.AccentPrimary}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePointerOver" Color="{StaticResource Ariadne.Color.AccentHover}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePressed" Color="{StaticResource Ariadne.Color.AccentPressed}" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminateDisabled" Color="Transparent" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminate" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminatePointerOver" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminatePressed" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminateDisabled" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPointerOver" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPressed" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <SolidColorBrush x:Key="CheckBoxForegroundUncheckedDisabled" Color="{StaticResource Ariadne.Color.TextSubtle}" />
          <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <SolidColorBrush x:Key="CheckBoxForegroundCheckedPointerOver" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <SolidColorBrush x:Key="CheckBoxForegroundCheckedPressed" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <SolidColorBrush x:Key="CheckBoxForegroundCheckedDisabled" Color="{StaticResource Ariadne.Color.TextSubtle}" />
          <SolidColorBrush x:Key="CheckBoxForegroundIndeterminate" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <SolidColorBrush x:Key="CheckBoxForegroundIndeterminatePointerOver" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <SolidColorBrush x:Key="CheckBoxForegroundIndeterminatePressed" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <SolidColorBrush x:Key="CheckBoxForegroundIndeterminateDisabled" Color="{StaticResource Ariadne.Color.TextSubtle}" />
          <SolidColorBrush x:Key="SliderTrackFill" Color="{StaticResource Ariadne.Color.BackgroundHover}" />
          <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="{StaticResource Ariadne.Color.BackgroundPressed}" />
          <SolidColorBrush x:Key="SliderTrackFillPressed" Color="{StaticResource Ariadne.Color.BackgroundPressed}" />
          <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="{StaticResource Ariadne.Color.BorderMuted}" />
          <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource Ariadne.Color.AccentPrimary}" />
          <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{StaticResource Ariadne.Color.AccentHover}" />
          <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{StaticResource Ariadne.Color.AccentPressed}" />
          <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="{StaticResource Ariadne.Color.BorderStrong}" />
          <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource Ariadne.Color.AccentPrimary}" />
          <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource Ariadne.Color.AccentHover}" />
          <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{StaticResource Ariadne.Color.AccentPressed}" />
          <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="{StaticResource Ariadne.Color.BorderStrong}" />
          <SolidColorBrush x:Key="SliderTickBarFill" Color="{StaticResource Ariadne.Color.TextSubtle}" />
          <SolidColorBrush x:Key="SliderTickBarFillDisabled" Color="{StaticResource Ariadne.Color.BorderMuted}" />
          <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <!-- U213-E：ToggleSwitch 资源键覆盖（深色）。与上面浅色那份**逐键对应**，
               缺一个键就会在该主题下露出 Fluent 默认色（不报错，静默）。 -->
          <SolidColorBrush x:Key="ToggleSwitchContainerBackground" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleSwitchContainerBackgroundPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleSwitchContainerBackgroundPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleSwitchContentForeground" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <SolidColorBrush x:Key="ToggleSwitchHeaderForegroundDisabled" Color="{StaticResource Ariadne.Color.TextSubtle}" />
          <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="{StaticResource Ariadne.Color.BackgroundHover}" />
          <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="{StaticResource Ariadne.Color.BackgroundPressed}" />
          <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{StaticResource Ariadne.Color.BorderDefault}" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="{StaticResource Ariadne.Color.BorderStrong}" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="{StaticResource Ariadne.Color.BorderStrong}" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="{StaticResource Ariadne.Color.BorderMuted}" />
          <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource Ariadne.Color.AccentPrimary}" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource Ariadne.Color.AccentHover}" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource Ariadne.Color.AccentPressed}" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="{StaticResource Ariadne.Color.BorderStrong}" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource Ariadne.Color.AccentPrimary}" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource Ariadne.Color.AccentHover}" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{StaticResource Ariadne.Color.AccentPressed}" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="{StaticResource Ariadne.Color.BorderStrong}" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="{StaticResource Ariadne.Color.TextSecondary}" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="{StaticResource Ariadne.Color.TextPrimary}" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled" Color="{StaticResource Ariadne.Color.TextSubtle}" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="{StaticResource Ariadne.Color.TextOnAccent}" />
          <SolidColorBrush x:Key="Ariadne.ScrollThumb" Color="#3DFFFFFF" />
          <SolidColorBrush x:Key="Ariadne.ScrollThumbHover" Color="#70FFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- 应用壳采用固定石墨中性色，主题色仅作为动作信号，避免整屏单色化。 -->
      <SolidColorBrush x:Key="Ariadne.ShellRail" Color="#151B1A" />
      <SolidColorBrush x:Key="Ariadne.ShellRailElevated" Color="#1D2523" />
      <SolidColorBrush x:Key="Ariadne.ShellRailHover" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="Ariadne.ShellRailSelected" Color="#22FFFFFF" />
      <SolidColorBrush x:Key="Ariadne.ShellRailText" Color="#F3F7F5" />
      <SolidColorBrush x:Key="Ariadne.ShellRailMuted" Color="#A7B3AF" />
      <SolidColorBrush x:Key="Ariadne.ShellRailBorder" Color="#26FFFFFF" />

      <!-- 输入填充：从主题强调色派生（Color 跟随 DynamicResource 强调色），
           靠 Opacity 做定制偏移得到极淡的品牌色凹陷槽 —— 不硬编码任何颜色，
           换主题 / 个性化强调色时输入槽自动跟随。零描边，一列输入不再是叠框。 -->
      <SolidColorBrush x:Key="Ariadne.InputFill"
                       Color="{DynamicResource Ariadne.Color.AccentPrimary}"
                       Opacity="0.06" />
      <SolidColorBrush x:Key="Ariadne.InputFillHover"
                       Color="{DynamicResource Ariadne.Color.AccentPrimary}"
                       Opacity="0.11" />

      <!-- ===== 与变体无关：圆角 / 间距 / 字体 / 字号 ===== -->
      <CornerRadius x:Key="Ariadne.Radius.Small">4</CornerRadius>
      <CornerRadius x:Key="Ariadne.Radius.Medium">6</CornerRadius>
      <CornerRadius x:Key="Ariadne.Radius.Large">8</CornerRadius>
      <CornerRadius x:Key="Ariadne.Radius.Pill">999</CornerRadius>

      <x:Double x:Key="Ariadne.Size.Display">28</x:Double>
      <x:Double x:Key="Ariadne.Size.Title">20</x:Double>
      <x:Double x:Key="Ariadne.Size.Subtitle">16</x:Double>
      <x:Double x:Key="Ariadne.Size.Body">14</x:Double>
      <x:Double x:Key="Ariadne.Size.Caption">12</x:Double>
      <!-- 微标签（U204-A）：检查器分区名、单位后缀、路径 mono 串这一档。
           **它此前不是 token 而是 11 个散落的字面量**（主题里 2 处 + 页面 9 处）——
           `Size.Caption`(12) 与它只差 1px，肉眼分不出，于是「这里该用哪一个」
           无从判断，新写一处只能靠抄最近的那一行。收成 token 才有可引用的答案。 -->
      <x:Double x:Key="Ariadne.Size.Micro">11</x:Double>
      <!-- 角标数字（U204-B）。**原值 10.5 是个从未在屏幕上出现过的数字**：
           这个 token 全仓零引用，真实渲染取 App.axaml 里的 10（展开态）与 9（折叠态）。
           改成 10 而不是把 10.5 推到界面上 —— token 化的方向是让 token 记录
           已经生效的决策，而不是借「提高引用率」引入一次没人要求的视觉变化。
           展开/折叠两态统一到 10：两处角标用的是**同一个** `Border.badge`
           （18×18 定高），容器相同却写 10 与 9，且全仓没有一句注释交代那个 9 ——
           它是漂移而不是决定，所以收成一个 token 而不是建两个。 -->
      <x:Double x:Key="Ariadne.Size.Badge">10</x:Double>
      <!-- 正文字号（U200）。**刻意与 Size.Subtitle 分开，尽管当前两者同为 16**：
           它们是两个独立的设计维度——小标题跟随界面尺度，正文字号是阅读舒适度
           （U194-F 要做的「排版可调」调的是这一个）。合并成一个 token 后
           「调小标题」会意外改动正文，而那种漂移在界面上极难归因。
           这个 token 是 Ariadne.Reading.* 整条推导链的根：
           MeasureMaxWidth = 本值 × MeasureCharsPerLine，见下方 :506 一带。 -->
      <x:Double x:Key="Ariadne.Size.Reading">16</x:Double>

      <!-- ===== 排版尺度（U140）=====
           此前全仓没有「版心宽度」「页面边距」这类 token，尺度类只到圆角，
           于是每页各写死自己那套魔数：作品页 MaxWidth=1180/Margin=40,30,40,44、
           工作区 Margin=34,28 与 14,10,14,14、Git/设置/运行记录各一套。
           后果一是切页时内容左右跳动，二是**调正文字号时版心不会跟随**——
           U136 那个「每行 65 个汉字」的问题会以另一种形式回来。

           版心按「字号 × 目标字数」推导，不是拍脑袋的整数：
           正文 16px（`*.reading` 样式），CJK 全角字宽 ≈ 字号，
           排版学对 CJK 单栏建议 25–45 字/行，Word A4 小四约 37.6 字/行。
           取 36 字 ⇒ 16 × 36 = 576px 测量宽。改字号时把这里一起改，
           两个数字的关系就写在这段注释里，不会再分头漂移。 -->
      <x:Double x:Key="Ariadne.Reading.MeasureCharsPerLine">36</x:Double>
      <!-- 正文测量宽 = Ariadne.Size.Reading(16) × MeasureCharsPerLine(36)。
           ⚠️ U200 之前这句注释引用的 token **根本不存在**，字号是三处各写一遍的
           字面量 16 ⇒ 推导链的根不可引用，「关系写在注释里」只是写在注释里。
           现在 Size.Reading 是真 token 了，但 XAML 静态资源**算不了乘法**：
           这两个数字仍需手改。
           ✅ **U204-B：注释不再是关系的唯一载体。**
           `ScaleTokenUsageTests.ReadingMeasureDerivation_IsArithmeticallyConsistent`
           直接从本文件解析这四个数并验算 576 = 16×36、720 = 576+72+72 ——
           改字号忘改版心会当场变红。这才是「不会再分头漂移」的可执行形态：
           在此之前，这三个 token 全仓零引用，改它们**不影响任何渲染**，
           承诺与现实之间没有任何东西把关。 -->
      <x:Double x:Key="Ariadne.Reading.MeasureMaxWidth">576</x:Double>
      <!-- 稿纸内边距：左右 72 是版心两侧的「书页留白」，
           上下不对称（56 / 52）是因为刊头本身带下沿留白，视觉上要压掉一点。 -->
      <Thickness x:Key="Ariadne.Reading.SurfacePadding">72,56,72,52</Thickness>
      <!-- 稿纸外框宽 = 测量宽 + 左右内边距 = 576 + 144。
           ✅ U204-B：**这个值现在真的被读了** —— `WorksPageViewModel`
           的 `DocumentSurfaceMaxWidth` 从本 token 取基准宽（此前是那边硬编码
           一个 720d，主题里这个 720 无人问津）。改这里会真的改变稿纸宽度。 -->
      <x:Double x:Key="Ariadne.Reading.SurfaceMaxWidth">720</x:Double>
      <!-- 正文行高（U151）。30 配 16px 中文衬线正文是刻意选的：约 1.875 倍，
           长篇阅读靠行距而不是字号撑开呼吸；收到 1.16 倍（AvaloniaEdit 默认）
           会让中文挤成一团。

           **这里是唯一的定义处**，阅读态样式与修改态编辑器都必须引它：
           U151 的成因正是「阅读态样式写了 30、编辑器那边没写」，
           两处各写一个 30 同样会漂移（只是漂移得更晚）。
           ⚠️ 修改态用的 ae:TextEditor **不吃 TextBlock.LineHeight**——它自己排版，
           行高 = 字体度量高 × TextEditorOptions.LineHeightFactor。
           所以那边由 WorksPageView.axaml.cs 读这个 token 后**按当前字体反解 factor**，
           不能写死系数（Ariadne.Font.Reading 是 fallback 链，换机器度量就变）。 -->
      <x:Double x:Key="Ariadne.Reading.LineHeight">30</x:Double>

      <!-- ===== 稿纸上的 Markdown 层级（U203）=====
           阅读态要把正文里的 `#`/`>`/三连短横线/`**` 渲染出来，这些是它需要的尺度。

           **刻意与 Ariadne.Size.*（界面尺度）分开**，理由同 Size.Reading 那段注释：
           这一族是「读成书」的排版维度，跟着正文字号走，而不是跟着界面走。
           把标题挂到 Size.Title(20) 上，将来调界面密度会连带改动小说的章节标题。

           级差按 1.15~1.17 的等比收（24 / 21 / 18），到 h4 收回正文字号——
           长篇小说实际用到的层级是「卷 / 章 / 节」三档，h4 以下靠字重与色阶区分就够，
           再往上放大只会让稿纸看起来像 PPT。 -->
      <x:Double x:Key="Ariadne.Reading.Heading1Size">24</x:Double>
      <x:Double x:Key="Ariadne.Reading.Heading2Size">21</x:Double>
      <x:Double x:Key="Ariadne.Reading.Heading3Size">18</x:Double>
      <!-- h4~h6：与正文同字号，只靠字重/色阶分层。等于 Size.Reading 是刻意的，
           不引用它是因为将来若要「h4 略大于正文」，改这里不该牵动正文。 -->
      <x:Double x:Key="Ariadne.Reading.HeadingMinorSize">16</x:Double>
      <!-- 大标题的行高必须自己给：正文行高 30 配 24px 字会顶头（1.25 倍），
           而 h3 及以下（18px）用 30 正好，所以只有 h1/h2 需要单独一档。 -->
      <x:Double x:Key="Ariadne.Reading.Heading1LineHeight">34</x:Double>
      <x:Double x:Key="Ariadne.Reading.Heading2LineHeight">32</x:Double>
      <!-- 代码用等宽字，比正文小一档：等宽 CJK 字面本来就宽，
           跟正文同为 16px 时一行代码会明显挤出版心。 -->
      <x:Double x:Key="Ariadne.Reading.CodeSize">14</x:Double>
      <!-- 分隔线厚度：发丝线。1px 是「一条线」的下限，再粗就成了分区块。 -->
      <x:Double x:Key="Ariadne.Reading.RuleHeight">1</x:Double>

      <!-- 段间距。**不是随手取的 16**：正文行高 30，段间距取约半行 ⇒
           段落之间有呼吸但仍读得出是同一节；取满一行（30）会让每段都像新起一节。
           ⚠️ 渲染态下「空行」不再是一行空白字符，而是这个 Margin —— 见
           MarkdownReaderBlock 的注释。改这个值等于改所有段落的疏密。 -->
      <Thickness x:Key="Ariadne.Reading.ParagraphMargin">0,0,0,16</Thickness>
      <!-- 标题上方留白 > 下方留白，是排版通例：标题属于它下面那段内容，
           上紧下松会让标题看起来在给上一节收尾。 -->
      <Thickness x:Key="Ariadne.Reading.HeadingMargin">0,24,0,10</Thickness>
      <Thickness x:Key="Ariadne.Reading.SubHeadingMargin">0,18,0,8</Thickness>
      <!-- 引用块：左竖线 3px + 文字缩进 16px。竖线用 Border 左边框，不画图元。 -->
      <Thickness x:Key="Ariadne.Reading.QuoteBarThickness">3,0,0,0</Thickness>
      <Thickness x:Key="Ariadne.Reading.QuotePadding">16,2,0,2</Thickness>
      <!-- 分隔线上下留白比段间距大一档：它的职责是「场景切换」，
           留白不够时读者会把它当装饰而不是断点。 -->
      <Thickness x:Key="Ariadne.Reading.RuleMargin">0,22,0,28</Thickness>
      <!-- 列表项之间比段落更紧（它们是一组），标记与内容之间留 10px。 -->
      <Thickness x:Key="Ariadne.Reading.ListRowMargin">0,0,0,8</Thickness>
      <Thickness x:Key="Ariadne.Reading.ListMarkerMargin">0,0,10,0</Thickness>
      <Thickness x:Key="Ariadne.Reading.CodePadding">14,10</Thickness>

      <!-- 页面级边距：所有主功能页共用，让切页时版心不跳。
           底部比顶部厚，是给滚动到底的内容留呼吸，不是笔误。 -->
      <Thickness x:Key="Ariadne.Page.Margin">40,30,40,44</Thickness>
      <!-- 面板/工作区内边距：比页面级紧一档，用于画布、检查器这类密集区域。 -->
      <Thickness x:Key="Ariadne.Page.PanelPadding">14,10,14,14</Thickness>
      <Thickness x:Key="Ariadne.Page.SectionMargin">34,28</Thickness>

      <!-- ===== 按钮簇的组间分隔（U205-A）=====
           发丝线粗细。项目此前有 5 处手写发丝分隔线，**用了 3 套不同数字**
           （WelcomeView 的 `Width=1 Height=14 Margin=6,0`、WorksPageView 的
           `Margin=6,4`、画布工具条的 `Margin=4,5`）⇒ 「分组线」在这个代码库里
           不是一个语汇，而是三次各自为政的巧合：改一处不会带动另两处，
           新写一处也无从知道该抄哪一套。收成 token + 一个 class 之后，
           「分组」才第一次成为可复用的东西。
           ⚠️ 用 `Border.group-divider` 时**不要再内联写 Width/Margin/Background**：
           内联是 `BindingPriority.LocalValue`(0)，数值小的胜 ⇒ 它压过所有样式层，
           而且**静默**（不报错、不回落），会让这几个 token 在那一处彻底失效。 -->
      <x:Double x:Key="Ariadne.Stroke.Hairline">1</x:Double>
      <!-- 分隔线内缩：左右 4（两侧各自还有容器的 Spacing，合计约 10~14px 组间距），
           上下 5 让线比按钮矮一截 —— 满高的线会读成「表格列线」而不是「组边界」。
           取值沿用画布工具条那一套（U195-L 判定的全项目最佳实践），
           另两处旧数字向它收敛，而不是取三者平均：平均值谁都不是。 -->
      <Thickness x:Key="Ariadne.Group.DividerInset">4,5</Thickness>

      <!-- ===== 描边宽度（U204-A）=====
           全仓 146 处 `BorderThickness` 字面量、token 引用只有 1 处
           （`Ariadne.Reading.QuoteBarThickness`），其中「四边发丝线」这一个语汇
           独占 28 处 —— 描边宽度此前基本不是一个可引用的概念。

           ⚠️ **必须是 `Thickness` 而不能复用上面那个 `x:Double` 的
           `Ariadne.Stroke.Hairline`**：`DynamicResource` **不跑类型转换器**，
           把 double 绑到 `BorderThickness` 会**静默失效**（不报错、不回落，
           描边整个消失），而所有静态判据照样全绿。两个 key 是同一个设计值
           （都是 1px 发丝线）的两种目标类型，改一个必须改另一个 ——
           守卫见 `ScaleTokenUsageTests` 的发丝线同源那条。 -->
      <Thickness x:Key="Ariadne.Stroke.HairlineAll">1</Thickness>

      <!-- U181-E：强调描边（2px 四边）。用在「这一个是我刚选的」这类需要
           **形状差异**而非明暗差异的态上（当前消费者：连线起点引脚 `.connect-origin`）。
           为什么不复用 `Ariadne.Stroke.HairlineAll`：引脚只有 14×14，
           1px 边在一排同款小圆点里读不出来 —— 那就等于又一次「只靠颜色区分状态」。
           ⚠️ 同上：必须是 `Thickness`，`DynamicResource` 不跑类型转换器，
           绑一个 `x:Double` 到 `BorderThickness` 会静默失效（描边整个消失）。 -->
      <Thickness x:Key="Ariadne.Stroke.Emphasis">2</Thickness>

      <!-- ===== 可点目标尺度（U205-B）=====
           工具条图标按钮 30×26。**26 是权衡过的值、不是随手写的**，
           所以这里只是把它从字面量收成 token（改一次全项目跟随），
           不擅自抬到 32：同文件 `Button.window-control` 的注释记录了
           `44×54 → 40×36 → 36×30` 这条收紧史，说明这一族尺寸是调过的；
           桌面端有鼠标，26px 可点，抬高 6px 会挤爆已报溢出的作品页顶栏（U194-G）。
           ⇒ U205-B 判 P2 并按「token 化 + 留档」处置，真正偏小的是下面那个引脚。 -->
      <x:Double x:Key="Ariadne.Control.IconButtonWidth">30</x:Double>
      <x:Double x:Key="Ariadne.Control.IconButtonHeight">26</x:Double>
      <!-- 节点卡上「＋加数据输入引脚」的点击目标。原为 14×16 —— 全项目最小的可点目标，
           且它在**可缩放画布**上：缩到 50% 就只剩 7×8px，鼠标很难压住。
           抬到 20×20（图形仍是 10×10 的加号，只是把透明命中区放大），
           50% 缩放下等于 10×10，与原尺寸在 100% 下相当。
           为什么不抬到 26（与 icon-btn 齐平）：它挂在节点卡数据引脚列里，
           再高会把引脚行距撑开，那是把一个可点性问题换成一个版式问题。 -->
      <x:Double x:Key="Ariadne.Control.PinHitTarget">20</x:Double>

      <!-- 字体：Inter 不含中文，必须挂中文黑体 fallback（系统实测可用：WenQuanYi Zen Hei / AR PL UMing CN / DejaVu）。
           Windows 上前面的 Segoe UI / Microsoft YaHei 会优先命中，Linux 上回退到文泉驿正黑。 -->
      <FontFamily x:Key="Ariadne.Font.Ui">Inter, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, WenQuanYi Zen Hei, DejaVu Sans, sans-serif</FontFamily>
      <FontFamily x:Key="Ariadne.Font.Reading">Source Han Serif SC, Noto Serif CJK SC, Songti SC, AR PL UMing CN, Georgia, DejaVu Serif, serif</FontFamily>
      <FontFamily x:Key="Ariadne.Font.Mono">Cascadia Code, JetBrains Mono, Consolas, Sarasa Mono SC, DejaVu Sans Mono, WenQuanYi Zen Hei Mono, monospace</FontFamily>

      <!-- Win11 柔和投影：卡片 / 浮层 / 毛玻璃菜单 -->
      <BoxShadows x:Key="Ariadne.Shadow.Card">0 1 2 0 #10000000, 0 8 22 -8 #24000000</BoxShadows>
      <!-- 导航纸片撬起投影：左缘抬起 → 影子偏向右下，克制不糊（任务书「阴影少」）。 -->
      <BoxShadows x:Key="Ariadne.Shadow.Lift">2 2 5 -1 #1F000000, 5 5 14 -4 #26000000</BoxShadows>
      <BoxShadows x:Key="Ariadne.Shadow.Flyout">0 2 4 0 #0F000000, 0 8 24 -4 #28000000, 0 24 48 -8 #1A000000</BoxShadows>
      <!-- 停靠栏投影：取代 1px 硬边。栏是浮在画布之上的一块面，影子朝画布那一侧扩散，
           于是「栏在上、画布在下」这件事由光影交代，不再需要一条线去切割。
           负 spread 收住扩散，只在贴边处留一层薄暗，不糊到画布中央。 -->
      <BoxShadows x:Key="Ariadne.Shadow.RailLeft">-2 0 6 -2 #1A000000, -8 0 20 -8 #22000000</BoxShadows>
      <BoxShadows x:Key="Ariadne.Shadow.RailUp">0 -2 6 -2 #1A000000, 0 -8 20 -8 #22000000</BoxShadows>
      <BoxShadows x:Key="Ariadne.Shadow.Dialog">0 4 8 0 #12000000, 0 16 40 -4 #28000000, 0 32 64 -12 #18000000</BoxShadows>

      <!-- 毛玻璃材料：弹窗/菜单 Tint 用 Color key（ExperimentalAcrylicMaterial 吃 Color） -->
      <ExperimentalAcrylicMaterial x:Key="Ariadne.Acrylic.Menu"
                                   BackgroundSource="Digger"
                                   TintColor="{DynamicResource Ariadne.Color.GlassTint}"
                                   TintOpacity="0.72"
                                   MaterialOpacity="0.82" />
      <ExperimentalAcrylicMaterial x:Key="Ariadne.Acrylic.Dialog"
                                   BackgroundSource="Digger"
                                   TintColor="{DynamicResource Ariadne.Color.GlassTint}"
                                   TintOpacity="0.78"
                                   MaterialOpacity="0.88" />

      <!-- ============================================================
           矢量图标几何（24x24 viewbox）——不依赖任何图标字体，
           Linux/Win 一致渲染，消除 Segoe Fluent Icons 缺失的豆腐块。
           用法：<Path Data="{StaticResource Ariadne.Icon.X}" .../>，
           Path Stretch=Uniform + Width/Height 控制显示尺寸。
           ============================================================ -->
      <!-- 窗口控制（24 viewBox）。Minimize 横条居中于几何中线 y=12：
           原先 13.2~15.6（中线 14.4）导致横条明显偏下，与最大化/关闭不在一条水平线上。 -->
      <StreamGeometry x:Key="Ariadne.Icon.Minimize">M4.5,10.8 L19.5,10.8 L19.5,13.2 L4.5,13.2 Z</StreamGeometry>
      <StreamGeometry x:Key="Ariadne.Icon.Maximize">M5.5,5.5 L18.5,5.5 L18.5,18.5 L5.5,18.5 Z</StreamGeometry>
      <StreamGeometry x:Key="Ariadne.Icon.Restore">M8,9.5 L16.5,9.5 L16.5,18 L8,18 Z M9.5,7 L9.5,5.5 L18.5,5.5 L18.5,14.5 L17,14.5</StreamGeometry>
      <StreamGeometry x:Key="Ariadne.Icon.Close">M6.5,6.5 L17.5,17.5 M17.5,6.5 L6.5,17.5</StreamGeometry>
      <StreamGeometry x:Key="Ariadne.Icon.Add">M12,5 L12,19 M5,12 L19,12</StreamGeometry>
      <!-- 减号：与 Add 共用同一条横线坐标（y=12，x 5→19），两个按钮并排时笔画等长、
           视觉重心同高。此前画布缩放用的是文本字形 `+`/`-`，靠字体基线与行高居中——
           而连字符在 em 框里本就偏上、数学加号居中，两者永远对不齐（还叠了 18/16 两个字号）。
           图标一律用矢量 Geometry 也是硬约束：图标字体在 Linux 上缺失会渲染成豆腐块。 -->
      <StreamGeometry x:Key="Ariadne.Icon.Subtract">M5,12 L19,12</StreamGeometry>
      <!-- 侧栏折叠（汉堡） -->
      <StreamGeometry x:Key="Ariadne.Icon.Menu">M3,6 L21,6 M3,12 L21,12 M3,18 L21,18</StreamGeometry>
      <!-- 导航：工作空间（节点/编排——三连点+线） -->
      <StreamGeometry x:Key="Ariadne.Icon.Workspace">M6,6 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 M18,6 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 M12,18 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 M7.5,8 L11,15 M16.5,8 L13,15</StreamGeometry>
      <!-- 导航：作品（书页） -->
      <StreamGeometry x:Key="Ariadne.Icon.Works">M5,4 L14,4 L19,9 L19,20 L5,20 Z M14,4 L14,9 L19,9 M8,13 L16,13 M8,16 L16,16</StreamGeometry>
      <!-- 导航：Git（分支） -->
      <StreamGeometry x:Key="Ariadne.Icon.Git">M7,5 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 M7,19 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 M17,8 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 M7,7.5 L7,16.5 M7,12 C7,9 17,12 17,10.5</StreamGeometry>
      <!-- 导航：运行日志（列表行） -->
      <StreamGeometry x:Key="Ariadne.Icon.RunLog">M4,6 L7,6 M10,6 L20,6 M4,12 L7,12 M10,12 L20,12 M4,18 L7,18 M10,18 L20,18</StreamGeometry>
      <!-- 导航：模板市场（方格） -->
      <StreamGeometry x:Key="Ariadne.Icon.Templates">M4,4 L11,4 L11,11 L4,11 Z M13,4 L20,4 L20,11 L13,11 Z M4,13 L11,13 L11,20 L4,20 Z M13,13 L20,13 L20,20 L13,20 Z</StreamGeometry>
      <!-- 导航：配置（齿轮）。U162-B：旧数据是「中心圆 + 8 根脱开的放射直线」= 太阳/亮度画法，
           不是齿轮。齿轮的辨识特征是**齿与轮缘相连的梯形凸起**，齿间要有可见齿根谷。
           结构 = 6 颗齿的闭合外轮廓（齿顶平台 + A7.2 齿根弧相连）+ 中心 r=3 圆孔；
           闭合轮廓而非填充，因为 Path.icon 基础样式是 Fill=Transparent、只描边。
           6 齿是 16–20px 的上限：齿根谷现约 2.7px，齿数再多就窄于 1.6 笔宽而糊成圆环。
           ⚠️ 与 ViewModels/IconGeometries.cs 的 SettingsData 是同一份数据，两处必须同步
           （SettingsIconGeometryTests 钉住）——只改一处会让侧栏与 XAML 两个入口图标不一样。 -->
      <StreamGeometry x:Key="Ariadne.Icon.Settings">M9.89,5.11 L10,1.69 L14,1.69 L14.11,5.11 A7.2,7.2 0 0 1 16.91,6.73 L19.92,5.11 L21.93,8.58 L19.02,10.38 A7.2,7.2 0 0 1 19.02,13.62 L21.93,15.42 L19.92,18.89 L16.91,17.27 A7.2,7.2 0 0 1 14.11,18.89 L14,22.31 L10,22.31 L9.89,18.89 A7.2,7.2 0 0 1 7.09,17.27 L4.08,18.89 L2.07,15.42 L4.98,13.62 A7.2,7.2 0 0 1 4.98,10.38 L2.07,8.58 L4.08,5.11 L7.09,6.73 A7.2,7.2 0 0 1 9.89,5.11 Z M12,12 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0</StreamGeometry>
      <!-- 底部：版本（信息圈） -->
      <StreamGeometry x:Key="Ariadne.Icon.Info">M12,12 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0 M12,11 L12,16 M12,8 L12,8.5</StreamGeometry>
      <!-- 底部：反馈（对话气泡） -->
      <StreamGeometry x:Key="Ariadne.Icon.Feedback">M4,5 L20,5 L20,16 L13,16 L9,20 L9,16 L4,16 Z</StreamGeometry>
      <!-- 发送（纸飞机） -->
      <StreamGeometry x:Key="Ariadne.Icon.Send">M4,12 L20,4 L14,20 L11,13 Z M11,13 L4,12</StreamGeometry>
      <!-- 刷新 -->
      <StreamGeometry x:Key="Ariadne.Icon.Refresh">M19,12 a7,7 0 1,1 -2.1,-5 M17,3 L17,7 L13,7</StreamGeometry>
      <StreamGeometry x:Key="Ariadne.Icon.FitView">M4,9 L4,4 L9,4 M15,4 L20,4 L20,9 M20,15 L20,20 L15,20 M9,20 L4,20 L4,15 M8,8 L16,8 L16,16 L8,16 Z</StreamGeometry>
      <!-- 折叠/展开箭头（右栏收放） -->
      <StreamGeometry x:Key="Ariadne.Icon.ChevronLeft">M15,5 L8,12 L15,19</StreamGeometry>
      <StreamGeometry x:Key="Ariadne.Icon.ChevronRight">M9,5 L16,12 L9,19</StreamGeometry>
      <StreamGeometry x:Key="Ariadne.Icon.ChevronDown">M5,9 L12,16 L19,9</StreamGeometry>
      <StreamGeometry x:Key="Ariadne.Icon.ChevronUp">M5,15 L12,8 L19,15</StreamGeometry>
      <!-- 保存（软盘） -->
      <StreamGeometry x:Key="Ariadne.Icon.Save">M5,4 L15,4 L19,8 L19,20 L5,20 Z M8,4 L8,9 L15,9 L15,4 M8,13 L16,13 M8,16 L16,16</StreamGeometry>
      <StreamGeometry x:Key="Ariadne.Icon.Undo">M9,7 L4,12 L9,17 M5,12 L15,12 C18,12 20,14 20,17</StreamGeometry>
      <StreamGeometry x:Key="Ariadne.Icon.Redo">M15,7 L20,12 L15,17 M19,12 L9,12 C6,12 4,14 4,17</StreamGeometry>
      <!-- 导入（向下入托盘） -->
      <StreamGeometry x:Key="Ariadne.Icon.Import">M12,3 L12,13 M8,9 L12,13 L16,9 M4,16 L4,20 L20,20 L20,16</StreamGeometry>
      <!-- 导出（U195-G：文档 + 独立斜向飞出的箭头，刻意**不与 Import 共用托盘底**）
           原先两枚只差箭头朝向：托盘底 `M4,16 L4,20 L20,20 L20,16` 与竖线完全相同，
           16px 下相邻并列几乎不可分辨 —— 而这两个动作后果相反（读入 vs 写出），
           在作品页顶栏正好紧挨着。
           所以换隐喻而不是只翻箭头：Import 保留「箭头入托盘」（向下、有容器），
           Export 改成「文档在左下 + 箭头独立飞向右上」（斜向、无容器），
           方向与轮廓**双重**不同。
           ⚠️ 箭头刻意与文档**不交叠**：交叠版在 16px 下会糊成一团
           （试过「箭头穿出文档右缘」，ASCII 网格渲染即可见交叠处辨不清）。
           ⚠️ 别为了对称把托盘底加回来——那正是本条要消除的同形来源。
           回归见 IconDistinguishabilityTests（判据：不共用子路径 + 坐标点重合率 < 50%）。 -->
      <StreamGeometry x:Key="Ariadne.Icon.Export">M4,10 L4,20 L13,20 L13,13 M4,10 L9,10 L9,14 L13,14 M11,11 L19,4 M19,4 L14,4 M19,4 L19,9</StreamGeometry>
      <!-- 打包为子工作流（等轴立方体 = 把所选收进一个包） -->
      <StreamGeometry x:Key="Ariadne.Icon.Pack">M12,3 L20,7.5 L20,16.5 L12,21 L4,16.5 L4,7.5 Z M4,7.5 L12,12 L20,7.5 M12,12 L12,21</StreamGeometry>
      <!-- 搜索（放大镜） -->
      <StreamGeometry x:Key="Ariadne.Icon.Search">M10.5,5 a5.5,5.5 0 1,0 0.01,0 M14.8,14.8 L19,19</StreamGeometry>
      <!-- AI 改写（星芒）：一大一小两颗四角星。这是 AI 辅助在各家产品里的
           通行手势，比「魔杖」「机器人」更少歧义，也不会被读成「收藏」。
           大星在左上、小星在右下，避免两颗一样大而失去主次。 -->
      <StreamGeometry x:Key="Ariadne.Icon.Sparkle">M10,3 L11.6,7.9 L16.5,9.5 L11.6,11.1 L10,16 L8.4,11.1 L3.5,9.5 L8.4,7.9 Z M17.5,14 L18.4,16.6 L21,17.5 L18.4,18.4 L17.5,21 L16.6,18.4 L14,17.5 L16.6,16.6 Z</StreamGeometry>

      <!-- ========================================================
           U178-F / U164-B：FluentTheme 的 Expander 资源键覆盖。
           **为什么覆盖资源键而不是写 /template/ 选择器**，见文件末尾
           Expander 样式块开头那段实测记录（BindingPriority 之争）。

           ⚠️ 必须放在**这个** Styles.Resources 里，不能在文件末尾再开一个：
           `Styles.Resources` 是同一个属性，第二次赋值会让先声明的整份
           ResourceDictionary（上面 485 行的全部 Ariadne.* token）失效 ——
           实测症状是 headless 测试直接挂死而不是报错，极难定位。
           ======================================================== -->
      <!-- 头部：与 detail-row 同族——淡底、无描边、hover 加深。
           不用 settings-section 的描边语汇：Expander 常成组堆叠（设置页 8 个），
           每个都带一圈边会立刻堆成田字格，正是 dock-rail 那一节拆掉的东西。 -->
      <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="{DynamicResource Ariadne.Color.BackgroundSubtle}" />
      <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="{DynamicResource Ariadne.Color.BackgroundElevated}" />
      <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="{DynamicResource Ariadne.Color.BackgroundElevated}" />
      <SolidColorBrush x:Key="ExpanderHeaderForeground" Color="{DynamicResource Ariadne.Color.TextPrimary}" />
      <!-- hover/pressed 的**前景**也必须覆盖：Fluent 那两个键的默认值实测是硬编码
           `Black`（不是「跟随 Foreground」）——不覆盖的话暗色主题下一悬停，
           标题文字就从浅色跳成纯黑，直接消失在暗底上。 -->
      <SolidColorBrush x:Key="ExpanderHeaderForegroundPointerOver" Color="{DynamicResource Ariadne.Color.TextPrimary}" />
      <SolidColorBrush x:Key="ExpanderHeaderForegroundPressed" Color="{DynamicResource Ariadne.Color.TextPrimary}" />
      <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
      <!-- Fluent 默认 16,0,0,0 + MinHeight 48：对「分组标题」偏高偏空。
           14,10 与 detail-row 的内距同族，36 高度与 rail-nav（42）同一密度带。 -->
      <Thickness x:Key="ExpanderHeaderPadding">14,10</Thickness>
      <x:Double x:Key="ExpanderMinHeight">36</x:Double>
      <!-- 内容区：与 settings-section 对齐（同为「一块分区」），底色不再比头部深，
           Fluent 默认的 #fff2f2f2 是硬编码灰、暗色主题下直接错。 -->
      <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
      <Thickness x:Key="ExpanderContentPadding">14,10,14,12</Thickness>
      <Thickness x:Key="ExpanderContentDownBorderThickness">0</Thickness>
      <!-- 箭头：描边色跟随次级文字（它是辅助元素，不该和标题同重）。
           Fluent 默认 32px 的箭头按钮在 36px 头部里几乎占满，收到 26。 -->
      <SolidColorBrush x:Key="ExpanderChevronForeground" Color="{DynamicResource Ariadne.Color.TextSecondary}" />
      <!-- 同上：默认值实测是硬编码 Black，暗色下悬停即黑箭头贴黑底。 -->
      <SolidColorBrush x:Key="ExpanderChevronForegroundPointerOver" Color="{DynamicResource Ariadne.Color.TextPrimary}" />
      <SolidColorBrush x:Key="ExpanderChevronForegroundPressed" Color="{DynamicResource Ariadne.Color.TextPrimary}" />
      <SolidColorBrush x:Key="ExpanderChevronBackground" Color="Transparent" />
      <SolidColorBrush x:Key="ExpanderChevronBorderBrush" Color="Transparent" />
      <x:Double x:Key="ExpanderChevronButtonSize">26</x:Double>

      <!-- ========================================================
           U184：FluentTheme 的 CheckBox 资源键覆盖。

           **原缺陷**：全仓 39 个 CheckBox 的视觉是 **Fluent 默认蓝**。
           主题里关于 CheckBox 的唯一一条样式（本文件 `Button, ToggleButton,
           CheckBox, …` 合并选择器）只设了 `FontFamily` / `FontSize` ——
           勾选框本体的配色从未被碰过。`UI组件状态表.md:54` 明写
           「checkbox / radio 的 accent 取品牌主色 brand-primary」，
           而实测选中态底色是 `#ff0078d7`（Fluent 蓝）：**规范从未落地**。

           **为什么走资源键而不是 `/template/` 选择器**（探针实测，
           Avalonia 12.0.5 + FluentTheme headless）：

             CheckBox
               Grid   Name=RootGrid
                 Border Name=PART_Border
                   Grid
                     Border Name=NormalRectangle   ← 勾选框那个方框
                     Viewbox → Panel → Path Name=CheckGlyph  ← 勾号
                     ContentPresenter Name=PART_ContentPresenter

           `NormalRectangle` 的 **Background / BorderBrush 优先级是
           `StyleTrigger`（=1）**，`CheckGlyph` 的 **Fill / Data / Width 也是
           `StyleTrigger`** —— Fluent 用 `:checked` / `:unchecked` 这类伪类样式
           直接写在这两个部件上。**BindingPriority 数值小者胜**
           （LocalValue=0 < StyleTrigger=1 < Template=2 < Style=3），
           而 `/template/` 选择器是 Style=3 ⇒ **它比 StyleTrigger 弱两档，
           压根改不动**。这与 Expander 那边「输给 Template」的成因不同
           （那边=2，这边=1），但结论一致：**改资源键**。
           资源键是那些 StyleTrigger setter 里 `{DynamicResource …}` 的来源，
           改源头就绕过了优先级之争。

           ⚠️ 必须写在**这个** `Styles.Resources` 里（同 Expander 那段的警告）：
           `Styles.Resources` 是同一个属性，第二次赋值会让先声明的整份
           ResourceDictionary 失效，症状是 headless 挂死而非报错。

           **键名全部经探针 `TryFindResource` 逐个证实存在**（不猜名字：
           写一个不存在的键 = 死键，静默无效果）。唯一一个**不存在**的是
           `CheckBoxCheckBackgroundStrokeChecked` —— Fluent 选中态**没有**
           这个键（选中态方框靠 Fill 铺满，描边由 `…StrokeCheckedPointerOver`
           等变体给），所以下面**刻意不写它**。
           ======================================================== -->
      <!-- 未选中态：这是 39 个复选框里最常见的形态（权限清单、追踪开关等
           多数默认关）。Fluent 默认描边 `#99000000` 是**硬编码半透明黑** ——
           暗色主题下等于「黑框贴黑底」，几乎看不见框在哪。
           改为跟随 `BorderDefault`（与 TextBox 静息底线同一档），
           hover 加深到 `BorderStrong`（与 `TextBox:pointerover` 同一手势：
           只加深一档、不铺底）。 -->
      <!-- 按下态：Fluent 默认给未选中框铺 `#66000000` 实色黑底。
           这里改用 `BackgroundPressed`（本主题的按下语义色，亮/暗各自定义），
           「按下」由淡底表达，不是把框涂黑。 -->

      <!-- 选中态：**这是「Fluent 默认蓝」真正露出来的地方**。
           实测默认 `CheckBoxCheckBackgroundFillChecked` = `#ff0078d7`，
           而勾选框在选中时是整块铺满的实色 —— 39 个复选框一旦勾上，
           屏幕上就出现一块与青绿主题无关的微软蓝。这正是用户说
           「体现设计语言的通用控件样式没配齐」的最直接证据。
           改为 `AccentPrimary`（青绿），hover / pressed 走
           `AccentHover` / `AccentPressed` —— 与 `Button.primary` 三态同一组色阶，
           所以复选框与主按钮的「被按下」手感是同一种，而不是各说各话。 -->
      <!-- 禁用且选中：**不保留强调色**，退成中性描边色。
           理由与 `Button.primary:disabled` 那条完全一致（见按钮禁用态注释）：
           半透明的青绿会变成一块浑浊的灰绿，比中性灰更难看，
           而且「看着像能点但点不动」反而误导。
           这里用 `BorderStrong` 而非 Fluent 默认的 `#33000000`：
           后者是硬编码半透明黑，暗色主题下等于框整个消失。 -->
      <!-- ⚠️ 这里**没有** `CheckBoxCheckBackgroundStrokeChecked` ——
           探针实测该键在 Fluent 12.0.5 里**不存在**（`TryFindResource`=False）。
           选中态方框靠 Fill 铺满，无需描边。写一个不存在的键是死键：
           不报错、不生效，纯粹增加「看着配齐了」的错觉。
           但 hover / pressed / disabled 三个变体**确实存在**且默认值是硬编码蓝，
           必须覆盖，否则悬停选中的复选框会露出一圈 `#ff269fff` 蓝边。 -->
      <!-- 勾号：走 `TextOnAccent` 而不是硬编码 `White`（Fluent 默认就是 `White`）。
           `TextOnAccent` 在纸墨 / 高对比等主题下已按对比度调过，
           `UI组件状态表.md:46` 也明确要求「主按钮多用 text-white；应改读 text-on-accent」——
           同一条规定，复选框的勾号是同一类「压在强调色上的前景」。
           禁用态的勾号也一并给：它此时压在 BorderStrong 上，仍需反白才看得见。 -->

      <!-- 三态（Indeterminate）：本仓库当前**没有**用到三态复选框
           （全部 39 处都是二态 `IsChecked` 双向绑定）。
           ⚠️ 但这批键**不是死样式**，理由与「不给零使用的控件写样式」不冲突：
           它们不是我新造的选择器，而是**Fluent 已经在用的键**——
           Fluent 的 `:indeterminate` 样式无条件引用它们，默认值就是那块蓝
           （实测 `…FillIndeterminate` = `#ff0078d7`）。
           任何一处将来把 `IsChecked` 换成 `bool?`（权限清单的「部分继承」是
           最可能的场景），蓝色会**立刻**冒出来而没有任何东西会报错。
           覆盖它们的成本是三行、收益是关掉一条静默回归通道。
           走 `AccentPrimary` 同色：三态与选中态在本产品里是同一语义家族。 -->

      <!-- 标签文字：Fluent 三态九个 Foreground 键的默认值实测**全是硬编码
           `Black`**（不是「跟随继承的 Foreground」）——这与 Expander 那边
           踩到的完全同一个坑。后果：**暗色主题下所有复选框的文案是纯黑贴深底**，
           整行文字消失。全仓 39 处、其中约 30 处在配置页（权限、追踪、检索开关），
           也就是暗色主题下配置页几乎所有开关的文案都读不出来。
           ⚠️ 这条与「选中态蓝色」是**两个独立缺陷**，修一个不会连带修另一个。
           禁用态用 `TextSubtle` 而非默认 `#66000000`（同样是硬编码黑）：
           `opacity-50` 那一档由下方 `CheckBox:disabled` 的 Opacity 统一承担，
           这里只保证「即使不降透明度，字色本身也是主题内的弱色」。 -->
      <!-- Fluent 默认 32：与 `TextBox` 的 MinHeight 同值，但复选框没有输入框那样的
           内距需求，32 会让成组排列的权限清单之间出现明显空档。
           28 与 `ContextMenu MenuItem` 的 30 同一密度带，仍满足触控最小命中高度。 -->
      <x:Double x:Key="CheckBoxMinHeight">28</x:Double>

      <!-- ========================================================
           U213-E：ToggleSwitch 资源键覆盖（键本体在上面 Light/Dark 两份
           ThemeDictionaries 里各一套，这里只放理由与判断依据）。

           **为什么现在才有这段**：在本轮之前，全仓 `ToggleSwitch` 使用数 = **0**。
           U213-E 把 AutoMode 那一行从「满宽 `Button.subtle` + 选中琥珀底」
           换成「标签 + 开关」，于是**第一次**把这个控件引进产品。
           不配样式的话它就是 FluentTheme 默认外观 —— 与 U164-B 的 Expander
           同一个问题，只是换了控件：**把一个丑换成另一个丑**。
           ⇒ 引入从未样式过的控件，必须与引入它的那次改动同批配色。

           **为什么走资源键而不是 `/template/` 选择器**：与 CheckBox 同因
           （见上面 U184 那段的优先级分析）。Fluent 的 ToggleSwitch 用
           `:checked` / `:pointerover` 这类伪类样式直接写在模板部件
           （`Border#OuterBorder` = 关态轨、`Border#SwitchKnobBounds` = 开态轨、
           `Ellipse#SwitchKnobOn` / `#SwitchKnobOff` = 滑块、
           `Grid#SwitchAreaGrid` = 命中区底）上，那是 `StyleTrigger`（=1）优先级，
           而 `/template/` 是 Style（=3）—— **数字小者胜，弱两档、改不动**。
           资源键是那些 setter 里 `{DynamicResource …}` 的来源，改源头即绕过之争。

           **键名来自 `Avalonia.Themes.Fluent.dll` 里的实际字符串表**（UTF-16
           抽取，不是凭印象写）—— 上游教程里的名字与本版本不一定一致，
           而 Avalonia 缺资源键是**静默失效**：写错一个字就是死键，
           不报错、不回落，只留下「看着配齐了」的错觉。

           **覆盖了哪些态**（关/开 × 静息/悬停/按下/禁用，轨 + 描边 + 滑块）：
           - 关态轨 `ToggleSwitchFillOff*`：静息**透明** + `BorderDefault` 描边。
             与 CheckBox 未选中态同一手势（不铺底、只有一圈线），
             这样「关」在纸色背景上不会变成一块灰色异物；
             悬停 / 按下才浮出 `BackgroundHover` / `BackgroundPressed`。
           - 开态轨 `ToggleSwitchFillOn*`：`AccentPrimary` / `AccentHover` /
             `AccentPressed` —— 与 `Button.primary` 和 CheckBox 选中态**同一组色阶**，
             所以三者的「被按下」手感是同一种。
             ⚠️ 这里的青绿是**开关本体那 40×20 的轨道**，不是 U213-E 要消灭的
             「满宽琥珀卡片」：后者是 `Button.subtle.selected` 的 `AccentLight`
             刷在满格 ContentPresenter 上，随按钮一起删掉了。
           - 描边 `ToggleSwitchStrokeOn*` 取与同态轨道**同色**而非 Transparent：
             `ToggleSwitchOnStrokeThickness` 是 Fluent 自己的键、我们没覆盖，
             若它非 0，透明描边会在开态轨上留一圈能透出底下关态轨的缝。
             同色则无论那个厚度是多少都看不出接缝。
           - 滑块 `…KnobFillOff*` 走文字色阶（关态是「墨点在轨上」）、
             `…KnobFillOn*` 走 `TextOnAccent`（压在强调色上的前景，
             与 CheckBox 勾号同一条规定，不写硬编码 `White`）。
           - 禁用：轨 `BorderStrong`（不保留强调色——半透明青绿会变浑浊灰绿，
             且「看着像能拨却拨不动」反而误导，与 `Button.primary:disabled` 同理），
             关态描边退 `BorderMuted`。整行降透明另由下方 `ToggleSwitch:disabled` 承担。
           - 命中区底 `ToggleSwitchContainerBackground*` 三态**全透明**：
             这一条直接对着用户这轮的原话（「变成了难看的卡片」）——
             Fluent 默认会在悬停/按下时给整个控件（含标签）铺一层底，
             那正是「卡片」观感的另一个来源。AutoMode 悬在对话框外、
             周围没有任何容器，一铺底就又冒出一块方形色片。
           ======================================================== -->

      <!-- ========================================================
           U184：Slider 资源键覆盖。

           **原缺陷**：3 处 Slider（`SpectrumColorPicker` 的 RGB 三条）
           主题里唯一一条样式是 `<Setter Property="Minimum" Value="0" />`——
           一个**布尔式的取值下限**，不是视觉。实测三个部件全是 Fluent 蓝：
             PART_DecreaseButton（已走过的轨） = `#ff0078d7`
             thumb（滑块）                     = `#ff0078d7`
             TrackBackground（未走的轨）       = `#66000000` 硬编码半透明黑
           `UI组件状态表.md:56` 规定「slider → track `bg-hover`，
           thumb `brand-primary`」——**track 与 thumb 分别配色，规范从未落地**。

           ⚠️ 讽刺的是这 3 处正是**取色器**：用户在这里挑主题强调色，
           而滑条本身是微软蓝，改完主题色它也不跟着变。

           覆盖路线同 CheckBox / Expander：探针实测 `thumb.Background`、
           `PART_DecreaseButton.Background`、`TrackBackground.Background`
           **全部是 `Template` 优先级（=2）**，`/template/` 选择器（=3）改不动
           ⇒ 走资源键。下列键名均经 `TryFindResource` 证实存在。
           ======================================================== -->
      <!-- 未走过的轨：规范要求 `bg-hover`。本主题的 `BackgroundHover` 就是
           半透明中性色（亮色 `#14000000` / 暗色各自定义），语义与规范一致，
           且**天然适配双主题**——Fluent 默认那个 `#66000000` 是硬编码黑，
           暗色主题下轨道会比背景更黑，看起来像一道凹痕而不是轨道。 -->
      <!-- 禁用态的轨：Fluent 默认 `#ffcccccc` 是**不透明**硬编码浅灰，
           暗色主题下会变成一条亮灰杠、比启用时更显眼（正好反了）。
           改用 `BorderMuted`（本主题最淡的边线色，双主题各自定义）。 -->
      <!-- 已走过的轨（值段）：规范把 thumb 定为 brand-primary，值段与 thumb
           同属「当前值」这一语义，取同色 —— 于是「已选到哪」是一条连续的青绿，
           而不是「蓝轨 + 蓝球」。三态跟随 AccentPrimary/Hover/Pressed 色阶，
           与 Button.primary、CheckBox 选中态同一组，全产品一个答案。 -->
      <!-- 滑块本体：规范明写 thumb `brand-primary`。 -->
      <!-- 禁用滑块：同 CheckBox 禁用态的取舍——不留强调色，退中性。 -->
      <!-- 刻度条：本仓库 3 处 Slider 都没开 TickBar（实测两个 TickBar
           `IsVisible=False`）。**仍覆盖**的理由与 CheckBox 三态键相同：
           这是 Fluent 已在引用的键、默认值是硬编码黑，
           任何一处将来加上 `TickFrequency` 就会冒出黑刻度而无人报错。
           ⚠️ 探针实测**没有** `SliderTickBarFillPointerOver` / `…Pressed`
           这两个键（TryFindResource=False），所以此处刻意只写存在的两个。 -->
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ============================ 全局排版（字体统一） ============================ -->

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource Ariadne.Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Ariadne.Size.Body}" />
    <Setter Property="Background" Value="{DynamicResource Ariadne.WindowBase}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Ariadne.Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Ariadne.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextPrimary}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <Style Selector="Button, ToggleButton, CheckBox, RadioButton, TextBox, ComboBox, ListBox, MenuItem, TabItem, Label">
    <Setter Property="FontFamily" Value="{DynamicResource Ariadne.Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Ariadne.Size.Body}" />
  </Style>

  <!-- 悬浮提示：深色小胶囊 + 柔投影。Fluent 默认是与页面同色的浅色方框，
       浮在浅底上几乎看不出「浮起」；深底反白是桌面工具的通行语汇，
       小、快、不抢戏。 -->
  <Style Selector="ToolTip">
    <Setter Property="FontFamily" Value="{DynamicResource Ariadne.Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Ariadne.Size.Caption}" />
    <Setter Property="Background" Value="{DynamicResource Ariadne.TooltipBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TooltipText}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="MaxWidth" Value="320" />
  </Style>
  <!-- 投影只能挂在模板内的 Border 上（ToolTip 本身无 BoxShadow 属性） -->
  <Style Selector="ToolTip /template/ Border">
    <Setter Property="BoxShadow" Value="0 2 6 -1 #2E000000, 0 8 20 -6 #33000000" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <!-- 全局 TextBlock 默认色（TextPrimary 深色）会直接盖掉 ToolTip 继承下来的反白，
       导致深底胶囊上是黑字、看不清。用更具体的选择器把提示文字拉回 TooltipText。 -->
  <Style Selector="ToolTip TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TooltipText}" />
  </Style>

  <!-- ============================ 细滚动条 ============================
       Fluent 默认滚动条又宽又灰，长文阅读时一直在视野里。
       改为「静止时几乎隐形的细线，悬停才变宽变实」——
       内容才是主角，滚动条只在需要时出现。 -->
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="10" />
  </Style>
  <Style Selector="ScrollBar:horizontal">
    <Setter Property="Height" Value="10" />
  </Style>
  <!-- 滑块：静止 4px 细条、半透明；悬停整条滚动条时加粗并转实 -->
  <Style Selector="ScrollBar /template/ Thumb#thumb">
    <Setter Property="Background" Value="{DynamicResource Ariadne.ScrollThumb}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
        <ThicknessTransition Property="Margin" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ScrollBar:vertical /template/ Thumb#thumb">
    <Setter Property="Margin" Value="3,0" />
  </Style>
  <Style Selector="ScrollBar:horizontal /template/ Thumb#thumb">
    <Setter Property="Margin" Value="0,3" />
  </Style>
  <Style Selector="ScrollBar:pointerover /template/ Thumb#thumb">
    <Setter Property="Background" Value="{DynamicResource Ariadne.ScrollThumbHover}" />
    <Setter Property="Margin" Value="1,0" />
  </Style>
  <Style Selector="ScrollBar:horizontal:pointerover /template/ Thumb#thumb">
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <!-- 去掉两端的箭头按钮与轨道底：现代桌面滚动条不需要 -->
  <Style Selector="ScrollBar /template/ Border#TrackRail">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ScrollBar /template/ RepeatButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- 分栏拖杆：静止**完全隐形**（停靠栏的分层已由投影+高光承担，再画一道灰线
       就又变成「小边」）；只在指针接近时淡入一道强调色细杆，告诉你这里能拖。
       宽度不变（命中区恒定），显形靠透明度，所以不会推挤布局。 -->
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.AccentPrimary}" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="GridSplitter:pointerover">
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <!-- 矢量图标：描边线条，统一 stroke。geometry 见资源区 Ariadne.Icon.* -->
  <Style Selector="Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource Ariadne.TextSecondary}" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- 实心填充图标变体（如品牌点） -->
  <Style Selector="Path.icon-fill">
    <Setter Property="Fill" Value="{DynamicResource Ariadne.TextSecondary}" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- 文字层级（class） -->
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="{DynamicResource Ariadne.Size.Display}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextHeading}" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{DynamicResource Ariadne.Size.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextHeading}" />
  </Style>
  <Style Selector="TextBlock.subtitle">
    <Setter Property="FontSize" Value="{DynamicResource Ariadne.Size.Subtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- 右栏/检查器的「面板标题」：整栏唯一的醒目标题，压在页眉里。 -->
  <Style Selector="TextBlock.panel-title">
    <Setter Property="FontSize" Value="14.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextHeading}" />
  </Style>
  <!-- 检查器「分区标签」：安静的定位标记，不与面板标题争主角。
       小字号 + 加字距 + 弱色，是桌面检查器（Figma/Blender/VS Code）的通行做法：
       靠字重与字距区分层级，而不是靠给每个分区套盒子。 -->
  <Style Selector="TextBlock.inspector-label">
    <Setter Property="FontSize" Value="{DynamicResource Ariadne.Size.Micro}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.7" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextSubtle}" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="{DynamicResource Ariadne.Size.Body}" />
    <Setter Property="LineHeight" Value="21" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{DynamicResource Ariadne.Size.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.subtle">
    <Setter Property="FontSize" Value="{DynamicResource Ariadne.Size.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextSubtle}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource Ariadne.Font.Mono}" />
    <Setter Property="FontSize" Value="{DynamicResource Ariadne.Size.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextSecondary}" />
  </Style>
  <!-- 阅读正文：衬线、松行高。
       行高走 Ariadne.Reading.LineHeight（U151 的单一定义处）——
       修改态的 ae:TextEditor 会读同一个 token 反解 LineHeightFactor，
       在这里直接写 30 就是让两态再次分头漂移。 -->
  <Style Selector="TextBlock.reading">
    <Setter Property="FontFamily" Value="{DynamicResource Ariadne.Font.Reading}" />
    <Setter Property="FontSize" Value="{DynamicResource Ariadne.Size.Reading}" />
    <Setter Property="LineHeight" Value="{DynamicResource Ariadne.Reading.LineHeight}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="SelectableTextBlock.reading">
    <Setter Property="FontFamily" Value="{DynamicResource Ariadne.Font.Reading}" />
    <Setter Property="FontSize" Value="{DynamicResource Ariadne.Size.Reading}" />
    <Setter Property="LineHeight" Value="{DynamicResource Ariadne.Reading.LineHeight}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextPrimary}" />
  </Style>

  <!-- ================== 稿纸上的 Markdown 呈现（U203）==================
       阅读态把正文里的标记**渲染出来**（此前是把 `#`、`**`、`>`、三连短横线
       原样印在稿纸上——那是唯一一个「读自己作品」的界面）。
       宿主控件是 `MarkdownReaderBlock`，它只挂 class，所有视觉在这里。

       ⚠️ 这一族选择器**刻意不带 `.reading` 复合**（写成 `.md-h1` 而不是
       `.reading.md-h1`）：`ReadingEditingParityTests` 按「选择器含 .reading
       且块内含 LineHeight」抓样式块并断言行高必须引 Reading.LineHeight，
       复合选择器会被它抓进去，于是标题的独立行高被误判成「又抄了一遍 30」。
       正文段落那一档仍挂 `.reading`（它就该与修改态同排版）。

       ⚠️ 颜色一律走既有 token，本节**没有新增任何 Color 键**：
       主题有 12 个变体（ThemeAccessibilityAudit），新增色键要逐个变体补齐
       并过对比度审计，而标题/引用/代码在语义上就是
       TextHeading / TextSecondary / BackgroundCode，无需另立一套。 -->
  <Style Selector="SelectableTextBlock.md-paragraph">
    <Setter Property="Margin" Value="{DynamicResource Ariadne.Reading.ParagraphMargin}" />
  </Style>
  <!-- 标题共性：衬线、标题色、字重。字号/行高按级别在下面分档。 -->
  <Style Selector="SelectableTextBlock.md-heading">
    <Setter Property="FontFamily" Value="{DynamicResource Ariadne.Font.Reading}" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextHeading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="{DynamicResource Ariadne.Reading.SubHeadingMargin}" />
    <Setter Property="LineHeight" Value="{DynamicResource Ariadne.Reading.LineHeight}" />
  </Style>
  <Style Selector="SelectableTextBlock.md-h1">
    <Setter Property="FontSize" Value="{DynamicResource Ariadne.Reading.Heading1Size}" />
    <Setter Property="LineHeight" Value="{DynamicResource Ariadne.Reading.Heading1LineHeight}" />
    <Setter Property="Margin" Value="{DynamicResource Ariadne.Reading.HeadingMargin}" />
  </Style>
  <Style Selector="SelectableTextBlock.md-h2">
    <Setter Property="FontSize" Value="{DynamicResource Ariadne.Reading.Heading2Size}" />
    <Setter Property="LineHeight" Value="{DynamicResource Ariadne.Reading.Heading2LineHeight}" />
    <Setter Property="Margin" Value="{DynamicResource Ariadne.Reading.HeadingMargin}" />
  </Style>
  <Style Selector="SelectableTextBlock.md-h3">
    <Setter Property="FontSize" Value="{DynamicResource Ariadne.Reading.Heading3Size}" />
  </Style>
  <!-- h4~h6 与正文同字号，靠字重与色阶分层（见 token 那段注释）。
       h6 再降一档到次级文字色：到这一层已经是「小注」而不是标题了。 -->
  <Style Selector="SelectableTextBlock.md-h4, SelectableTextBlock.md-h5">
    <Setter Property="FontSize" Value="{DynamicResource Ariadne.Reading.HeadingMinorSize}" />
  </Style>
  <Style Selector="SelectableTextBlock.md-h6">
    <Setter Property="FontSize" Value="{DynamicResource Ariadne.Reading.HeadingMinorSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextSecondary}" />
  </Style>
  <!-- 引用块：左竖线取强调描边色（青绿），文字降到次级色。
       整体不铺底——铺底会在稿纸上切出一块「卡片」，破坏纸面的连续感。 -->
  <Style Selector="Border.md-quote">
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentBorder}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Ariadne.Reading.QuoteBarThickness}" />
    <Setter Property="Padding" Value="{DynamicResource Ariadne.Reading.QuotePadding}" />
    <Setter Property="Margin" Value="{DynamicResource Ariadne.Reading.ParagraphMargin}" />
  </Style>
  <Style Selector="SelectableTextBlock.md-quote-text">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextSecondary}" />
  </Style>
  <!-- 分隔线：中间实、两端淡出的渐变细线，与刊头分隔同一语汇（那处是内联渐变刷）。
       这里用纯色发丝线而非渐变：场景分隔在正文中会反复出现，
       渐变线重复十几次会显得刻意。 -->
  <Style Selector="Border.md-rule">
    <Setter Property="Height" Value="{DynamicResource Ariadne.Reading.RuleHeight}" />
    <Setter Property="Background" Value="{DynamicResource Ariadne.BorderDefault}" />
    <Setter Property="Margin" Value="{DynamicResource Ariadne.Reading.RuleMargin}" />
  </Style>
  <!-- 列表：标记与内容分两列（悬挂缩进），标记用次级弱色。 -->
  <Style Selector="Grid.md-list-row">
    <Setter Property="Margin" Value="{DynamicResource Ariadne.Reading.ListRowMargin}" />
  </Style>
  <Style Selector="TextBlock.md-list-marker">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextSubtle}" />
    <Setter Property="Margin" Value="{DynamicResource Ariadne.Reading.ListMarkerMargin}" />
  </Style>
  <Style Selector="SelectableTextBlock.md-list-text">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- 围栏代码块：等宽 + 代码底色 + 小圆角。小说里少见，但正文可能夹带
       设定表/命令示例，把三个反引号原样印出来比渲染成代码块更糟。 -->
  <Style Selector="Border.md-code">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundCode}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Ariadne.Radius.Small}" />
    <Setter Property="Padding" Value="{DynamicResource Ariadne.Reading.CodePadding}" />
    <Setter Property="Margin" Value="{DynamicResource Ariadne.Reading.ParagraphMargin}" />
  </Style>
  <Style Selector="SelectableTextBlock.md-code-text">
    <Setter Property="FontFamily" Value="{DynamicResource Ariadne.Font.Mono}" />
    <Setter Property="FontSize" Value="{DynamicResource Ariadne.Reading.CodeSize}" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- ============================ 卡片 / 层 ============================ -->
  <!-- 浮起卡片：表面色 + 发丝边框 + 柔投影，圆角 8 -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderCard}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Ariadne.Radius.Large}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Ariadne.Shadow.Card}" />
  </Style>
  <!-- 内嵌层：次级容器，无投影 -->
  <Style Selector="Border.layer">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderMuted}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Ariadne.Radius.Medium}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
        <BrushTransition Property="Background" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.layer.log-row:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderDefault}" />
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundElevated}" />
  </Style>
  <!-- U152：这里曾有一条 `Border.accent-panel`（强调色底 + 强调色边 + 大圆角），
       全仓零挂载、从未落地过。需要「强调色的一块面」时用下面的 `soft-panel`
       或直接绑 Ariadne.AccentLight，不要按这个名字再补一份——
       留着无人挂的样式只会让下一个人误判「强调面板已经有现成样式了」。 -->
  <Style Selector="Border.soft-panel">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderMuted}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Ariadne.Radius.Large}" />
  </Style>
  <!-- ⚠️ `panel-section` 目前**全仓零挂载**（U152 复核）。刻意保留而非删除：
       它是 U60 响应式那 4 条空规则的目标类（见文件末尾断点级联那段注释），
       补挂还是删规则属产品决策。别以为「分区已经有响应式 padding 了」——
       现在这个类没有任何控件在用；真正在用的分区样式是 `Border.settings-section`。 -->
  <Style Selector="Border.panel-section">
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderMuted}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <!-- ============================================================
       停靠栏（右侧检查器 / 底部节点库）：不画边。
       原先每栏一道 1px BorderMuted 硬线，两栏交汇处还会叠成一个「十字接缝」，
       整个工作区被切成田字格 —— 这就是那几道「小边」的来源。
       改为「浮在画布之上的一块面」：
         - 面本身抬到 Elevated（比画布亮一档，靠明度差自然分层）；
         - 朝画布的那一侧投一道柔和阴影，暗示这块面离画布更近；
         - 迎光的那道 1px 玻璃高光贴在同侧，给出「厚度」而非「边框」。
       颜色全部走 token，深浅主题与个性化换色自动跟随。
       ============================================================ -->
  <Style Selector="Border.dock-rail">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundElevated}" />
    <Setter Property="BorderThickness" Value="0" />
    <!-- 开合的灵动来源：面从停靠边滑入并淡入，而不是硬切出现。
         停留态归零，进场初态由 .rail-entering 提供（见下）。 -->
    <Setter Property="RenderTransform" Value="translateX(0px) translateY(0px)" />
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26" Easing="CubicEaseOut" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <!-- 右栏：阴影朝左（投向画布），高光沿左缘 -->
  <Style Selector="Border.dock-rail.dock-rail-right">
    <Setter Property="BoxShadow" Value="{DynamicResource Ariadne.Shadow.RailLeft}" />
  </Style>
  <!-- 底栏：阴影朝上 -->
  <Style Selector="Border.dock-rail.dock-rail-bottom">
    <Setter Property="BoxShadow" Value="{DynamicResource Ariadne.Shadow.RailUp}" />
  </Style>
  <!-- 进场初态：各自从停靠的那一侧偏出一点点（右栏向右、底栏向下），
       打开时摘掉这个类，靠上面的过渡滑回原位。位移克制在 18px 内，
       是「面滑进来」而不是「整块飞进来」。 -->
  <Style Selector="Border.dock-rail.dock-rail-right.rail-entering">
    <Setter Property="RenderTransform" Value="translateX(18px)" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Border.dock-rail.dock-rail-bottom.rail-entering">
    <Setter Property="RenderTransform" Value="translateY(18px)" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <!-- 停靠栏内的分区标题带：同样去掉硬线，靠一层更淡的底色分层 -->
  <Style Selector="Border.dock-rail-header">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundSubtle}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- ============================================================
       U178-D：左侧栏折叠是 160px 宽度硬跳（224 ⇄ 64 一帧跳完，图标瞬移）。
       右栏/底栏早有滑入淡入（上面 dock-rail 那套），侧栏只是没用上——
       所以这里**复用同一种语汇**（位移/淡入 + CubicEaseOut），不另造一套曲线。

       与 dock-rail 的差别只有一处、且是必须的：侧栏是**常驻**控件，
       它的开合不是「从无到有进场」而是「宽度就地变化」，
       所以载体是 `Width` 的 DoubleTransition，而不是 RenderTransform。
       位移做不到这件事——RenderTransform 不参与布局，右侧内容区不会跟着让位，
       侧栏会**压在内容上滑动**而不是把内容推开。

       180ms：既有 74 处过渡中 67 处落在 120–180ms，本条取该区间上限。
       取上限而非中段是因为这是全应用位移距离最长的一次过渡（160px）——
       同样时长下位移越长速度越快，140ms 的 160px 观感上仍接近瞬移。
       ============================================================ -->
  <Style Selector="Border.app-rail">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Width" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <!-- 侧栏内两套内容（展开态的「图标+文字」与折叠态的「纯图标」）原先靠
       IsVisible 互斥硬切：宽度即便平滑了，文字仍在某一帧凭空出现/消失。
       改为 Opacity 淡入淡出后，文字是「随宽度长出来」而不是「弹出来」。

       ⚠️ 这里刻意**只做淡出、不做布局折叠**（保持 IsVisible 由绑定控制、
       只在其上叠一层 opacity 过渡）——两套内容若同时参与布局会互相顶宽，
       折叠态 64px 装不下展开态的文字，会在过渡期间把侧栏顶宽再缩回，
       比硬切更难看。120ms 取区间下限：文案淡出该比宽度收拢先完成，
       否则文字会被裁在导轨边缘上。

       ⚠️ 选择器必须逐类型列全（`Grid` / `StackPanel` / `BrandLogo`）：
       AGENTS.md 记着裸 `.rail-face` 会编译期报 AVLN2200，
       而漏掉一个类型的症状是「侧栏里有的面淡入、有的瞬现」——
       比全都硬切更像缺陷。当前 8 个互斥面的类型就是这三种，
       用例 `SidebarFaces_AllCarryFadeClass` 钉住了「8 个都挂上」。 -->
  <Style Selector="Border.app-rail Grid.rail-face,
                   Border.app-rail StackPanel.rail-face,
                   Border.app-rail ctl|BrandLogo.rail-face">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <!-- U152：这里曾有一条 `Border.rail-lightline`（GlassBorder 底 + 不吃点击）。
       「迎光高光」这个手势最后是**在视图里内联** 1px Border + Ariadne.GlassBorder 落地的
       （见 WorkspacePageView.axaml 的节点卡顶缘光边），这个类全仓零挂载。
       再要加光边请沿用内联那一套，不要复活这个名字——两份实现只会分叉。 -->

  <!-- 明细行：不画盒子。左缘一道发丝竖脊 + 留白，多行堆叠时形成一列整齐的
       「索引/目录感」，比每条都套一个圆角描边盒轻得多也雅得多。
       hover 时竖脊转强调色，给出可交互暗示。 -->
  <Style Selector="Border.detail-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderDefault}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="11,1,0,1" />
    <Setter Property="Margin" Value="0,0,0,11" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.detail-row:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentPrimary}" />
  </Style>
  <!-- 强调变体：正式知识（章节/阶段总结）用主题色脊，与普通明细区分 -->
  <Style Selector="Border.detail-row.accent">
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentPrimary}" />
  </Style>

  <!-- 对象行：检查器里可增删的条目（数据引脚等）。
       不描边 —— 一列条目各自套一个圆角框会变成「小卡片阵」；
       改为极淡底色块，hover 才加深，靠底色分条而不是靠线框。 -->
  <Style Selector="Border.inspector-object-row">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundSubtle}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <!-- 与最近项目行同族：悬停时以右缘为铰链轻撬（全局统一的列表行语汇） -->
    <Setter Property="RenderTransformOrigin" Value="100%,50%" />
    <Setter Property="RenderTransform" Value="translateX(0px) rotate(0deg)" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.inspector-object-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource Ariadne.AccentLight}" />
    <Setter Property="RenderTransform" Value="translateX(-2px) rotate(-0.3deg)" />
  </Style>

  <!-- 提示条：替代原来的 danger-panel「整块着色描边盒」。
       只在左缘立一道语义色脊 + 一层极淡同色底，比四面描边的色块克制得多，
       却更醒目（视线沿竖脊走）。语义仍是「色 + 位置 + 文字」三通道，
       满足规范 §8「不可只靠颜色」。 -->
  <Style Selector="Border.notice">
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="CornerRadius" Value="0,4,4,0" />
    <Setter Property="Padding" Value="13,9" />
  </Style>
  <Style Selector="Border.notice.warning">
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.StatusWarning}" />
    <Setter Property="Background" Value="#14D97706" />
  </Style>
  <Style Selector="Border.notice.error">
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.StatusError}" />
    <Setter Property="Background" Value="#14DC2626" />
  </Style>
  <Style Selector="Border.notice.info">
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentPrimary}" />
    <Setter Property="Background" Value="{DynamicResource Ariadne.AccentLight}" />
  </Style>
  <Style Selector="Border.node-mark">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundElevated}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Ariadne.Radius.Medium}" />
  </Style>
  <Style Selector="Border.node-mark Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource Ariadne.AccentPrimary}" />
  </Style>
  <!-- U152：这里曾有一条 `Border.document-header`（纸面底 + 1px 淡边 + 大圆角），
       全仓零挂载。作品页的刊头最终走的是 `Border.page-header`（渐变过渡带）
       与下面的 `Border.document-surface`（稿纸），这一条属于从未落地的早期设计。 -->
  <!-- 稿纸：正文阅读的主体。用最亮的纸白 + 极淡发丝边 + 柔投影，
       让它真的像一张浮在工作台上的纸，而不是一个 UI 面板。
       圆角只 3px——纸张不该有网页卡片那种大圆角。 -->
  <Style Selector="Border.document-surface">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundElevated}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderCard}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="BoxShadow" Value="0 1 3 0 #14000000, 0 14 40 -12 #26000000" />
  </Style>
  <Style Selector="Border.settings-section">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderMuted}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <!-- 功能页共用的连续工作台结构：页头、命令带、数据流与检查器分区。
       页头带一层极淡的竖向渐变（纸面→工作区），让「页头」和「内容」之间
       有一道柔和的光学过渡，而不是硬生生一条线。 -->
  <Style Selector="Border.page-header">
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderMuted}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="24,16" />
    <Setter Property="MinHeight" Value="68" />
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="{DynamicResource Ariadne.Color.BackgroundElevated}" />
          <GradientStop Offset="1" Color="{DynamicResource Ariadne.Color.BackgroundSurface}" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- 页头强调标记：改为竖向渐变，上深下浅，像一枚被点亮的书签 -->
  <Style Selector="Border.page-header-mark">
    <Setter Property="Width" Value="4" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="{DynamicResource Ariadne.Color.AccentPrimary}" />
          <GradientStop Offset="1" Color="{DynamicResource Ariadne.Color.AccentHover}" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
  </Style>
  <Style Selector="Border.command-strip">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderMuted}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="20,12" />
  </Style>
  <Style Selector="Border.stream-list">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderMuted}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Ariadne.Radius.Large}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.stream-row">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderMuted}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.stream-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundElevated}" />
  </Style>
  <Style Selector="Border.inspector-section">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderMuted}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="16,14" />
  </Style>
  <Style Selector="Border.segmented-control">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderMuted}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Ariadne.Radius.Medium}" />
    <Setter Property="Padding" Value="3" />
  </Style>

  <!-- 检查器/右栏标签：Win11 pivot（底部下划线指示选中），不再是「盒子里的盒子」。
       原实现是 3~4 层嵌套：右栏 Border → 同色填充条 → 描边分段控件 → 选中态又一层
       描边+投影的小盒。现在只留一条 2px 强调色下划线；厚度常驻故切换时不挤动布局。
       工作空间检查器与作品页右栏共用此样式（单一来源）。 -->
  <Style Selector="Button.inspector-tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextSecondary}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.inspector-tab:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderDefault}" />
  </Style>
  <Style Selector="Button.inspector-tab.selected">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.AccentPrimary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.inspector-tab.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentPrimary}" />
  </Style>

  <!-- ============================================================
       「灵动」通用微交互：与左栏撬起纸片同一套缓动语言，扩散到全局可点元素。
       - 悬停：轻微上抬（预告可交互）
       - 按下：回压缩小（给出手感回馈）
       统一走 TransformOperationsTransition + CubicEaseOut，克制（≤2px / 0.97）。
       scope 到具体 class，避免影响窗口控制键 / 导航项等自带变换的控件。
       ============================================================ -->
  <Style Selector="Button.primary, Button.secondary, Button.chip-filter, Button.icon-btn, Button.btn-compact">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="translateY(0px) scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.primary:pointerover, Button.secondary:pointerover, Button.chip-filter:pointerover, Button.btn-compact:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-1px) scale(1.0)" />
  </Style>
  <Style Selector="Button.primary:pressed, Button.secondary:pressed, Button.chip-filter:pressed, Button.icon-btn:pressed, Button.btn-compact:pressed">
    <Setter Property="RenderTransform" Value="translateY(0px) scale(0.965)" />
  </Style>
  <!-- icon-btn 悬停：整键微抬，与全局「悬停即离面」同族。
       同样要按平模板内 ContentPresenter 的 FluentTheme 灰底，否则抬起时底下透出色块。 -->
  <Style Selector="Button.icon-btn /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.icon-btn:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.icon-btn:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-1px) scale(1.04)" />
  </Style>
  <!-- 标签页：悬停/选中轻抬，切换时有「浮起」感 -->
  <Style Selector="Button.inspector-tab">
    <Setter Property="RenderTransformOrigin" Value="50%,100%" />
    <Setter Property="RenderTransform" Value="translateY(0px)" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
        <BrushTransition Property="Foreground" Duration="0:0:0.14" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.inspector-tab:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-1px)" />
  </Style>
  <!-- 设置页横向标签（Win11 pivot）：同一套灵动 -->
  <Style Selector="ListBox.settings-tabs ListBoxItem">
    <Setter Property="RenderTransformOrigin" Value="50%,100%" />
    <Setter Property="RenderTransform" Value="translateY(0px)" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.settings-tabs ListBoxItem:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-1px)" />
  </Style>
  <Style Selector="Button">
    <Setter Property="FontFamily" Value="{DynamicResource Ariadne.Font.Ui}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Ariadne.Radius.Medium}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderStrong}" />
  </Style>

  <!-- 禁用态：按规范 §1.3 统一「降透明度」，而不是换成实色灰板。
       FluentTheme 默认的 ButtonBackgroundDisabled 是一块深灰实心，
       在米白纸色底上会变成刺眼的大灰砖（实测截图里最丑的元素），
       故此处保留各自语义底色，只压 Opacity——禁用仍能看出原本是主/次按钮。 -->
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderDefault}" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextSecondary}" />
  </Style>
  <!-- 禁用的主按钮：退成中性纸面，不保留强调色。
       半透明的青绿会变成一块浑浊的灰绿，比原来的灰板更难看，
       且「看着像能点但点不动」反而误导。中性 + 弱字才是正确的「不可用」信号。 -->
  <Style Selector="Button.primary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderMuted}" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextSubtle}" />
  </Style>
  <Style Selector="Button.primary:disabled">
    <Setter Property="Opacity" Value="0.75" />
  </Style>
  <Style Selector="Button.subtle:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <!-- ⚠️ TextBox 的禁用态**不在这里**（U144 挪走）：它要压模板层 `PART_BorderElement`，
       而通用 `TextBox /template/ …` 那几条声明在文件后段（约 :1950 起的输入控件节）。
       Avalonia 同优先级按文档顺序、后者胜，写在这里会被后面的通用样式盖掉——
       U154 就是这么失效的。禁用/只读/错误四态现集中在输入控件节，勿再往前搬。 -->

  <!-- 预算条：细胶囊轨 + 强调色填充，替掉 Fluent 默认那根突兀的灰线 -->
  <Style Selector="ProgressBar">
    <Setter Property="CornerRadius" Value="{DynamicResource Ariadne.Radius.Pill}" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.AccentPrimary}" />
    <Setter Property="Background" Value="{DynamicResource Ariadne.BorderMuted}" />
  </Style>
  <Style Selector="ProgressBar /template/ Border#PART_Track">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BorderMuted}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Ariadne.Radius.Pill}" />
  </Style>
  <Style Selector="ProgressBar /template/ Border#PART_Indicator">
    <Setter Property="CornerRadius" Value="{DynamicResource Ariadne.Radius.Pill}" />
  </Style>

  <!-- 主按钮：青绿强调 + 竖向微渐变，让实色块有「受光/背光」的立体感，
       而不是一块死平的色板。渐变幅度很小（Hover→Pressed 两档），
       远看仍是纯色，近看有厚度。 -->
  <Style Selector="Button.primary">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextOnAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentPressed}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="{DynamicResource Ariadne.Color.AccentPrimary}" />
          <GradientStop Offset="1" Color="{DynamicResource Ariadne.Color.AccentHover}" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 欢迎页主操作卡 -->
  <Style Selector="Button.welcome-action">
    <Setter Property="MinHeight" Value="72" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="translateY(0px) scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <!-- 主操作卡：强调色实心（原来借用导轨石墨黑，糊在纸白页面上是一块黑补丁）。
       用 AccentPrimary→AccentPressed 的斜向渐变，与首屏品牌徽记同一套语汇；
       颜色全部从主题强调色 token 派生，个性化换色时按钮跟着走。 -->
  <Style Selector="Button.welcome-action.primary-action">
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextOnAccent}" />
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="{DynamicResource Ariadne.Color.AccentPrimary}" />
          <GradientStop Offset="1" Color="{DynamicResource Ariadne.Color.AccentPressed}" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
  </Style>
  <Style Selector="Button.welcome-action.primary-action:pointerover /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentPrimary}" />
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="{DynamicResource Ariadne.Color.AccentHover}" />
          <GradientStop Offset="1" Color="{DynamicResource Ariadne.Color.AccentPrimary}" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
  </Style>
  <Style Selector="Button.welcome-action.secondary-action">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderDefault}" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextPrimary}" />
  </Style>
  <Style Selector="Button.welcome-action.secondary-action:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundElevated}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentBorder}" />
  </Style>
  <Style Selector="Button.welcome-action:pointerover">
    <!-- 主操作卡悬停：整片离面抬升（原先只换底色/边色，卡片是死的） -->
    <Setter Property="RenderTransform" Value="translateY(-3px) scale(1.008)" />
  </Style>
  <Style Selector="Button.welcome-action:pressed">
    <Setter Property="RenderTransform" Value="translateY(0px) scale(0.985)" />
  </Style>
  <Style Selector="Button.welcome-recent-item">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.welcome-recent-item:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- 最近项目行：不画盒子。默认透明，hover 整行染色 + 左缘透出强调脊，
       靠圆角染色块表达「这一行可点」，比逐个描边轻得多。 -->
  <!-- 最近项目行：沿用导轨「以右缘为铰链撬起纸片」的语汇——
       悬停时左端顶出、微上翘，底色染一层弱强调，左缘透出强调脊。
       全局共用同一套物理隐喻，而不是各处各自发明一种 hover。 -->
  <Style Selector="Grid.recent-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="RenderTransformOrigin" Value="100%,50%" />
    <Setter Property="RenderTransform" Value="translateX(0px) rotate(0deg) scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Grid.recent-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource Ariadne.AccentLight}" />
    <Setter Property="RenderTransform" Value="translateX(-3px) rotate(-0.4deg) scale(1.006)" />
  </Style>

  <!-- 节点库芯片：可拖到画布 -->
  <Style Selector="Border.library-chip">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderMuted}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Ariadne.Radius.Medium}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.library-chip:pointerover">
    <Setter Property="Background" Value="{DynamicResource Ariadne.AccentLight}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentBorder}" />
  </Style>
  <Style Selector="Border.library-chip.entry">
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentPrimary}" />
    <Setter Property="Background" Value="{DynamicResource Ariadne.AccentLight}" />
  </Style>
  <Style Selector="Button.library-chip">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderMuted}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Ariadne.Radius.Medium}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="12,8" />
    <!-- 芯片是拖源：悬停时整片轻轻「被拈起」（中心为原点均匀抬升 + 微升投影），
         预告它可以被拿走。与导轨的右缘铰链不同——这里没有固定边，是整片离面。 -->
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="translateY(0px) scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.library-chip:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-2px) scale(1.03)" />
  </Style>
  <Style Selector="Button.library-chip:pressed">
    <!-- 按下：压回桌面，给出「捏住了」的手感 -->
    <Setter Property="RenderTransform" Value="translateY(0px) scale(0.97)" />
  </Style>
  <Style Selector="Button.library-chip:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.AccentLight}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentBorder}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Ariadne.Shadow.Card}" />
  </Style>
  <Style Selector="Button.library-chip.entry">
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentPrimary}" />
    <Setter Property="Background" Value="{DynamicResource Ariadne.AccentLight}" />
  </Style>
  <!-- 执行页起始项是行不是卡：不给圆角（圆角只对有面的东西有意义），
       面与分隔线在视图里按行式列表定义。 -->
  <Style Selector="Border.exec-start-card">
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <!-- 项目 AI 输入区：Works + Workspace 共用 ProjectAiComposer / ai-composer。
       默认弱边；hover 轻强调；仅 focus-within 用主题色（产品唯一允许主题色描边的输入面）。 -->
  <Style Selector="Border.ai-composer">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundElevated}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Ariadne.Radius.Large}" />
  </Style>
  <Style Selector="Border.ai-composer:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentBorder}" />
  </Style>
  <Style Selector="Border.ai-composer:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentPrimary}" />
  </Style>

  <!-- 节点端口：实体底座承载语义图形；命中区稳定，图形在悬停/连接时填充。 -->
  <!-- 引脚：扁平极简——去掉外层盒子的底/边/影，让内部图形本身成为引脚（n8n/ComfyUI 风）。 -->
  <Style Selector="Border.pin-glass">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.pin-glass-soft">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.pin-glass:pointerover, Border.pin-glass-soft:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.16)" />
  </Style>
  <Style Selector="Border.pin-glass:pointerover Ellipse.data-port">
    <Setter Property="Fill" Value="{DynamicResource Ariadne.EdgeData}" />
  </Style>
  <Style Selector="Border.pin-glass-soft:pointerover Path.control-port">
    <Setter Property="Fill" Value="{DynamicResource Ariadne.EdgeControl}" />
  </Style>
  <Style Selector="Border.communication-port:pointerover Border.communication-core">
    <Setter Property="Background" Value="{DynamicResource Ariadne.EdgeCommunication}" />
  </Style>

  <!-- U181-E：连线**起点**引脚的「已选中」态。
       原缺陷：作者按 Enter 选好连线起点后，那个起点反而比别的端口更淡
       —— `BeginPortDragHighlight` 遍历全部节点含起点自己，同节点判 Self 失败
       ⇒ 起点节点所有端口一起被打到 Opacity 0.22。VM 侧已把起点排除在淡出之外，
       这里给它一个**看得出来**的态。

       用一圈实边而不是只改透明度：与 U178 那批「状态不能只靠颜色/明暗」一致，
       「比周围亮一点」在一堆同款小圆点里根本认不出来，实边才是形状差异。
       ⚠️ 声明在 `pin-glass` / `pin-glass-soft` 基础样式**之后**：那两条都设了
       `BorderThickness="0"`，写在前面会被整个盖掉（同优先级后者胜，U154）。

       颜色走 `Ariadne.FocusRing` —— 这是该令牌**第一个真实消费者**（U181-D：
       它此前只有定义与写入，全仓零引用，「焦点环随主题」那条接线是空转的）。
       焦点色本来就该是独立的可个性化维度，`UI组件状态表.md` 的约定也早写了
       「focus 统一使用全局 focus 环，各组件不另写 focus 颜色」。 -->
  <Style Selector="Border.connect-origin">
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.FocusRing}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Ariadne.Stroke.Emphasis}" />
  </Style>

  <!-- 选中环已由自定义 SelectionFlowRing 控件承担（流动渐变描边，主题色衍生），
       不再用 Border 平描边；此处不再保留 Border.node-flow-ring 样式。 -->
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.AccentHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentHover}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.AccentPressed}" />
  </Style>

  <!-- 次按钮：表面 + 边框 -->
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderDefault}" />
  </Style>
  <!-- 密集区紧凑按钮：模板卡脚、工具条次操作，避免默认 14×6 显得臃肿 -->
  <Style Selector="Button.btn-compact">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- 幽灵按钮：透明，hover 才显底 -->
  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextSecondary}" />
  </Style>
  <Style Selector="Button.subtle:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundHover}" />
  </Style>
  <Style Selector="Button.subtle.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.AccentLight}" />
  </Style>
  <Style Selector="Button.subtle.selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.AccentPrimary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- 危险按钮 -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.StatusError}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderDefault}" />
  </Style>

  <!-- 窗口控制：比 54px 顶栏矮一截并略偏下（U162-C）。 -->
  <Style Selector="Button.window-control">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="(ctl:HoverSpin.Enable)" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.AccentPrimary}" />
    <!-- 尺寸沿革：44x54 → 40x36 → 36x30（U162-C，同一方向的第二次收紧）。
         44x54 那版高度拉满整条标题栏，上下留白远大于左右，看着是三个瘦长条。
         36x30 仍高于「32x32 可点区域」的常见建议线，**再往下要慎重**：
         这三个键里误点关闭的代价是丢失未保存工作，MainWindowCloseGuard 只能拦下
         「已知有改动」的情形，补不了命中区过小造成的误点。
         ⚠️ MinWidth/MinHeight 必须与 Width/Height 同步：只改前两个不会缩小
         （MinHeight=36 会把 Height=30 顶回去），症状是「改了没反应」，
         极易误判成资源缓存问题。 -->
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinWidth" Value="36" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Ariadne.Radius.Medium}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.window-control Path.icon">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="StrokeThickness" Value="2.0" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stroke" Value="{DynamicResource Ariadne.AccentPrimary}" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <!-- 这里**不能**再设 RenderTransform，也不能给它挂过渡：
         自转由 HoverSpin 逐帧写 RenderTransform 驱动，而样式 Setter 的优先级高于
         代码赋值 —— 一旦这里写死 rotate(0deg)，每帧算出的角度都会被盖回 0°，
         图标就纹丝不动；补间过渡也会与逐帧驱动互相拖拽。 -->
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="StrokeThickness" Duration="0:0:0.14" />
        <BrushTransition Property="Stroke" Duration="0:0:0.14" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <!-- 最小化：实心主题色横条（比描边线更易辨认）。
       宽度与其它窗口键一致（13）；高度必须按横条真实长宽比给（15:2.4 → 13:2.08），
       不能沿用 13：Stretch=Uniform 会把横条按自身包围盒缩放，塞进 13 高的方框后
       在这种极端长宽比下不落在框心上，看着就是「没对齐中心」。
       给足真实高度后，VerticalAlignment=Center 才能把它精确居中。
       ⚠️ 改上面那条的 Width 时这里的 Height 要按 15:2.4 的比例一起改，否则横条会变粗/变细。 -->
  <Style Selector="Button.window-control Path.icon.minimize">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="2.08" />
    <Setter Property="StrokeThickness" Value="0" />
    <Setter Property="Stroke" Value="Transparent" />
    <Setter Property="Fill" Value="{DynamicResource Ariadne.AccentPrimary}" />
  </Style>
  <!-- 窗口键悬停：不铺底色块（原先整键染 AccentLight，三个键逐个亮起很花），
       改为图标自转 + 描边转强调色；旋转节奏由 HoverSpin 行为驱动（快转→停顿→慢转）。
       关闭键保留红底（危险动作需要强信号）。 -->
  <!-- 关键：Button 的底真正画在模板内的 ContentPresenter 上，FluentTheme 对它自带
       :pointerover / :pressed 灰底画刷。只在 Button 本身设 Background=Transparent
       盖不住那一层，于是悬停仍会浮出一块灰底（看着像阴影）。这里把三种状态全部按平。 -->
  <Style Selector="Button.window-control /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.window-control:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.window-control:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.window-control:pointerover Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource Ariadne.AccentHover}" />
    <Setter Property="StrokeThickness" Value="2.25" />
  </Style>
  <Style Selector="Button.window-control:pointerover Path.icon.minimize">
    <Setter Property="Fill" Value="{DynamicResource Ariadne.AccentHover}" />
    <Setter Property="StrokeThickness" Value="0" />
  </Style>
  <Style Selector="Button.window-control:pressed">
    <Setter Property="RenderTransform" Value="scale(0.9)" />
  </Style>
  <Style Selector="Button.window-control:pressed Path.icon">
    <Setter Property="Opacity" Value="0.92" />
  </Style>
  <!-- 关闭键：危险信号靠「图标变红」表达，不铺红底块。
       悬停时描边转错误色并加粗，按下再压暗一档；最小化那根实心横条改 Fill。 -->
  <Style Selector="Button.window-control.close:pointerover Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource Ariadne.StatusError}" />
    <Setter Property="StrokeThickness" Value="2.4" />
  </Style>
  <Style Selector="Button.window-control.close:pressed">
    <Setter Property="RenderTransform" Value="scale(0.9)" />
  </Style>
  <Style Selector="Button.window-control.close:pressed Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource Ariadne.StatusError}" />
    <Setter Property="Opacity" Value="0.82" />
  </Style>

  <!-- 模板市场等：一体搜索壳（左侧图标 + 输入 + 右侧提交） -->
  <Style Selector="Border.search-shell">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Ariadne.Radius.Large}" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="4,3,3,3" />
  </Style>
  <Style Selector="Border.search-shell:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderStrong}" />
  </Style>
  <!-- U154：整框响应焦点。原先只有 `:pointerover`，聚焦时外壳灰边**纹丝不动**，
       而同一产品的 ai-composer 复合输入面是会整框变强调色的——
       两种复合输入面一种响应焦点、一种不响应，是不该存在的分裂。 -->
  <Style Selector="Border.search-shell:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentPrimary}" />
  </Style>
  <Style Selector="TextBox.search-input">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="4,8,8,8" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- ⚠️ `TextBox.search-input` 的**模板层**压平样式不在这里，在输入控件节末尾（约 :2085）。
       原先它就写在这个位置，结果被约 300 行后的通用 `TextBox:focus /template/ …` 整个盖掉：
       Avalonia 同优先级按**文档顺序**、后者胜，**没有 CSS 那种选择器特异性权重**——
       `.search-input` 比 `TextBox` 具体得多，但那不给它任何优先权（U154）。
       别把它搬回来「就近管理」，一搬就复发。 -->
  <Style Selector="Button.search-submit">
    <Setter Property="Background" Value="{DynamicResource Ariadne.AccentPrimary}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextOnAccent}" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Ariadne.Radius.Medium}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.search-submit Path.icon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stroke" Value="{DynamicResource Ariadne.TextOnAccent}" />
    <Setter Property="StrokeThickness" Value="1.8" />
  </Style>
  <Style Selector="Button.search-submit:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.AccentHover}" />
  </Style>
  <Style Selector="Button.search-submit:pressed /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.92" />
  </Style>
  <!-- 模板/筛选：轻量标签芯片按钮 -->
  <Style Selector="Button.chip-filter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderMuted}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextSecondary}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Ariadne.Radius.Pill}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <Style Selector="Button.chip-filter:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.AccentLight}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentPrimary}" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.AccentPrimary}" />
  </Style>
  <Style Selector="Button.chip-filter.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.AccentLight}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentPrimary}" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.AccentPrimary}" />
  </Style>

  <!-- 通用导航项；应用壳的 rail-nav 只调整密度，颜色继续跟随主题。 -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextSecondary}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="8,9" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
        <BrushTransition Property="Foreground" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                ClipToBounds="True">
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True"
                            Background="Transparent" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.nav:pointerover">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextPrimary}" />
  </Style>
  <Style Selector="Button.nav.selected">
    <Setter Property="Background" Value="{DynamicResource Ariadne.AccentLight}" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.AccentPrimary}" />
  </Style>
  <Style Selector="Button.nav.selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.AccentPrimary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.nav.selected Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource Ariadne.AccentPrimary}" />
  </Style>
  <Style Selector="Button.nav:pointerover Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource Ariadne.AccentPrimary}" />
  </Style>

  <!--
    导轨导航项：「撬起的纸片」交互。
    物理隐喻——导轨(BackgroundSubtle) 是一道凹槽，每个入口是躺在槽里的纸片；
    铰链固定在纸片右缘(RenderTransformOrigin=100%,50%)，选中时左端向左顶出并上翘，
    于是纸片从凹槽里被撬起来：明度升到最亮白、左缘露出强调色脊、影子偏右下。
    - 旋转是刚体变换，文字不会被拉歪，只是整体跟着倾斜（真实纸片就该如此）。
    - 全部走主题 token，无硬编码色；深浅主题与个性化强调色自动跟随。
  -->
  <Style Selector="Button.nav.rail-nav">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextSecondary}" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="0,6" />
    <Setter Property="MinHeight" Value="42" />
    <!-- 左边距要留够：撬起时左端会向左顶出（translateX + 以右缘为原点的 scale
         都会向左扩），留 16px 才不会被导轨左缘裁掉左脊。 -->
    <Setter Property="Margin" Value="16,2,12,2" />
    <!-- 撬起时纸片与投影要能越出自身边界，不能被裁 -->
    <Setter Property="ClipToBounds" Value="False" />
    <!-- 铰链锚在右缘中点：左端才能既向左顶出、又向上翘起 -->
    <Setter Property="RenderTransformOrigin" Value="100%,50%" />
    <Setter Property="RenderTransform" Value="translateX(0px) rotate(0deg) scale(1)" />
    <!-- 「受光的左缘」用纸片自身的左边框实现：厚度常驻 3px（不挤动内容），
         平时透明、选中转强调色。边框会顺着 CornerRadius 包住左上/左下圆角，
         比塞一个 3px 子 Border 干净——后者会在圆角外露出毛刺。 -->
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
        <BrushTransition Property="Foreground" Duration="0:0:0.18" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.nav.rail-nav TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextSecondary}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.nav.rail-nav Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource Ariadne.TextSecondary}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Stroke" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <!-- 悬停：纸片被轻轻掀起一角（预告撬起方向），底色微染 -->
  <Style Selector="Button.nav.rail-nav:pointerover">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundHover}" />
    <Setter Property="RenderTransform" Value="translateX(-2px) rotate(-0.45deg) scale(1.008)" />
  </Style>
  <Style Selector="Button.nav.rail-nav:pointerover TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextPrimary}" />
  </Style>
  <Style Selector="Button.nav.rail-nav:pointerover Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource Ariadne.AccentPrimary}" />
  </Style>
  <!-- 按下：纸片被压回槽里（给出手感回馈） -->
  <Style Selector="Button.nav.rail-nav:pressed">
    <Setter Property="RenderTransform" Value="translateX(-1px) rotate(-0.15deg) scale(0.995)" />
  </Style>
  <!-- 选中：纸片彻底撬起——左端顶出并上翘 1.3°，明度升到最亮白。
       scale 压到 1.02：以右缘为原点时 scale 也会向左扩，两者叠加才不越界。 -->
  <Style Selector="Button.nav.rail-nav.selected">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundElevated}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentPrimary}" />
    <Setter Property="RenderTransform" Value="translateX(-5px) rotate(-1.3deg) scale(1.02)" />
  </Style>
  <Style Selector="Button.nav.rail-nav.selected /template/ Border#Root">
    <!-- 影子偏右下，反证左缘是抬起的那一侧 -->
    <Setter Property="BoxShadow" Value="{DynamicResource Ariadne.Shadow.Lift}" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <Style Selector="Button.nav.rail-nav.selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextHeading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.nav.rail-nav.selected Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource Ariadne.AccentPrimary}" />
    <Setter Property="StrokeThickness" Value="1.8" />
  </Style>
  <!-- 选中悬停：再多撬一点，暗示「已经是当前页」 -->
  <Style Selector="Button.nav.rail-nav.selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundElevated}" />
    <Setter Property="RenderTransform" Value="translateX(-7px) rotate(-1.6deg) scale(1.028)" />
  </Style>
  <!-- 悬停时左缘先透出一层弱强调，预告「这条边会被撬起」 -->
  <Style Selector="Button.nav.rail-nav:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentBorder}" />
  </Style>
  <!-- 折叠态（导轨仅 64px）：展开态的 16+12 边距会把 40px 图标格挤出导轨。
       收窄到 10+10 既不溢出，又让图标正好落在导轨中线上。 -->
  <Style Selector="Button.nav.rail-nav.collapsed">
    <Setter Property="Margin" Value="10,2,10,2" />
  </Style>
  <Style Selector="Button.rail-toggle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.rail-toggle Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource Ariadne.TextSecondary}" />
  </Style>
  <Style Selector="Button.rail-toggle:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundHover}" />
  </Style>
  <Style Selector="Button.rail-toggle:pointerover Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource Ariadne.AccentPrimary}" />
  </Style>

  <!-- 空状态面板：插画 + 文案 + 淡入 -->
  <Style Selector="Border.empty-state">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="28,36" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
      </Transitions>
    </Setter>
  </Style>
  <!-- U152：这里曾有一条 `Border.empty-state Path.empty-glyph`（72px 单 Path 插画）。
       空态插画已全部换成 `ctl:EmptyStateArt`（12 处引用），单 Path 方案零挂载。
       下面那条 `:is(UserControl)` 才是现在真正给插画容器排版的规则。 -->
  <!-- 分母题空态插画容器 -->
  <Style Selector="Border.empty-state :is(UserControl)">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,0,20" />
  </Style>
  <!-- 空态排版：空态往往独占大半屏，标题必须撑得起这块面积。
       原先 16px subtitle + 12px caption 在 1440 宽的空场里像两行小字，
       这里拉大标题、放松说明行距，让空白有一个体面的视觉焦点。

       ✅ **U204-D：空态标题不再靠覆盖 `.subtitle` 实现，改为自己的 `.empty-title`。**
       原先是 `Border.empty-state TextBlock.subtitle { FontSize=20 }`，
       加上画布右栏那条 `Border.inspector-group TextBlock.subtitle { FontSize=11 }`，
       同一个 `.subtitle` 在界面上表达 **16 / 20 / 11 三种层级**（42 / 12 / 9 处）——
       读代码时看见 `Classes="subtitle"` 无法判断它会有多大，这正是「class 名
       不再携带信息」的形态。而 20 已经撞上 `Size.Title`(20)、11 又低于
       `Size.Caption`(12)，两个覆盖值都不在 `.subtitle` 自己的语义半径里。
       ⇒ 拆成三个各自显式挂 token 的类，`.subtitle` 恢复成「只有一个字号」。
       ⚠️ 这里挂 `Size.Title` 而不是再写一个 20：空态标题与页标题本就同级，
       它们同源才是对的；此前那个 20 只是**恰好**等于 Size.Title。 -->
  <Style Selector="TextBlock.empty-title">
    <Setter Property="FontSize" Value="{DynamicResource Ariadne.Size.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextHeading}" />
  </Style>
  <Style Selector="Border.empty-state TextBlock.caption">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextSecondary}" />
  </Style>
  <!-- Logo 容器：位图钢笔由 AppIconPainter 着色；此处只铺底 -->
  <Style Selector="Border.brand-logo.on-paper">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.brand-logo.on-accent">
    <Setter Property="Background" Value="{DynamicResource Ariadne.AccentPrimary}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- 个性化调色板卡片：固定比例、选中描边 -->
  <Style Selector="Button.theme-swatch">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundElevated}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderMuted}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Ariadne.Radius.Large}" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextPrimary}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.theme-swatch:pointerover /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentBorder}" />
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundSubtle}" />
  </Style>
  <Style Selector="Button.theme-swatch.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentPrimary}" />
    <Setter Property="Background" Value="{DynamicResource Ariadne.AccentLight}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <!-- 主题三色槽位 -->
  <Style Selector="Button.theme-color-slot">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderMuted}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Ariadne.Radius.Large}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.theme-color-slot:pointerover /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentBorder}" />
  </Style>
  <Style Selector="Button.theme-color-slot.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentPrimary}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="{DynamicResource Ariadne.AccentLight}" />
  </Style>
  <!-- U152：这里曾有 `Button.color-chip`（含 :pointerover 与 .selected 三条）。
       个性化取色已换成 `Button.theme-swatch`（上方）+ `ctl:SpectrumColorPicker`，
       色块点选这条零挂载。改配色请改 theme-swatch / theme-color-slot 那两族。 -->
  <Style Selector="Slider">
    <Setter Property="Minimum" Value="0" />
  </Style>

  <!-- 横向标签（配置页顶部分段）：底部下划线指示选中，Win11 pivot 语感 -->
  <Style Selector="Button.tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextSecondary}" />
    <Setter Property="Padding" Value="4,10" />
    <Setter Property="Margin" Value="0,0,20,0" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Ariadne.TextPrimary}" />
  </Style>
  <Style Selector="Button.tab.selected">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.AccentPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentPrimary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- U152：这里曾有 `Button.panel-float`（贴右缘的圆形浮钮，含 :pointerover）
       与 `Button.panel-collapse`（右栏内的收起小钮，含 :pointerover），全仓零挂载。
       右栏开合已由 `ctl:RightPanelTogglePill` 承担。
       ⚠️ `panel-float` 是**刻意退役**不是漏删——`WorkspaceCanvas08Tests` 有一条守卫
       禁止它回到视图里，别看到那条断言就以为「样式被误删了」而把这里补回来。
       （另有一条 panel-float 过渡在下方动效区，同批删除。） -->
  <!-- 工具条图标按钮：正方形、透明底。悬停不给按钮铺灰底
       （一排按钮逐个亮起色块很花），只做整键微抬 + 图标描边转强调色。
       自转只留给窗口键三兄弟，功能键一排全转会很吵。 -->
  <Style Selector="Button.icon-btn">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <!-- U205-B：30×26 从字面量收成 token（见 Ariadne.Control.IconButton* 那段注释里
         「为什么不抬到 32」的判定）。收 token 的意义是：下一轮真要调这一族尺寸时
         改一处即可，而不是在 22 个实例里逐个找。 -->
    <Setter Property="Width" Value="{DynamicResource Ariadne.Control.IconButtonWidth}" />
    <Setter Property="Height" Value="{DynamicResource Ariadne.Control.IconButtonHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Ariadne.Radius.Medium}" />
  </Style>
  <!-- U205-B：节点卡数据输入引脚的「＋」。原为内联 Width=14 Height=16，
       是全项目最小的可点目标，且它在可缩放画布上（50% 缩放 ⇒ 7×8px）。
       这里只放大**透明命中区**，加号图形仍是 10×10 的 Path，视觉不变胖。
       ⚠️ 尺寸必须由这个 class 给：写回内联就又是 LocalValue 压过样式，
       token 在那一处静默失效。 -->
  <Style Selector="Button.pin-add">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="{DynamicResource Ariadne.Control.PinHitTarget}" />
    <Setter Property="Height" Value="{DynamicResource Ariadne.Control.PinHitTarget}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Ariadne.Radius.Small}" />
  </Style>
  <Style Selector="Button.pin-add:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundHover}" />
  </Style>
  <!-- 图标自转：悬停时图标绕自身中心转（先快转一圈→短暂停顿→持续慢转）。
       节奏由 HoverSpin 行为在代码里逐帧驱动——Avalonia 的关键帧动画不支持
       RenderTransform，且主题文件禁止 IterationCount=Infinite（守卫测试）。
       此处只保留描边变色。 -->
  <Style Selector="Button.icon-btn > Path.icon">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Stroke" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.icon-btn:pointerover > Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource Ariadne.AccentPrimary}" />
  </Style>
  <!-- 保存按钮：accent 描边区分，悬停不铺底色 -->
  <Style Selector="Button.icon-btn.save Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource Ariadne.AccentPrimary}" />
    <Setter Property="StrokeThickness" Value="2" />
  </Style>

  <!-- ⚠️ U60 响应式断点级联 —— **如实描述当前状态（U152 复核）**：
       这 5 条随 `Window.compact` / `Window.medium` 级联（断点在 MainWindow.axaml.cs
       的 `ApplyResponsiveBreakpoint`：compact < 900 / medium 900–1199 / wide ≥ 1200）。

       **实际生效的只有 1 条**：`Border.settings-index-rail`（窄屏隐藏设置页右侧索引栏，
       挂在 SettingsPageView.axaml）。另外 4 条的目标类 `Grid.form-grid` /
       `StackPanel.form-stack` / `Border.panel-section` **全仓零控件挂载**，
       因此**永不触发**——即窄窗下当前真实发生的**只是**「设置页索引栏消失」，
       并没有任何「表单拉满宽度 / 收紧网格间距」的行为。

       此处**刻意保留规则、只改注释**（原注释写着「页内表单在窄宽壳上拉满宽度、
       收紧网格间距」，描述的是不存在的行为，已是 U152 记录的误导源）。
       要不要让它们真的生效是**产品决策**，二选一，别默认改：
         (a) 补挂：给设置页那批 `Border.settings-section` 加挂 `panel-section`
             （760px 是 MinWidth，窄屏可达，22px 分区 padding 确实浪费）；
             表单网格与竖排字段各自加挂 `form-grid` / `form-stack`。
             ⚠️ 会一次改掉窄/中屏下所有设置分区的 padding，须实际开窗看观感。
         (b) 删规则：连这段注释一起删掉，只留 settings-index-rail 那条。
       现状（规则在、目标类空）**不要当成「响应式已经做了」**——它没做。 -->
  <Style Selector="Window.compact Grid.form-grid">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="Window.compact StackPanel.form-stack">
    <Setter Property="Spacing" Value="8" />
  </Style>
  <Style Selector="Window.compact Border.panel-section">
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="Window.compact Border.settings-index-rail">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Window.medium Border.panel-section">
    <Setter Property="Padding" Value="14,10" />
  </Style>

  <!-- ============================ 输入控件 ============================ -->
  <!-- U144：输入面从「品牌色凹槽 + 四边框 + 圆角」改为**一条输入线**。

       为什么换掉槽：槽 + 四边框 + 圆角是「表单格子」的语汇，97 个 TextBox 一律如此，
       整个界面就读成一堆待填的格子——而这是个写小说的工具，不是报税软件。
       换成输入线后，文字坐在线上、与上方标签齐左，一列字段读起来是一叠稿纸行，
       不再是一叠盒子。手势取自作品页刊头那条渐变细线（强调色→边框色→透明），
       即**稿纸基线**语言，与 U136「作品页是 Word 的页」同源。

       ⚠️ 这条线**不是**「点击才出现边框」（那个做法已否决）：静息就有线，
       因为线本身承载语义——**可编辑→有线，只读→无线**（见下方 IsReadOnly 一节）。
       让「能不能改」看一眼即知，比省掉一条线重要。

       ⚠️ 四个视觉属性（线宽/圆角/底/线色）在模板层 `PART_BorderElement` 上**全部显式设定**，
       不依赖 Fluent 的 `TemplateBinding`：`:pointerover` / `:focus` 那两条本来就直接改模板层，
       静息态若靠 TemplateBinding 传递，就会出现「静息走一条路、悬停走另一条路」的分叉——
       U148/U154 两个缺陷都是这种分叉的产物。
       ⚠️ `Padding` 左右取 0：输入线的产品含义是「文字与上方标签齐左」，
       任何左内缩都会让文字比标签往右挪一截，线就不成基线了。 -->
  <Style Selector="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource Ariadne.Font.Ui}" />
    <!-- 圆角必须归零：底线两端一旦带圆角会向上翘成一对小括号，不再是一条基线 -->
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <!-- Thickness 是 left,top,right,bottom：底线是 0,0,0,1。
         写成 0,0,1,0 会得到一条**右侧竖线**——一个字符之差，视觉上完全是另一回事。 -->
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextPrimary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Ariadne.AccentPrimary}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="0,5,0,6" />
  </Style>
  <!-- 静息线：实色主体 + 右端 12% 收笔淡出。
       为什么不整条走渐变淡出：短字段（200px 宽）无所谓，长字段右半截会直接消失，
       看着像线没画完；只在末尾收笔淡出，才是刊头那条线的「起笔重、收笔轻」手势。
       ⚠️ 过渡只给两支画刷，**刻意不给 BorderThickness 加 ThicknessTransition**：
       线宽是本方案的主要焦点判据，一旦有补间，任何读取都可能落在中间值上，
       测试会变成「等多久算够」的猜谜。线宽瞬时切换，反馈由颜色过渡承担。 -->
  <Style Selector="TextBox /template/ Border#PART_BorderElement">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
          <GradientStop Offset="0" Color="{DynamicResource Ariadne.Color.BorderDefault}" />
          <GradientStop Offset="0.88" Color="{DynamicResource Ariadne.Color.BorderDefault}" />
          <GradientStop Offset="1" Color="Transparent" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
        <BrushTransition Property="Background" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <!-- 悬停：只把线加深一档，**不铺底**。铺底等于把刚拆掉的槽又装回来；
       「这里可点」由指针形状与线变深表达就够了。 -->
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
          <GradientStop Offset="0" Color="{DynamicResource Ariadne.Color.BorderStrong}" />
          <GradientStop Offset="0.88" Color="{DynamicResource Ariadne.Color.BorderStrong}" />
          <GradientStop Offset="1" Color="Transparent" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- 聚焦：线点亮成强调色渐变并加粗到 2px。
       亮点从左缘起、向右淡出，与光标起点同侧——正是刊头那条线的走势。
       仍然只有一条线（底边），**不回到四边框**：加粗 + 变色已是足够清晰的反馈。 -->
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
          <GradientStop Offset="0" Color="{DynamicResource Ariadne.Color.AccentPrimary}" />
          <GradientStop Offset="0.55" Color="{DynamicResource Ariadne.Color.AccentPrimary}" />
          <GradientStop Offset="0.88" Color="{DynamicResource Ariadne.Color.BorderDefault}" />
          <GradientStop Offset="1" Color="Transparent" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- 错误：线转错误色 + 2px。
       挂在 Avalonia 自带的 `:error` 伪类上（`DataValidationErrors` 在绑定校验失败时置位），
       因此**对所有已绑定的输入立即生效、无需逐站点加 class**，也不会变成没人挂的死样式。
       现状错误信息只由输入框下方一行红字承担；线跟着变色是把同一语义补到第二通道
       （色 + 位置），不是只靠颜色。 -->
  <Style Selector="TextBox:error /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.StatusError}" />
  </Style>
  <!-- 只读 → **无线**：U144 那条衍生语法规则的另一半。
       有线=可编辑、无线=只读，于是「能不能改」看一眼即知。

       ⚠️ **Avalonia 12 没有 `:readonly` 伪类**（已在 Avalonia.Controls/Base 全量核对过伪类字符串表：
       有 `:focus` / `:pointerover` / `:error` / `:empty` 等，没有 `:readonly`），
       所以这里用**属性选择器** `[IsReadOnly=True]`。照抄 CSS/WPF 的 `:readonly` 写法
       会静默匹配不上——样式加了却毫无效果，正是 U148/U154 那一类「写了等于没写」。 -->
  <Style Selector="TextBox[IsReadOnly=True] /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- 只读且聚焦仍然无线：只读框可被 Tab 选中以复制文本，但它不可编辑，
       一旦给焦点线就等于谎报「这里能改」。声明在 `:focus` 之后才压得住（U154）。 -->
  <Style Selector="TextBox[IsReadOnly=True]:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- 禁用：线保留但退到最淡的 BorderMuted + 整体降透明。
       为什么禁用**留线**而只读**去线**——两者语义不同：
       禁用是「此处本可编辑，当前不可用」（线还在，只是灰了），
       只读是「此处从来只是展示」（根本不该有输入位的痕迹）。
       这两条样式原先在按钮禁用态那一段（约 :1093），声明位置早于本节的通用模板层样式，
       是 U154 同一个顺序陷阱的下一个受害者——一并挪到这里，四态集中且顺序正确。 -->
  <Style Selector="TextBox:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderMuted}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- U151/U152：这里曾有一条 `TextBox.document-editor`（衬线 + 16px + LineHeight 30）。
       正文编辑早就换成 ae:TextEditor 了，该类全仓零挂载——留着的唯一作用是
       **冒充「行高已经统一过了」**，正文两态行高差 33% 就是这么被漏掉的。
       行高现由 Ariadne.Reading.LineHeight 单一定义，勿再按 TextBox 补一份。

       U150/U115：`TextBox.detail-editor` 曾在这里（槽色 + BorderMuted + Mono 12 + LineHeight 18）。
       提示词编辑器已换成 `ctl:PromptTemplateEditor`（AvaloniaEdit 子类，因为
       TextBox 办不到给 `{{}}` 挂颜色与命中区），该类随之全仓零挂载 ⇒ **同批删掉**。
       ⚠️ **不要在这里按 TextBox 补一份**——`PromptTemplateEditor` 不是 TextBox，
       选择器根本命不中它，那只会造出第二条死样式（正是 U152 的形态）。

       ⚠️ **这里不要写 LineHeight**（旧样式有一条 `LineHeight=18`，已随之删掉）。
       AvaloniaEdit 自己排版、**不读 TextBlock.LineHeight**，写了是静默无效——
       U151 就是这么以为「行高已统一」的。提示词是模板不是长篇正文，
       按 AvaloniaEdit 默认的 1.16 倍读就够紧凑，不需要 Ariadne.Reading.LineHeight 那档松行距。

       ⚠️ 字体走 `Ariadne.Font.Mono`：它的 fallback 链里有 Sarasa Mono SC /
       WenQuanYi Zen Hei Mono——Cascadia Code 不含中文，没有 fallback 会渲染成豆腐块。
       AvaloniaEdit 不继承 TextBox 样式，这条必须显式给。 -->
  <Style Selector="ctl|PromptTemplateEditor">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundElevated}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderMuted}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextPrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Ariadne.Font.Mono}" />
    <Setter Property="FontSize" Value="{DynamicResource Ariadne.Size.Caption}" />
  </Style>

  <!-- ============================================================
       U184：CheckBox 的样式层（配色部分在文件上方的资源键覆盖里，
       这里只放**资源键表达不了**的两件事）。

       为什么分两处而不是都写在这里：勾选框本体的 Background / BorderBrush /
       勾号 Fill 在 Fluent 里是 `StyleTrigger`（=1）优先级，
       `/template/` 选择器（Style=3）比它弱两档、**改不动**（探针实测）。
       ⇒ 配色只能走资源键。而下面这两条改的是 **CheckBox 宿主自身**的属性
       （`Opacity` / `Transitions` 都不在模板部件上），宿主级 Style 打得到。
       ============================================================ -->
  <!-- 禁用：`UI组件状态表.md:54` 对 checkbox 的规定是 `opacity-50`。
       与 `TextBox:disabled`（同样 0.5）取同一档，而不是按钮那档 0.45——
       输入控件与按钮的禁用观感在规范里本来就是两个值（§1.3 按钮是 opacity-60/50，
       §1.4 输入控件 checkbox 是 opacity-50），这里跟输入控件。

       ⚠️ 为什么**还是需要**这条，尽管上面已给了 `…Disabled` 系列色键：
       那些键只管勾选框那 20×20 的方框和文字色，管不到**整行**。
       实测有 5 处 CheckBox 用 `IsEnabled="{Binding AllowNetwork}"` 级联禁用
       （网络关掉后 WebSearch / HttpSkill / WasmNetwork 三项随之不可用），
       没有整体降透明的话，「这一行现在不可用」这个信息只体现在框和字的色差上，
       太弱。降透明是让整行一眼看出「这组暂时不参与」。 -->
  <Style Selector="CheckBox:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <!-- 勾选/取消的颜色补间。140ms 是全仓最高频的过渡时长（既有 74 条里 25 条用它），
       hover 与状态切换一律取它，保持全局节奏一致。

       ⚠️ 过渡挂在**宿主**上而不是 `Border#NormalRectangle`：
       那个部件的 Background 是 StyleTrigger 优先级，`/template/` 选择器
       连 Setter 都递不进去（这也是配色走资源键的同一个原因）。
       挂宿主的 Foreground 过渡能让**标签文字**的色变平滑；
       方框本体的补间由 Fluent 自己模板里的过渡承担（它有，实测切换不是硬跳）。
       ⚠️ 刻意**不给 Opacity 加过渡**：禁用态多由绑定瞬时翻转，
       补间会让「不可用」这个信息延迟 140ms 才完全呈现，
       而这类级联禁用往往紧跟用户刚点的那一下，延迟会被读成卡顿。 -->
  <Style Selector="CheckBox">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.14" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <!-- U213-E：ToggleSwitch 的样式层。配色部分同样在上方资源键覆盖里
       （原因见那段注释：模板部件是 StyleTrigger 优先级，`/template/` 改不动）。
       这里只放**资源键表达不了**的两件事，且都作用在 ToggleSwitch **宿主自身**。

       禁用：与 `CheckBox:disabled` / `TextBox:disabled` 取同一档 0.5
       （`UI组件状态表.md` §1.4 输入控件那一档，不是按钮的 0.45/0.6）。
       ⚠️ 为什么资源键不够：那些键只管 40×20 的轨道和滑块，管不到**整行**。
       AutoMode 无项目时开关会灰掉，旁边那句「还没打开项目」是文字解释，
       而「这一整行现在不参与」需要整行降透明才一眼看得出。
       ⚠️ 与 CheckBox 那条一致，刻意**不给 Opacity 加过渡**：
       禁用态由绑定瞬时翻转，补间会让「不可用」延迟 140ms 才呈现，读作卡顿。 -->
  <Style Selector="ToggleSwitch:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <!-- 开/关的颜色补间。140ms 是全仓最高频的过渡时长，与 CheckBox 同节奏。
       ⚠️ 过渡挂宿主的 Foreground（标签文字色）；轨道与滑块的补间由 Fluent 自己
       模板里的 `KnobTransitions` 承担（它有，滑块位移不是硬跳）。
       挂 `/template/` 上的 Background 过渡是白费——那层是 StyleTrigger，
       连 Setter 都递不进去。 -->
  <Style Selector="ToggleSwitch">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.14" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <!-- ComboBox：与 TextBox **同一套输入线**。
       它的槽视觉是独立定义的（模板层是 `Border#Background`，不是 `PART_BorderElement`），
       所以 U144 改 TextBox 那一处**不会**带上它——若只改 TextBox，
       设置页里一列「输入线 + 品牌色槽 + 输入线」会交替出现，比原来全是槽更难看。
       一并改，是为了让「可编辑控件长什么样」在产品里只有一个答案。

       ⚠️ 下拉箭头是选择器唯一的可供性提示，所以 ComboBox 不参与「只读→无线」规则
       （它没有只读态，禁用即不可选）。 -->
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="ComboBox /template/ Border#Background">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
          <GradientStop Offset="0" Color="{DynamicResource Ariadne.Color.BorderDefault}" />
          <GradientStop Offset="0.88" Color="{DynamicResource Ariadne.Color.BorderDefault}" />
          <GradientStop Offset="1" Color="Transparent" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
        <BrushTransition Property="Background" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
          <GradientStop Offset="0" Color="{DynamicResource Ariadne.Color.BorderStrong}" />
          <GradientStop Offset="0.88" Color="{DynamicResource Ariadne.Color.BorderStrong}" />
          <GradientStop Offset="1" Color="Transparent" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
  </Style>
  <Style Selector="ComboBox:focus /template/ Border#Background">
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
          <GradientStop Offset="0" Color="{DynamicResource Ariadne.Color.AccentPrimary}" />
          <GradientStop Offset="0.55" Color="{DynamicResource Ariadne.Color.AccentPrimary}" />
          <GradientStop Offset="0.88" Color="{DynamicResource Ariadne.Color.BorderDefault}" />
          <GradientStop Offset="1" Color="Transparent" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- 下拉展开时保持焦点线（`:dropdownopen` 与 `:focus` 不一定同时置位，
       缺了它会出现「点开下拉、线却灭了」的闪断）。 -->
  <Style Selector="ComboBox:dropdownopen /template/ Border#Background">
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
          <GradientStop Offset="0" Color="{DynamicResource Ariadne.Color.AccentPrimary}" />
          <GradientStop Offset="0.55" Color="{DynamicResource Ariadne.Color.AccentPrimary}" />
          <GradientStop Offset="0.88" Color="{DynamicResource Ariadne.Color.BorderDefault}" />
          <GradientStop Offset="1" Color="Transparent" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- ⚠️ ComboBox 模板里还有**第二个** Border：`#HighlightBackground`。
       它是 Fluent 自己画选中高亮用的，默认值是 **Windows 蓝 `#FF0078D7`** ——
       一个从未被本主题覆盖的硬编码平台色，压在任何自定义强调色之上都是错的
       （青绿主题下点开下拉会闪一下蓝）。全仓 grep `0078D7` 命中 0 次正是因为
       它不在我们的源码里，而在依赖的模板里——**这类外来魔数 grep 不出来，
       只有把控件实体化后逐个数模板件才发现**（U144 补测试时才查出来）。
       改法与 `#Background` 一致：底透明，高亮改由输入线自己承担。 -->
  <Style Selector="ComboBox /template/ Border#HighlightBackground">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <!-- NumericUpDown（作品页导入序号一处）内层就是 TextBox + ButtonSpinner：
       它的文字区自动继承上面的 TextBox 输入线，但**外层 ButtonSpinner 另有一圈盒子**，
       于是会出现「盒子里套一条线」。把外层压平，只留内层那条线。 -->
  <Style Selector="NumericUpDown">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="NumericUpDown ButtonSpinner">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="NumericUpDown ButtonSpinner /template/ Border#PART_BorderElement">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ================== AutoCompleteBox：必须设在**宿主**，不能走 /template/ ==================
       U145 那批「可搜索下拉 + 允许自定义输入」的 12 个标识输入框（ModelId / ImportChapterId /
       QueryAlias / ApprovalId / SummarizerChapterId …）全是 AutoCompleteBox。
       用户报的现象：「切到其它输入框，原输入框闪白或亮起边框」——它旁边就是普通 TextBox，
       两者长得不一样，对比之下才显眼。

       实测（headless 实体化 + `GetDiagnostic` 问优先级）：内层 `PART_TextBox` 的
       Background/BorderThickness/CornerRadius/Padding/Foreground **来源全是 `Template`**，
       值是 Fluent 默认的 `#66ffffff` 半透明白底 / `1,1,1,1` 四边框 / `radius=3`。
       「闪白」正是那层半透明白底在聚焦时被 BrushTransition 淡出（实测抓到中间值
       `#66ffffff → #30ffffff → Transparent`），「亮起边框」是四边框整圈亮
       ——而旁边的纯 TextBox 只亮一条底线。

       ⚠️ **为什么不能照 U148/U154 的套路写 `/template/`**（这是本节唯一重要的结论）：
       `BindingPriority` 的数值是 `LocalValue=0 < StyleTrigger=1 < Template=2 < Style=3`，
       **数值小的胜**。AutoCompleteBox 的模板把宿主的这些属性 `TemplateBinding` 到了
       内层 `PART_TextBox` 上，于是内层拿到的是 `Template` 优先级；而我们全部
       `TextBox … /template/ Border#PART_BorderElement` 样式都是 `Style` 优先级——
       **`Style` 输给 `Template`，压不动**。
       实测证否过两种写法（都无效，勿再试）：
         `AutoCompleteBox /template/ TextBox#PART_TextBox`           → 内层仍 Template/#66ffffff
         `AutoCompleteBox TextBox /template/ Border#PART_BorderElement` → 同上
       选择器**匹配是成功的**（`Selector.Match` 返回 `AlwaysThisInstance`），
       败在优先级——这与 U154「匹配成功但被后声明样式盖掉」是**两种不同的失效**，
       别把这里的顺序当成原因去调位置。

       ✅ 正确解法：把值设在**宿主 AutoCompleteBox** 上，让它顺着模板自己的
       TemplateBinding 流到内层。宿主上是 `Style` 优先级，内层收到的仍是 `Template`，
       但值已经是我们的了。实测亮/暗两变体下，四个属性与纯 TextBox **完全一致**，
       聚焦后模板层 `thickness=0,0,0,2 radius=0 bg=Transparent`（= 纯 TextBox 的焦点态）。

       各 Setter 的理由与基础 `TextBox` 样式逐条对齐：
       - Background=Transparent：槽在 U144 已拆，这是「闪白」的根
       - BorderThickness=0,0,0,1：一条底线（left,top,right,bottom；写 0,0,1,0 会得到右竖线）
       - CornerRadius=0：底线两端带圆角会翘成一对小括号，不再是基线
       - Padding=0,5,0,6：Fluent 给的是 `10,6,6,5`，左内缩 10px 会让文字比上方标签往右挪，
         线就不成基线了（与基础 TextBox 同一理由）
       - Foreground：Fluent 在 Template 层写死 `Black`/`White` 两个**平台色而非本主题 token**，
         暗色下是纯白、亮色下是纯黑，都不是我们的 TextPrimary。硬约束「颜色只能来自主题」。
       焦点/悬停/错误/禁用四态**不必在此重复**：内层 TextBox 自己的伪类照常触发
       （实测内层确实拿到 `:focus`），那些态由上面的通用 `TextBox:*` 样式在
       `StyleTrigger`（=1，比 Template 更优先）承担，本来就压得住。 -->
  <Style Selector="AutoCompleteBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0,5,0,6" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextPrimary}" />
    <Setter Property="MinHeight" Value="32" />
  </Style>

  <!-- ================== 复合输入面的模板层压平（位置敏感，勿上移） ==================
       下面两条是**专用覆盖**，必须声明在上面所有通用 `TextBox … /template/ …` 之后。

       ⚠️ Avalonia 与 CSS **不同**：它没有「选择器特异性」权重。同一 `Styles` 集合里
       两条样式都命中同一元素的同一属性时，**后声明的无条件胜出**，与选择器多具体无关。
       `TextBox.search-input` 比 `TextBox` 具体得多，那不给它任何优先权。

       U154 就是这么失效的：`search-input:focus` 的压平原本写在文件约 :1510
       （search-shell 那一节），而通用 `TextBox:focus` 在约 :2026——后者胜，
       于是搜索框聚焦时照样长出 2px 主题色内边框 + 品牌色填充，「覆盖等于没写」。
       U148 的 composer 则是另一种失效：内联 `BorderThickness="0"` 设在 **TextBox 自身**，
       而主题样式设在 **模板内的 Border#PART_BorderElement**，两者作用对象不同、
       压根不冲突，所以谁也没盖掉谁。

       两个陷阱合起来给出压平的两个必要条件：**打到 /template/ 那一层** +
       **声明在通用样式之后**。少一个都是「写了等于没写」。
       ============================================================================ -->

  <!-- 搜索框：chrome 由外层 `Border.search-shell` 一体承担，内层必须**全态无痕**。
       四个状态各列一遍而不是只写 `:focus`：静息由基础样式给了底线（U144），
       悬停/焦点/只读各有独立覆盖，漏任一态就会在那一态下重新长出线。 -->
  <Style Selector="TextBox.search-input /template/ Border#PART_BorderElement,
                   TextBox.search-input:pointerover /template/ Border#PART_BorderElement,
                   TextBox.search-input:focus /template/ Border#PART_BorderElement,
                   TextBox.search-input:error /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- 项目 AI 输入区（U148）：焦点反馈由外层 `Border.ai-composer:focus-within` 整框承担，
       内层 TextBox 必须无描边无底。`ProjectAiComposer.axaml` 的注释一直写着这个意图，
       但那里用的是内联属性——设在 TextBox 自身，压不掉模板层，于是一次聚焦画出**两条**
       主题色线（外框一条 + 内层一条），中间隔着 Padding 的空隙，文本区还多一块品牌色底。

       ⚠️ **必须带 `Border.ai-composer` 前缀限定**：全局压平会把设置页 40 多个正常输入框的
       焦点反馈一起干掉——那是比双层边框严重得多的倒退（用户会不知道焦点在哪）。 -->
  <Style Selector="Border.ai-composer TextBox /template/ Border#PART_BorderElement,
                   Border.ai-composer TextBox:pointerover /template/ Border#PART_BorderElement,
                   Border.ai-composer TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- 分隔线 -->
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BorderMuted}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,6" />
  </Style>

  <!-- ============================================================
       U205-A：按钮簇的组间发丝竖线（唯一的可复用形态）
       ============================================================
       **为什么是新 class 而不是复用 `Separator`**：上面那条基础样式已把
       `Separator.Height` 钉成 1（为菜单里的横向分隔服务，全仓 10 处 Separator
       都在菜单里）。竖线需要「宽 1、高度随簇拉伸」，用 Separator 就得再写一条
       `Height=NaN` 去覆盖自己刚设的值 —— 那是与自己的样式打架。
       而全项目既有的 5 处发丝分隔线**本来就是 Border**，改成 class 引用是纯收敛，
       不引入第二种写法。

       **为什么必须是 class 而不是「大家各自写 Border Width=1」**：
       U205 的根因不是「没人想分组」，而是**分组没有默认形态**：
       同一个团队在 ContextMenu 里用 `<Separator/>` 分了 6 组、在按钮簇里
       零使用，因为按钮簇没有一个「一行就能用」的东西。补上这个 class
       之后，加一条分组线的成本从「抄三个属性、猜该抄哪一套数字」
       降到 `<Border Classes="group-divider" />`。

       ⚠️ **挂了这个 class 就不要再内联写 Width / Margin / Background**：
       内联属性是 `BindingPriority.LocalValue`(0)，比 Style(3) 优先且**静默生效**
       —— 那会让 token 在那一处失效，而界面上看不出任何异常。
       本项目已在同一根因上踩过三次（见 U207-C② 的内联 Fill）。 -->
  <Style Selector="Border.group-divider">
    <Setter Property="Width" Value="{DynamicResource Ariadne.Stroke.Hairline}" />
    <Setter Property="Margin" Value="{DynamicResource Ariadne.Group.DividerInset}" />
    <Setter Property="Background" Value="{DynamicResource Ariadne.BorderMuted}" />
    <!-- 高度不写死：随所在簇拉伸，簇里换了更高的控件也不用回来改数字。
         上下各内缩 5（见 Ariadne.Group.DividerInset）已让它比按钮矮一截。 -->
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <!-- ============================================================
       列表 / 下拉选中：全局改掉 Fluent 默认 SystemAccentColor 蓝，
       统一到品牌青绿（AccentLight 淡底 + AccentPrimary 文字）。
       之前设置页右侧索引「项目」是刺眼纯蓝，就是这个默认泄漏。
       ============================================================ -->
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundHover}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.AccentLight}" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.AccentPrimary}" />
  </Style>
  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.AccentLight}" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.AccentPrimary}" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundHover}" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.AccentLight}" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.AccentPrimary}" />
  </Style>

  <!-- 徽标（数字角标 / 标签 pill） -->
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource Ariadne.StatusError}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Ariadne.Radius.Pill}" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="5,0" />
  </Style>

  <!-- 运行日志级别 chip：主题 token + 不透明底，小字对比度（U70） -->
  <Style Selector="Border.log-level.error">
    <Setter Property="Background" Value="{DynamicResource Ariadne.LogErrorBg}" />
  </Style>
  <Style Selector="Border.log-level.error TextBlock.log-level-text">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.StatusError}" />
  </Style>
  <Style Selector="Border.log-level.warning">
    <Setter Property="Background" Value="{DynamicResource Ariadne.LogWarningBg}" />
  </Style>
  <Style Selector="Border.log-level.warning TextBlock.log-level-text">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.StatusWarning}" />
  </Style>
  <Style Selector="Border.log-level.info">
    <Setter Property="Background" Value="{DynamicResource Ariadne.LogInfoBg}" />
  </Style>
  <Style Selector="Border.log-level.info TextBlock.log-level-text">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.StatusInfo}" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderMuted}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Ariadne.Radius.Pill}" />
    <Setter Property="Padding" Value="10,3" />
  </Style>

  <!-- ============================ 动效 ============================ -->
  <!-- 横向 tab：下划线（BorderBrush）淡入淡出 -->
  <Style Selector="Button.tab">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
        <BrushTransition Property="Foreground" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <!-- U152：这里曾有 `Button.panel-float` 的透明度过渡，随该类整族删除（见上方按钮区）。 -->
  <!-- 主按钮按下弹性 -->
  <Style Selector="Button.primary:pressed /template/ ContentPresenter">
    <Setter Property="RenderTransform">
      <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
    </Setter>
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.segment-button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextSecondary}" />
  </Style>
  <Style Selector="Button.segment-button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundHover}" />
  </Style>
  <Style Selector="Button.segment-button.selected">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundElevated}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderMuted}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextHeading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.segment-button.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundElevated}" />
  </Style>
  <!-- 卡片悬停微抬升：整片离面（中心原点），影子随之加深。
       原先注释写「微抬升」但只换了边色，卡片其实是死的。 -->
  <Style Selector="Border.card">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="translateY(0px) scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.card:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentBorder}" />
    <Setter Property="RenderTransform" Value="translateY(-2px) scale(1.004)" />
    <Setter Property="BoxShadow" Value="{DynamicResource Ariadne.Shadow.Flyout}" />
  </Style>

  <!-- ============ Win11 毛玻璃菜单：右键 ContextMenu + 标题栏 MenuFlyout ============ -->
  <!-- 半透明底 + 亮边 + 多层阴影；菜单项圆角 hover；字体走 Ui 族 -->
  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource Ariadne.MenuBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.GlassBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="4,4" />
    <Setter Property="MinWidth" Value="148" />
    <Setter Property="FontFamily" Value="{DynamicResource Ariadne.Font.Ui}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ContextMenu /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Ariadne.MenuBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.GlassBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BoxShadow" Value="{DynamicResource Ariadne.Shadow.Flyout}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="ContextMenu.ariadne">
    <Setter Property="Background" Value="{DynamicResource Ariadne.MenuBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.GlassBorder}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="4,4" />
    <Setter Property="MinWidth" Value="148" />
    <Setter Property="FontFamily" Value="{DynamicResource Ariadne.Font.Ui}" />
  </Style>
  <Style Selector="ContextMenu.ariadne /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Ariadne.MenuBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.GlassBorder}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Ariadne.Shadow.Flyout}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- MenuFlyoutPresenter：项目菜单等同 ContextMenu 观感 -->
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.MenuBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.GlassBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="4,4" />
    <Setter Property="MinWidth" Value="156" />
    <Setter Property="FontFamily" Value="{DynamicResource Ariadne.Font.Ui}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="MenuFlyoutPresenter /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Ariadne.MenuBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.GlassBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BoxShadow" Value="{DynamicResource Ariadne.Shadow.Flyout}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource Ariadne.MenuBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.GlassBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="FontFamily" Value="{DynamicResource Ariadne.Font.Ui}" />
  </Style>
  <Style Selector="FlyoutPresenter /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Ariadne.MenuBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.GlassBorder}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BoxShadow" Value="{DynamicResource Ariadne.Shadow.Flyout}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- 菜单项：紧凑圆角 hover，统一字号（宽度跟内容，不撑大菜单） -->
  <Style Selector="ContextMenu MenuItem, MenuFlyoutPresenter MenuItem">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextPrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Ariadne.Font.Ui}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ContextMenu MenuItem /template/ Border#PART_LayoutRoot,
                   MenuFlyoutPresenter MenuItem /template/ Border#PART_LayoutRoot">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.10" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ContextMenu MenuItem:selected /template/ Border#PART_LayoutRoot,
                   ContextMenu MenuItem:pointerover /template/ Border#PART_LayoutRoot,
                   MenuFlyoutPresenter MenuItem:selected /template/ Border#PART_LayoutRoot,
                   MenuFlyoutPresenter MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundHover}" />
  </Style>
  <Style Selector="ContextMenu MenuItem:selected, MenuFlyoutPresenter MenuItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.AccentPrimary}" />
  </Style>
  <Style Selector="ContextMenu Separator, MenuFlyoutPresenter Separator">
    <Setter Property="Background" Value="{DynamicResource Ariadne.BorderMuted}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="8,3" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="ContextMenu MenuItem.danger, MenuFlyoutPresenter MenuItem.danger">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.StatusError}" />
  </Style>
  <Style Selector="ContextMenu MenuItem.danger:selected, MenuFlyoutPresenter MenuItem.danger:selected">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.StatusError}" />
  </Style>

  <!-- 弹窗卡片毛玻璃（ConfirmDialog 等） -->
  <Style Selector="Border.glass-dialog">
    <Setter Property="Background" Value="{DynamicResource Ariadne.GlassTint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.GlassBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BoxShadow" Value="{DynamicResource Ariadne.Shadow.Dialog}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- ============================================================
       U178-E：全局弹窗原先零进场动效——遮罩靠 IsVisible 直接翻，
       面板（含一层 ExperimentalAcrylicBorder）从无到有硬闪。
       毛玻璃硬闪比不做毛玻璃更廉价，这是全应用观感最差的一处。

       ⚠️ 本条**只做淡入与缩放，不碰 acrylic 实现**：
       `BackgroundSource` 只有 None/Digger 两个值，而 Digger 会挖穿所有渲染层
       （画布点阵网格本身就是渲染层，结果会露出桌面壁纸）——
       「真毛玻璃」在本项目已定论为不可能，别再往那个方向试。
       ============================================================ -->

  <!-- 遮罩静息态 = **关闭态**（透明 + 关闭时长）。
       这个方向的选择是本条的关键设计：把「关」放在基础样式、「开」放在带类的样式，
       于是 Avalonia 自动给出两个方向不同的时长——
       过渡时长取自**将要进入的那个状态**的样式，
       进入 .dialog-open 用 160/140ms，退回基础态用 128/112ms。
       不必写任何 code-behind，也不会出现「开有动效、关是硬切」的半成品。

       **为什么关闭取入场的 0.8 倍**（160→128、140→112）：
       打开时用户在等界面把新内容交代清楚，稍慢一点读作「郑重」；
       关闭时决定已经做完，用户想立刻回到原来的任务，多余的等待一律读作「卡了一下」。
       0.8 是桌面惯例里最常见的比值——快到不拖沓，又没快到让人看不出
       这是同一个动作在反向播放（那就退化成硬切了）。 -->
  <Style Selector="Border.dialog-scrim">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.112" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.dialog-scrim.dialog-open">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <!-- 面板：160ms 淡入 + 0.96→1.0 缩放，锚在中心（弹窗本身居中，
       所以它是「从中间长出来」而不是从某个角飞入）。
       语汇（CubicEaseOut）与既有 dock-rail / rail-nav 一致，**刻意不用过冲曲线**——
       确认弹窗常承载破坏性操作（删除、放弃修改），过冲会让它显得轻浮。
       过冲（BackEaseOut）留给滑块那类连续手势。

       ⚠️ 类挂在**常驻**的 ContentControl 上，不挂 ConfirmDialogView 里的
       `Border.glass-dialog`：后者随 ActiveDialog 创建/销毁，控件都没了，
       退场动效无处可播。挂在常驻宿主上，一并把它内部那层
       ExperimentalAcrylicBorder 的不透明度也带着走（子级渲染继承父级 Opacity），
       正好治掉「毛玻璃从无到有硬闪」这个观感最差的点。 -->
  <Style Selector="ContentControl.dialog-panel">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scale(0.96)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.128" Easing="CubicEaseOut" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.128" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ContentControl.dialog-panel.dialog-open">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <!-- ============================================================
       U178-F / U164-B：Expander 全项目 14 处（SettingsPageView 8、
       WorksPageView 5、GitPageView 1），**此前零个自定义样式**——
       全部走 FluentTheme 默认外观，与项目其余控件（节点卡、settings-section、
       chip、detail-row）完全不同的语汇，所以显得突兀；且展开是瞬变。

       ⚠️⚠️ **本块的写法由一次实测决定，不要照直觉改。**
       探针（Avalonia 12.0.5 + FluentTheme，headless 实跑）给出的部件树与优先级：

         DockPanel
           ToggleButton  Name=ExpanderHeader        ← 宿主级，Style 打得到
             Border      Name=ToggleButtonBackground  ← Background/Border* = Template
             Grid        Name=ToggleButtonGrid
               ContentPresenter Name=PART_ContentPresenter
               Border    Name=ExpandCollapseChevronBorder ← 全属性 = Template
                 Path    Name=ExpandCollapseChevron      ← Data=Style, Stroke=Template
           Border        Name=ExpanderContent        ← Background/Padding = Template
                                                       BorderThickness/CornerRadius = StyleTrigger

       **BindingPriority 数值小者胜：LocalValue=0 < StyleTrigger=1 < Template=2 < Style=3。**
       ⇒ 凡上面标 `Template` 的属性，`/template/` 选择器（Style 优先级 3）**改不动**。
       实测印证：`ExpanderHeader` 自己的 Background 是 `Style`（可改），
       而它内部 `Border#ToggleButtonBackground` 的同名属性是 `Template`（改不动）——
       同一个视觉效果，打宿主行、打内部部件不行。

       **所以覆盖走「改 Fluent 的资源键」这条路**，不是 /template/ 选择器。
       探针确认下列键在 12.0.5 里存在（TryFindResource=True）：
         ExpanderHeaderBackground / ...BorderBrush / ...Foreground / ...BorderThickness
         / ...Padding / ExpanderContentBackground / ...BorderBrush / ...Padding
         / ExpanderChevronForeground / ...Background / ...BorderBrush
         / ExpanderMinHeight / ExpanderChevronButtonSize / ExpanderContentDownBorderThickness
       不存在（别写，写了是死键）：ExpanderChevron*Glyph、ExpanderHeaderCornerRadius。
       资源键是 Template 里 TemplateBinding 的**来源**，改源头就绕过了优先级之争。

       图标：Fluent 的 chevron 实测是 `Path.Data` = StreamGeometry（矢量几何，
       **不是图标字体**）⇒「禁用图标字体」这条硬约束本来就满足，无须替换。
       为什么不替换、以及替换的具体风险，见下方那条 Style 的注释。
       ============================================================ -->
  <!-- 头部圆角：Fluent 靠 StyleTrigger 在展开/收起间切 3,3,0,0 ⇄ 3,3,3,3
       （优先级 1，Style 打不过）。但 CornerRadius 在 ToggleButton **宿主**上是
       StyleTrigger、在内部 Border#ToggleButtonBackground 上是 Template——
       两条路都比 Style 强。⇒ 圆角这一项**放弃统一**，保留 Fluent 的 3px。
       写在注释里是为了让下一个人别再试一遍：这不是漏做，是打不过。
       （真要改只剩「整份替换 ControlTheme」一条路，代价远大于 3px 圆角的收益。） -->

  <!-- 头部：hover 时整行底色淡入加深、文字与箭头同步转深，
       让「这行可以点」成为手感而非猜测。
       140ms 是全仓最高频的过渡时长（25 处），hover 一律用它，保持节奏一致。 -->
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" Easing="CubicEaseOut" />
        <BrushTransition Property="Foreground" Duration="0:0:0.14" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <!-- 箭头换成项目自己的矢量 Geometry。
       ⚠️ **选择器必须穿两层 `/template/`**，这是实测踩出来的：
       chevron 不在 Expander 的模板里，而在 `ToggleButton#ExpanderHeader`
       **自己的**模板里（Fluent 给那个 ToggleButton 挂了独立 ControlTheme）。
       单层 `Expander /template/ Path#ExpandCollapseChevron` 编译通过、
       运行时**静默不匹配**（实测 Width 停在 NaN、Transitions 为空）——
       `/template/` 只下降一层模板边界，不会穿透嵌套模板。
       同理可推：以后要改任何 Fluent 复合控件的深层部件，先数模板层数。 -->
  <!-- 箭头：**刻意不替换 Data**，这与 U164-B 的原始建议相反，理由是实测推翻了它的前提。
       U164-B 说「FluentTheme 默认用它自己的图标资源，按『图标用矢量 Geometry、
       禁用图标字体』该换掉，默认那个在 Linux 上有风险」。
       探针实测：Fluent 的 chevron 是 `Path` + `Data`=StreamGeometry（**矢量几何**），
       不是 Segoe Fluent Icons 那类图标字体 ⇒ **硬约束本来就已满足**，
       Linux 豆腐块风险不存在，替换的收益是零。

       而替换的**代价是真实的**：模板给 chevron 挂了一个 RotateTransform，
       实测 `Angle` 的 BindingPriority 是 `Animation`（Avalonia 的 Transition
       就写在这个优先级上）——Style/Template 都盖不住，且两态读数恒为 180。
       换成本项目的 ChevronDown（apex 在下）后，它与那个 180° 复合出的朝向
       在 headless 里**无法判定**（两态同值，像素探针也没能给出可读结果）。
       ⇒ 拿零收益去换一个「可能整个箭头反了、且本机测不出来」的风险，不做。

       **只改颜色与尺寸**（这两项探针已验证生效）：
       Stroke 由 ExpanderChevronForeground 资源键给到（实测 = TextSecondary），
       hover 转主色的过渡挂在这里，140ms 与头部同步。 -->
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader /template/ Path#ExpandCollapseChevron">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Stroke" Duration="0:0:0.14" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <!-- ⚠️ **这里刻意没有内容区淡入**，别再加回来。
       我先挂过 `Border#ExpanderContent` 的 Opacity 过渡，探针证明它是死的：
       Fluent 用 `IsVisible`（Template 优先级）切内容区，
       `Opacity` 两态恒为 1 —— 没有任何东西驱动它，过渡永远不触发。
       而 IsVisible=false 的控件在 Avalonia 12 里根本不参与渲染
       （MeasureCore/ArrangeCore 整个包在 if (IsVisible) 里），
       所以也不能靠它做淡出。

       ⇒ 展开动效的实际承载是「箭头旋转（Fluent 自带关键帧）+ 头部 hover 反馈」。
       想做真正的高度展开动画只剩「整份替换 Expander 的 ControlTheme」一条路
       （Height 从 Auto 到具体值不可插值，得自己量内容高度再动画），
       代价远超收益，本轮不做。 -->
  <!-- ============================================================
       U178-D/E/F 的「减少动态效果」门控。

       **背景：这是一条既有缺口，不是本轮引入的。** 主题文件里 `reduce-motion`
       原本出现 0 次 ⇒ 全部 74 条既有过渡都不受该偏好管；唯一在用的
       `UserControl.reduce-motion` 那 5 条只作用在 `WorkspacePageView` 内部。
       本轮只补**自己新加的这 5 条**（侧栏宽度 / rail-face 淡入 / 遮罩 /
       弹窗面板 / Expander 头部），刻意不动那 74 条——同一份文件此刻有别的
       施工在进行，大面积改动只会制造冲突。剩余缺口已记入 U178 文档。

       **做法可行性是实测过的，不是照猜**（headless 探针，跑完已删）：
         无 class          → Transitions = COUNT=1 [DoubleTransition]
         加 reduce-motion  → Transitions = EMPTY(0)
         再摘掉            → Transitions = COUNT=1 [DoubleTransition]
       即：这组覆盖**能**清掉基础样式里的 `Transitions`，且可逆。

       ⚠️ **胜负不是靠「声明在后面」——我先前的这个判断被变异测试推翻了。**
       变异形态：把这一整块搬到文件**最前面**（远早于 `Border.app-rail` 基础样式），
       预期它该失效、用例该红——**实际仍然绿、门控照样生效**。
       ⇒ 真正的原因是**选择器更具体**（`Window.reduce-motion Border.app-rail`
       比 `Border.app-rail` 多一层带类祖先），Avalonia 会让更具体的那条赢，
       与文档顺序无关。「同优先级按文档顺序后者胜」（U154）只适用于
       **选择器特异性相同**的两条规则，例如 `TextBox` 与 `TextBox.search-input`
       各自被通用规则覆盖那种情形——别把那条经验推广成普适规则。
       所以本块留在末尾只是为了可读性（门控集中一处），不是正确性所必需。

       置空 `<Transitions />` 而不是把 Duration 设 0：空集合让属性变化走
       直接赋值的快路径，0 时长仍要走一遍动画调度（同 MainWindow
       `ApplyPageTransition` 里「置 null 而非 0」的取舍，保持一致）。

       类由 `MainWindow.ApplyMotionPreferenceClass()` 挂在 Window 上，
       所以这些选择器一律以 `Window.reduce-motion` 起头。
       ============================================================ -->
  <Style Selector="Window.reduce-motion Border.app-rail">
    <Setter Property="Transitions">
      <Transitions />
    </Setter>
  </Style>
  <Style Selector="Window.reduce-motion Border.app-rail Grid.rail-face,
                   Window.reduce-motion Border.app-rail StackPanel.rail-face,
                   Window.reduce-motion Border.app-rail ctl|BrandLogo.rail-face">
    <Setter Property="Transitions">
      <Transitions />
    </Setter>
  </Style>
  <!-- 遮罩与面板：两态各自的样式都要置空，否则「开」那一侧仍会跑动画
       （过渡时长取自将要进入的那个状态的样式，见上文 dialog-scrim 一节）。 -->
  <Style Selector="Window.reduce-motion Border.dialog-scrim,
                   Window.reduce-motion Border.dialog-scrim.dialog-open,
                   Window.reduce-motion ContentControl.dialog-panel,
                   Window.reduce-motion ContentControl.dialog-panel.dialog-open">
    <Setter Property="Transitions">
      <Transitions />
    </Setter>
  </Style>
  <!-- 弹窗面板还要把缩放归位：只摘过渡的话，面板会**停在 scale(0.96)**
       ——静止的缩小态是可见的视觉缺陷（面板比该有的小一圈），
       比"没有动效"更糟。减少动效意味着直接呈现终态，不是呈现动画的起始帧。 -->
  <Style Selector="Window.reduce-motion ContentControl.dialog-panel">
    <Setter Property="RenderTransform" Value="scale(1)" />
  </Style>
  <Style Selector="Window.reduce-motion Expander /template/ ToggleButton#ExpanderHeader">
    <Setter Property="Transitions">
      <Transitions />
    </Setter>
  </Style>
  <Style Selector="Window.reduce-motion Expander /template/ ToggleButton#ExpanderHeader /template/ Path#ExpandCollapseChevron">
    <Setter Property="Transitions">
      <Transitions />
    </Setter>
  </Style>

  <!-- ============================================================
       预算余量分档（U194-E）

       缺陷版本：预算条**一路青绿到 100%**。余量剩 $0.50 与剩 $50 长得完全一样
       （同一 Ariadne.AccentPrimary），金额文字同一灰，作者只能在「点运行被后端拒绝」
       那一刻才知道额度到头——界面从「一切正常」直接跳到「被拒」。

       error 档是 `指导性文件/UI组件状态表.md:34` 的硬要求
       （「余量<$2 → bg-status-error + 文字 text-error font-medium」），
       判据是**绝对余量**而不是百分比，见 `MainWindowViewModel.ResolveBudgetSeverity`。

       ⚠️ **这几条必须留在文件末尾**：`TextBlock.caption` 的 Foreground
       （:1003，Ariadne.TextSecondary）与这里冲突，而 Avalonia **同优先级按文档顺序、
       后者胜，没有 CSS 那种选择器特异性权重**——`.caption.budget-error` 比
       `.caption` 具体得多，但这不给它任何优先权。搬到 caption 之前就会被整条盖掉
       （U154 正是这么失效的）。
       ============================================================ -->
  <Style Selector="ProgressBar.budget-warning">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.StatusWarning}" />
  </Style>
  <Style Selector="ProgressBar.budget-error">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.StatusError}" />
  </Style>
  <!-- 文字色跟着变，且 error 档加粗（规范的 `text-error font-medium`）：
       只换颜色的话，色弱用户与低对比度屏上这一档与正常档几乎无差别，
       而这是「跑不动了」的最后一次预告。 -->
  <Style Selector="TextBlock.budget-warning">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.StatusWarning}" />
  </Style>
  <Style Selector="TextBlock.budget-error">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.StatusError}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ============================================================
       U207-C②：危险色在**禁用态**退成中性 —— 把 `Button.primary:disabled`
       那条已定的规则推广到 danger 一族。

       原状（实测取证）：画布下栏三个运行控制键在空闲态全禁用，
       `Button:disabled` 的 Opacity=0.45 让暂停/继续淡成灰线（非纸白像素 66 / 53），
       而停止那个方块因为走错误色仍是**粉红实心**（100 px）
       ⇒ 界面上最醒目的运行控制恰是此刻最无意义的那个。

       为什么改不动：那个方块的 Fill 原本**内联**写在 Path 上
       （`Fill="{DynamicResource Ariadne.StatusError}"`）。Avalonia 的
       `LocalValue=0` 压过 `StyleTrigger=1`/`Template=2`/`Style=3`，
       所以任何样式规则都碰不到它 —— 这不是声明顺序问题，挪位置白费功夫。
       修法是把颜色交给 class（见 WorkspacePageView.axaml 的 `StopRunIcon`），
       样式层才有可能接管。

       ⚠️ 这几条必须留在文件**末尾**：`Path.icon-fill`（:1015）也设 Fill，
       Avalonia 同优先级按文档顺序、后者胜（文件上方 budget 那组注释同一条理由）。
       搬到 `Path.icon-fill` 之前就会被整条盖掉。

       退成 `Ariadne.TextSecondary` 而不是 `TextSubtle`：这个图标的邻居
       （暂停/继续）就是 TextSecondary，取同一枚令牌才让三键在禁用态**齐平**，
       而「齐平」正是本条要的结果 —— 换成更淡的 TextSubtle 只是把
       「停止最扎眼」换成「停止最看不见」，仍然是三键不齐。
       文字型 danger 按钮则跟 `Button.primary:disabled` 的先例走 TextSubtle。
       ============================================================ -->
  <Style Selector="Path.icon-fill.danger">
    <Setter Property="Fill" Value="{DynamicResource Ariadne.StatusError}" />
  </Style>
  <!-- 禁用宿主里的危险图标：退到与同组中性图标同一枚令牌。
       选择器带 `Button:disabled` 祖先，且声明在上面那条之后 ——
       两种口径（更具体 / 文档顺序在后）都判它赢，不赌任何一种。
       ⚠️ 刻意**不**同时造一条描边版 `Path.icon.danger`：全仓零处使用描边型
       危险图标，预造规则等于给样式表加一条永不触发的死规则（AGENTS §4）。
       真出现第一个描边危险图标时照这条补 Stroke 即可。 -->
  <Style Selector="Button:disabled Path.icon-fill.danger">
    <Setter Property="Fill" Value="{DynamicResource Ariadne.TextSecondary}" />
  </Style>
  <!-- 文字型危险按钮：`Button.danger` 把 Foreground 设在**宿主**上，
       经模板的 TemplateBinding 以 Template(2) 优先级落到 ContentPresenter，
       所以两处都要写 —— 只写 `/template/ ContentPresenter` 会被宿主值盖回去，
       只写宿主又管不到已被模板绑定下传的那一层。 -->
  <Style Selector="Button.danger:disabled">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextSubtle}" />
  </Style>
  <Style Selector="Button.danger:disabled /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextSubtle}" />
  </Style>

  <!-- ============================================================
       U194-A：作品页「保存失败」的常驻标记

       原缺陷：保存失败后 `DocumentSaveStateText` 显示「未保存」，
       与「还没点过保存」**完全同形** —— 同一句话、同一个 subtle 灰。
       于是唯一带数据风险的状态（点过保存、后端拒了、正文没落盘）
       在界面上没有任何区别于常态的表示，作者继续写，以为存上了。

       只有失败档挂类，保存中/未保存/已保存三态保持 subtle 灰：
       「一律醒目」不是分级，只是把「都看不见」换成「都在喊」。

       ⚠️ **必须留在 `TextBlock.subtle`（:1246）之后**：那条也设 Foreground，
       而 Avalonia 同优先级按**文档顺序、后者胜**，没有 CSS 那种选择器特异性权重
       —— `.subtle.save-failed` 比 `.subtle` 具体得多，但这不给它任何优先权。
       ============================================================ -->
  <Style Selector="TextBlock.save-failed">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.StatusError}" />
    <!-- 加粗与预算 error 档同一理由：只换颜色的话，色弱用户与低对比度屏上
         这一档与常态几乎无差别，而它是「正文还没落盘」的唯一持续提示。 -->
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- ============================================================
       U194-B：顶栏通知分级

       原缺陷：`NotificationText` 的 10 处赋值（版本号、初始化失败、离开项目失败、
       外链打不开、维护阶段、批量保存部分失败/全失败、崩回欢迎页、中断日志）
       全写同一属性，渲染成同一条 `subtle` 灰字 + 一个 Fill 写死
       `Ariadne.TextSubtle` 的恒定灰小圆点 ⇒ 无分级、后写的静默覆盖先写的。
       对照：弹窗**有**分级（`ConfirmDialogViewModel.DialogSeverity` 的
       Warning/Danger）⇒ 有弹窗分级、非弹窗渠道零分级。

       只有 warning/error 两档挂类，info 档保持原来的中性灰：
       「一律醒目」不是分级，只是把「都看不见」换成「都在喊」。
       ============================================================ -->
  <Style Selector="Ellipse.header-notice">
    <Setter Property="Fill" Value="{DynamicResource Ariadne.TextSubtle}" />
  </Style>
  <Style Selector="Ellipse.header-notice.notice-warning">
    <Setter Property="Fill" Value="{DynamicResource Ariadne.StatusWarning}" />
  </Style>
  <Style Selector="Ellipse.header-notice.notice-error">
    <Setter Property="Fill" Value="{DynamicResource Ariadne.StatusError}" />
  </Style>
  <!-- 文字色也跟着变：圆点只有 6×6，单靠它在 1440p 屏上几乎不可见，
       而这条通知的整个价值就在于被看见。error 档加粗（与预算 error 档同规）。 -->
  <Style Selector="TextBlock.notice-warning">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.StatusWarning}" />
  </Style>
  <Style Selector="TextBlock.notice-error">
    <Setter Property="Foreground" Value="{DynamicResource Ariadne.StatusError}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

</Styles>
