<UserControl
    x:Class="Ariadne.Desktop.Views.WelcomeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Ariadne.Desktop.Controls"
    xmlns:vm="clr-namespace:Ariadne.Desktop.ViewModels"
    x:Name="Root"
    x:DataType="vm:WelcomeViewModel">

  <UserControl.Styles>
    <!-- 失效条目置灰（U143）。样式留在本页而不是进主题文件：
         这是欢迎页最近项目独有的状态，抬到全局 token 只会给主题增负担。
         选择器**必须带元素类型前缀**：Avalonia 的 Setter 要能确定目标类型，
         裸 `.recent-identity` 会在编译期报 AVLN2200。两处宿主分别是
         图标 Border 与文本 StackPanel，二者没有共同基类可归并，故分开写。 -->
    <Style Selector="Border.recent-identity">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.recent-identity.unavailable">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="StackPanel.recent-identity">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="StackPanel.recent-identity.unavailable">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </UserControl.Styles>

  <!-- 创作首页：编辑排版式骨架 + 生成式叙事轨迹，操作与最近项目仍保持高密度可扫描。 -->
  <Panel>
    <Border Background="{DynamicResource Ariadne.BackgroundMain}" />
    <ctl:StudioBackdrop Opacity="0.92" />

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <Grid MaxWidth="1180"
            MinHeight="540"
            Margin="54,38"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            RowDefinitions="Auto,30,*"
            ColumnDefinitions="1.08*,48,0.92*">

        <!-- 品牌首屏信号：真正的产品名，而不是说明性大标题。 -->
        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="16" VerticalAlignment="Top">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
            <!-- 品牌徽记：去掉「灰底描边小卡」，改成强调色渐变圆牌 +
                 一圈极淡光环。Logo 反白落在实色上，对比度足够，
                 也让整页有一个真正的视觉焦点（而不是一块灰补丁）。 -->
            <Panel Grid.Column="0" Width="80" Height="80" VerticalAlignment="Center">
              <Ellipse Width="80" Height="80" Opacity="0.16">
                <Ellipse.Fill>
                  <RadialGradientBrush GradientOrigin="50%,50%" Center="50%,50%" RadiusX="50%" RadiusY="50%">
                    <GradientStop Offset="0.55" Color="{DynamicResource Ariadne.Color.AccentPrimary}" />
                    <GradientStop Offset="1" Color="Transparent" />
                  </RadialGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
              <Border Width="62" Height="62" CornerRadius="18"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      BoxShadow="{DynamicResource Ariadne.Shadow.Card}">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="{DynamicResource Ariadne.Color.AccentHover}" />
                    <GradientStop Offset="1" Color="{DynamicResource Ariadne.Color.AccentPressed}" />
                  </LinearGradientBrush>
                </Border.Background>
                <ctl:BrandLogo Width="40" Height="40" OnAccent="True"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Panel>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
              <!-- 强调色短横改用主题色（原硬编码橙与青绿强调色系互斥） -->
              <Border Width="34" Height="4" CornerRadius="2"
                      Background="{DynamicResource Ariadne.AccentPrimary}"
                      HorizontalAlignment="Left" />
              <TextBlock Text="{Binding BrandName}"
                         FontSize="46"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Ariadne.TextHeading}"
                         LetterSpacing="0" />
            </StackPanel>
          </Grid>

          <TextBlock Text="{Binding Subtitle}"
                     Classes="secondary"
                     FontSize="16"
                     LineHeight="25"
                     TextWrapping="Wrap"
                     MaxWidth="510" />

          <!-- 引言：左缘强调脊 + 极淡强调底，与全局「受光左缘」语汇一致 -->
          <Border HorizontalAlignment="Left"
                  Background="{DynamicResource Ariadne.AccentLight}"
                  BorderBrush="{DynamicResource Ariadne.AccentPrimary}"
                  BorderThickness="3,0,0,0"
                  CornerRadius="0,4,4,0"
                  Padding="12,7">
            <TextBlock Text="{Binding HeroTagline}"
                       Classes="caption"
                       Foreground="{DynamicResource Ariadne.TextPrimary}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
          </Border>
        </StackPanel>

        <!-- 左下：进入创作流的两条主路径。 -->
        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="12" VerticalAlignment="Top">
          <Button Classes="welcome-action primary-action"
                  Command="{Binding CreateProjectCommand}"
                  IsEnabled="{Binding CanStartProjectAction}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Margin="2">
              <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8"
                      Background="{DynamicResource Ariadne.GlassBorder}" VerticalAlignment="Center">
                <Path Classes="icon" Width="18" Height="18"
                      Stroke="{DynamicResource Ariadne.TextOnAccent}"
                      Data="{StaticResource Ariadne.Icon.Add}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{Binding CreateProjectText}"
                           FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource Ariadne.TextOnAccent}" />
                <TextBlock Text="{Binding CreateProjectHint}"
                           FontSize="12" Opacity="0.78" TextWrapping="Wrap"
                           Foreground="{DynamicResource Ariadne.TextOnAccent}" />
              </StackPanel>
              <Path Grid.Column="2" Classes="icon" Width="15" Height="15"
                    Stroke="{DynamicResource Ariadne.TextOnAccent}"
                    Data="{StaticResource Ariadne.Icon.ChevronRight}"
                    VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button Classes="welcome-action secondary-action"
                  Command="{Binding OpenProjectCommand}"
                  IsEnabled="{Binding CanStartProjectAction}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Margin="2">
              <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8"
                      Background="{DynamicResource Ariadne.AccentLight}"
                      VerticalAlignment="Center">
                <Path Classes="icon" Width="18" Height="18"
                      Stroke="{DynamicResource Ariadne.AccentPrimary}"
                      Data="M4,6 L10,6 L12,8 L20,8 L20,18 L4,18 Z" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{Binding OpenProjectText}"
                           FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource Ariadne.TextPrimary}" />
                <TextBlock Text="{Binding OpenProjectHint}"
                           Classes="caption" TextWrapping="Wrap" />
              </StackPanel>
              <Path Grid.Column="2" Classes="icon" Width="15" Height="15"
                    Data="{StaticResource Ariadne.Icon.ChevronRight}"
                    VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Border IsVisible="{Binding HasStatusText}"
                  Background="{DynamicResource Ariadne.BackgroundElevated}"
                  BorderBrush="{DynamicResource Ariadne.BorderMuted}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="12,9">
            <TextBlock Text="{Binding StatusText}"
                       Classes="caption"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Assertive" />
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
            <Button Classes="subtle" Padding="10,6"
                    Content="{Binding TutorialText}" Command="{Binding TutorialCommand}" />
            <Border Width="1" Height="14" Margin="6,0"
                    Background="{DynamicResource Ariadne.BorderMuted}" VerticalAlignment="Center" />
            <Button Classes="subtle" Padding="10,6"
                    Content="{Binding FeedbackText}" Command="{Binding FeedbackCommand}" />
          </StackPanel>
        </StackPanel>

        <!-- 最近项目：轻量桌面清单（规范「不是网页卡片」）。
             外壳退成一层安静纸面 + 发丝边（原来的 Flyout 重投影是本页最抢眼的噪点），
             表头去掉与内容同色的重复底，条目去掉逐个描边盒——改成 hover 染色 + 分隔线。 -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="2"
                x:Name="RecentProjectsCard"
                Background="{DynamicResource Ariadne.BackgroundSurface}"
                BorderBrush="{DynamicResource Ariadne.BorderMuted}"
                BorderThickness="1"
                CornerRadius="10"
                BoxShadow="{DynamicResource Ariadne.Shadow.Card}"
                Padding="0"
                MaxHeight="520"
                VerticalAlignment="Center"
                ClipToBounds="True">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"
                  Margin="20,17">
              <Border Grid.Column="0" Width="4" Height="22" CornerRadius="2"
                      Background="{DynamicResource Ariadne.AccentPrimary}"
                      VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="{Binding RecentProjectsTitle}"
                         Classes="subtitle"
                         VerticalAlignment="Center" />
              <!-- 计数：去掉描边胶囊，强调色文字自解释 -->
              <TextBlock Grid.Column="2"
                         Text="{Binding RecentCountText}"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource Ariadne.AccentPrimary}"
                         VerticalAlignment="Center"
                         IsVisible="{Binding HasRecentProjects}" />
            </Grid>

            <Panel Grid.Row="1">
              <ScrollViewer IsVisible="{Binding HasRecentProjects}"
                            IsEnabled="{Binding CanStartProjectAction}"
                            Padding="8,4"
                            VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding RecentProjects}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RecentProjectItemViewModel}">
                      <!-- 一行 = 一条清单项：无边框盒，hover 时整行染色（recent-row 样式） -->
                      <Grid Classes="recent-row" ColumnDefinitions="*,Auto">
                        <Button Grid.Column="0"
                                Classes="welcome-recent-item"
                                Command="{Binding OpenCommand}"
                                Padding="13,11"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                    Classes="recent-identity"
                                    Classes.unavailable="{Binding IsUnavailable}"
                                    Background="{DynamicResource Ariadne.AccentLight}"
                                    VerticalAlignment="Center">
                              <Path Classes="icon" Width="16" Height="16"
                                    Stroke="{DynamicResource Ariadne.AccentPrimary}"
                                    Data="M5,4 L14,4 L19,9 L19,20 L5,20 Z M14,4 L14,9 L19,9 M8,13 L16,13 M8,16 L14,16" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                              <!-- 置灰只作用在「标题+路径+时间」上，失效原因那行保持满不透明——
                                   把解释文字一起调淡，等于把唯一的补救线索也藏起来。 -->
                              <StackPanel Classes="recent-identity" Spacing="3"
                                          Classes.unavailable="{Binding IsUnavailable}">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ProjectRoot}" Classes="mono" FontSize="11"
                                           Opacity="0.8" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding LastOpenedText}"
                                           Classes="caption"
                                           FontSize="11"
                                           IsVisible="{Binding HasLastOpened}" />
                              </StackPanel>
                              <!-- 失效原因：目录不存在 / 目录在但不是项目。
                                   用警示色而非仅置灰——置灰只说明「不可用」，
                                   说不出为什么，也就指不出该走哪条出路。 -->
                              <StackPanel Orientation="Horizontal" Spacing="5"
                                          IsVisible="{Binding HasUnavailableText}">
                                <Path Classes="icon" Width="12" Height="12"
                                      VerticalAlignment="Center"
                                      Stroke="{DynamicResource Ariadne.StatusWarning}"
                                      Data="M12,3 L22,20 L2,20 Z M12,9 L12,14 M12,17 L12,17.5" />
                                <TextBlock Text="{Binding UnavailableText}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Ariadne.StatusWarning}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding UnavailableHint}"
                                           Classes="caption" FontSize="11" Opacity="0.75"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </StackPanel>
                            <Path Grid.Column="2" Classes="icon" Width="14" Height="14"
                                  Opacity="0.45" VerticalAlignment="Center"
                                  Data="{StaticResource Ariadne.Icon.ChevronRight}" />
                          </Grid>
                        </Button>
                        <Button Grid.Column="1"
                                Classes="subtle"
                                Width="36"
                                MinWidth="36"
                                Margin="0,8,8,8"
                                Content="⋯"
                                ToolTip.Tip="{Binding #Root.DataContext.RecentProjectActionsText}"
                                AutomationProperties.Name="{Binding #Root.DataContext.RecentProjectActionsText}">
                          <Button.Flyout>
                            <MenuFlyout>
                              <MenuItem Header="{Binding #Root.DataContext.RelocateRecentProjectText}"
                                        Command="{Binding RelocateCommand}" />
                              <MenuItem Header="{Binding #Root.DataContext.ForgetRecentProjectText}"
                                        Command="{Binding ForgetCommand}"
                                        Classes="danger" />
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <Border Classes="empty-state" IsVisible="{Binding IsRecentLoading}" Padding="28,48">
                <TextBlock Text="{Binding RecentLoadingText}" Classes="secondary"
                           HorizontalAlignment="Center" TextAlignment="Center" />
              </Border>

              <Border Classes="empty-state" IsVisible="{Binding IsRecentError}" Padding="28,40">
                <StackPanel Spacing="10" HorizontalAlignment="Center" MaxWidth="300">
                  <TextBlock Text="{Binding RecentErrorText}" Classes="secondary"
                             HorizontalAlignment="Center" TextAlignment="Center"
                             TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                  <Button Classes="secondary"
                          Content="{Binding RetryRecentProjectsText}"
                          Command="{Binding RetryRecentProjectsCommand}"
                          HorizontalAlignment="Center" />
                </StackPanel>
              </Border>

              <Border Classes="empty-state" IsVisible="{Binding IsRecentEmpty}" Padding="28,44">
                <StackPanel Spacing="10" HorizontalAlignment="Center" MaxWidth="280">
                  <ctl:EmptyStateArt Kind="WelcomeQuill" Width="200" Height="90" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding EmptyRecentTitle}" Classes="subtitle"
                             HorizontalAlignment="Center" TextAlignment="Center" />
                  <TextBlock Text="{Binding EmptyRecentHint}" Classes="caption"
                             HorizontalAlignment="Center" TextAlignment="Center"
                             TextWrapping="Wrap" LineHeight="20" />
                </StackPanel>
              </Border>
            </Panel>
          </Grid>
        </Border>
      </Grid>
    </ScrollViewer>
  </Panel>
</UserControl>
