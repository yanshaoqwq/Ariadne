<UserControl
    x:Class="Ariadne.Desktop.Views.WorksPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
    xmlns:ctl="clr-namespace:Ariadne.Desktop.Controls"
    xmlns:vm="clr-namespace:Ariadne.Desktop.ViewModels"
    x:DataType="vm:WorksPageViewModel"
    KeyDown="OnWorksPageKeyDown">
  <UserControl.Styles>
    <Style Selector="Border.works-tree-node">
      <Setter Property="Padding" Value="7,5" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.works-tree-node.current">
      <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundHover}" />
    </Style>
  </UserControl.Styles>
  <!-- 作品页：中阅读/修改器 + 右栏（顶部标签切换 导航树/项目 AI，可收起）。无左栏。 -->
  <Grid Background="Transparent">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="{Binding RightPanelSplitterWidth}" />
      <ColumnDefinition Width="{Binding RightPanelColumnWidth, Mode=TwoWay}" MinWidth="0" MaxWidth="520" />
    </Grid.ColumnDefinitions>

    <!-- ============ 中：阅读/修改器 ============ -->
    <Panel Grid.Column="0">
      <DockPanel>
      <!-- 顶部工具条 -->
      <Border DockPanel.Dock="Top" Classes="page-header" Padding="18,10" MinHeight="58">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <Border Grid.Column="0" Classes="page-header-mark" MinHeight="30" />
          <!-- 顶栏这里降级为「面包屑」：正文标题已由稿纸刊头以大号衬线呈现，
               同一字符串再用 subtitle 渲染一遍会变成两个同级标题打架。
               降到 secondary 后它只负责「当前在读哪一篇」的定位（滚动后仍可见），
               空态下也照样承担「未选择文档」提示。 -->
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentDocumentText}" Classes="secondary"
                       FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Text="{Binding DocumentSaveStateText}" Classes="subtle" IsVisible="{Binding HasCurrentDocument}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
            <Border Classes="segmented-control">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="segment-button" ctl:SelectedClass.IsSelected="{Binding !IsEditMode}" Content="{Binding ReadModeText}" Command="{Binding ReadModeCommand}" />
                <Button Classes="segment-button" ctl:SelectedClass.IsSelected="{Binding IsEditMode}" Content="{Binding EditModeText}" Command="{Binding EditModeCommand}" />
              </StackPanel>
            </Border>
            <ComboBox ItemsSource="{Binding ExportFormats}"
                      SelectedValue="{Binding ExportFormat, Mode=TwoWay}"
                      SelectedValueBinding="{Binding Value}"
                      MinWidth="112">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ExportFormatOption}">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Border Width="1" Margin="6,4" Background="{DynamicResource Ariadne.BorderMuted}" />
            <!-- 图标按钮：导入稿件 / 导出合并 / 保存 -->
            <Button Classes="icon-btn" ToolTip.Tip="{Binding ImportText}" AutomationProperties.Name="{Binding ImportText}" Command="{Binding OpenImportPanelCommand}">
              <Path Classes="icon" Data="{StaticResource Ariadne.Icon.Import}" />
            </Button>
            <Button Classes="icon-btn" ToolTip.Tip="{Binding ExportText}" AutomationProperties.Name="{Binding ExportText}" Command="{Binding ExportCommand}">
              <Path Classes="icon" Data="{StaticResource Ariadne.Icon.Export}" />
            </Button>
            <Button Classes="icon-btn save" ToolTip.Tip="{Binding SaveText}" AutomationProperties.Name="{Binding SaveText}" Command="{Binding SaveCommand}">
              <Path Classes="icon" Data="{StaticResource Ariadne.Icon.Save}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 正文阅读按块虚拟化；编辑由单一 TextDocument + 行虚拟化控件承载。 -->
      <Grid Background="{DynamicResource Ariadne.EditorBackground}">
        <Grid.ContextMenu>
          <ContextMenu Classes="ariadne">
            <MenuItem Header="{Binding CtxCopyText}" Command="{Binding CopyCommand}" />
            <MenuItem Header="{Binding CtxSelectAllText}" Command="{Binding SelectAllCommand}" />
            <Separator />
            <MenuItem Header="{Binding CtxQuickAiText}" Command="{Binding OpenQuickEditCommand}" />
            <MenuItem Header="{Binding CtxInsertOutlineText}" Command="{Binding InsertOutlineCommand}" />
            <Separator />
            <MenuItem Header="{Binding CtxToggleEditText}" Command="{Binding ToggleEditCommand}" />
          </ContextMenu>
        </Grid.ContextMenu>
        <Grid MaxWidth="1180" Margin="40,30,40,44" HorizontalAlignment="Stretch" RowDefinitions="Auto,*" RowSpacing="18">
          <!-- 作品树空：二次元打响指全幅空态，不露出编辑器壳 -->
          <Border Grid.Row="0" Grid.RowSpan="2" Classes="empty-state"
                  IsVisible="{Binding IsWorksTreeEmpty}"
                  VerticalAlignment="Center" HorizontalAlignment="Center"
                  Padding="40,48">
            <StackPanel Spacing="14" HorizontalAlignment="Center" MaxWidth="360">
              <ctl:EmptyStateArt Kind="WorksSnap" Width="160" Height="128" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding EmptyIndexTitle}" Classes="title" HorizontalAlignment="Center" TextAlignment="Center" />
              <TextBlock Text="{Binding EmptyIndexHint}" Classes="caption" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
              <TextBlock Text="{Binding EmptyIndexText}" Classes="subtle" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
              <Button Classes="primary" HorizontalAlignment="Center" Margin="0,8,0,0"
                      Content="{Binding ImportText}" Command="{Binding OpenImportPanelCommand}" />
            </StackPanel>
          </Border>

          <Border Grid.Row="0" Grid.RowSpan="2" Classes="empty-state"
                  IsVisible="{Binding IsWorksTreeLoading}"
                  VerticalAlignment="Center" HorizontalAlignment="Center"
                  Padding="40,48">
            <TextBlock Text="{Binding WorksTreeLoadingText}" Classes="subtitle" TextAlignment="Center" />
          </Border>

          <Border Grid.Row="0" Grid.RowSpan="2" Classes="empty-state"
                  IsVisible="{Binding IsWorksTreeError}"
                  VerticalAlignment="Center" HorizontalAlignment="Center"
                  Padding="40,48">
            <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="420">
              <TextBlock Text="{Binding WorksTreeErrorText}" Classes="subtitle" TextWrapping="Wrap" TextAlignment="Center" />
              <Button Classes="primary" HorizontalAlignment="Center"
                      Content="{Binding RetryWorksTreeText}" Command="{Binding RetryWorksTreeCommand}" />
            </StackPanel>
          </Border>

          <Border Grid.Row="0" Grid.RowSpan="2" Classes="empty-state"
                  IsVisible="{Binding IsDocumentLoading}"
                  VerticalAlignment="Center" HorizontalAlignment="Center"
                  Padding="40,48">
            <TextBlock Text="{Binding DocumentLoadingTargetText}" Classes="subtitle" TextWrapping="Wrap" TextAlignment="Center" />
          </Border>

          <!-- 有索引但未选文档：单一空态，不重复「未选择」与文档壳（U72） -->
          <Border Grid.Row="0" Grid.RowSpan="2" Classes="empty-state"
                  IsVisible="{Binding ShowNoDocumentEmpty}"
                  VerticalAlignment="Center" HorizontalAlignment="Center"
                  Padding="40,48">
            <StackPanel Spacing="10" HorizontalAlignment="Center" MaxWidth="360">
              <ctl:EmptyStateArt Kind="WorksSnap" Width="140" Height="112" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding NoDocumentText}" Classes="subtitle" HorizontalAlignment="Center" TextAlignment="Center" />
              <TextBlock Text="{Binding EmptyIndexHint}" Classes="caption" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- 一张稿纸：原先「标题卡 + 正文卡」是两张分离的圆角卡（且标题与顶栏
               CurrentDocumentText 重复渲染）。现在合成单张纸——刊头在纸上方，
               一道发丝横线分隔，正文衬线排版，纸缘一层柔投影。像真正的书页。 -->
          <Border Grid.Row="0" Grid.RowSpan="2"
                  Classes="document-surface"
                  Padding="72,56,72,52"
                  IsVisible="{Binding ShowDocumentChrome}">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0" MinHeight="640">
              <!-- 刊头：章节名 + 元信息，底部发丝线收口 -->
              <StackPanel Grid.Row="0" Spacing="7" Margin="0,0,0,34">
                <TextBlock Text="{Binding DocumentTitle}"
                           Classes="reading"
                           FontSize="27"
                           LineHeight="38"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Ariadne.TextHeading}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                  <TextBlock Grid.Column="0" Text="{Binding DocumentInfoText}" Classes="caption" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Text="{Binding CharacterCountText}" Classes="caption" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding StatusText}" Classes="subtle" TextWrapping="Wrap" />
                <!-- 刊头分隔：中间实、两端淡出的渐变细线，比一条硬直线雅致 -->
                <Border Height="1" Margin="0,9,0,0">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                      <GradientStop Offset="0" Color="{DynamicResource Ariadne.Color.AccentPrimary}" />
                      <GradientStop Offset="0.14" Color="{DynamicResource Ariadne.Color.BorderDefault}" />
                      <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
              </StackPanel>
              <TextBlock Grid.Row="1"
                         Text="{Binding DocumentBodyText}"
                         Classes="reading"
                         IsVisible="{Binding ShowReadModeEmptyDocument}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
              <ItemsControl Grid.Row="1"
                            ItemsSource="{Binding DocumentBlocks}"
                            IsVisible="{Binding !IsEditMode}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:DocumentBlockViewModel}">
                    <SelectableTextBlock Text="{Binding Text}"
                                         Classes="reading"
                                         Margin="0,0,0,18" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ae:TextEditor x:Name="DocumentEditor"
                             Grid.Row="1"
                             Document="{Binding EditorDocument}"
                             IsVisible="{Binding IsEditMode}"
                             IsReadOnly="False"
                             WordWrap="True"
                             ShowLineNumbers="False"
                             HorizontalScrollBarVisibility="Disabled"
                             VerticalScrollBarVisibility="Auto"
                             KeyDown="OnDocumentEditorKeyDown"
                             KeyUp="OnDocumentEditorKeyUp"
                             GotFocus="OnDocumentEditorGotFocus"
                             LostFocus="OnDocumentEditorLostFocus"
                             PointerReleased="OnDocumentEditorPointerReleased"
                             AutomationProperties.Name="{Binding DocumentTitle}"
                             Background="Transparent"
                             Foreground="{DynamicResource Ariadne.TextPrimary}"
                             FontFamily="{DynamicResource Ariadne.Font.Reading}"
                             FontSize="16" />
              <!-- 快速编辑：去掉纸上又贴一张卡（card-in-card），
                   改为纸面下缘的一道工作区——顶部发丝线分隔即可。 -->
              <Border Grid.Row="2"
                      BorderBrush="{DynamicResource Ariadne.BorderMuted}"
                      BorderThickness="0,1,0,0"
                      Margin="0,28,0,0"
                      Padding="0,20,0,0"
                      IsVisible="{Binding IsEditMode}">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Grid.Column="0" Text="{Binding QuickEditTitle}" Classes="subtitle" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="secondary" Content="{Binding QuickEditGenerateText}" Command="{Binding QuickAiCommand}" />
                  </Grid>
                  <TextBox x:Name="QuickEditInstructionBox" AutomationProperties.Name="{Binding QuickEditTitle}"
                           Text="{Binding QuickEditInstruction, Mode=TwoWay}"
                           PlaceholderText="{Binding QuickEditPlaceholder}" />
                  <TextBlock Text="{Binding QuickEditDiffText}" Classes="caption" />
                  <TextBox Text="{Binding QuickEditDiff}" AutomationProperties.Name="{Binding QuickEditDiffText}"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           MinHeight="110"
                           MaxHeight="280"
                           IsReadOnly="True" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Classes="secondary" Content="{Binding QuickEditUndoText}" Command="{Binding UndoQuickEditCommand}" />
                    <Button Classes="primary" Content="{Binding QuickEditApplyText}" Command="{Binding ApplyQuickEditCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </Grid>
      </DockPanel>
      <ctl:RightPanelTogglePill IsPanelOpen="{Binding IsRightPanelOpen}"
                                ToggleCommand="{Binding ToggleRightPanelCommand}"
                                AccessibleName="{Binding ToggleRightPanelText}"
                                IsVisible="{Binding IsRightPanelToggleVisible}" />
    </Panel>

    <!-- ============ 右：导航树 / 项目 AI（右上标签切换，可收起） ============ -->
    <GridSplitter Grid.Column="1"
                  Width="4"
                  Background="{DynamicResource Ariadne.BorderMuted}"
                  ResizeDirection="Columns"
                  IsVisible="{Binding IsRightPanelVisible}" />

    <Panel Grid.Column="2">
      <Border
          Background="{DynamicResource Ariadne.BackgroundSurface}"
          BorderBrush="{DynamicResource Ariadne.BorderMuted}"
          BorderThickness="1,0,0,0"
          IsVisible="{Binding IsRightPanelVisible}">
      <DockPanel>
        <!-- 右上标签切换：原为「填色条 → 描边分段控件 → 按钮」三层套盒。
             改为 Win11 pivot（底部下划线），与工作空间检查器同一语汇。 -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource Ariadne.BorderMuted}"
                BorderThickness="0,0,0,1"
                Padding="10,8,10,0">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="2">
            <Button Grid.Column="0" Classes="inspector-tab" ctl:SelectedClass.IsSelected="{Binding IsNavTreeTab}"
                    Content="{Binding NavTreeText}" Command="{Binding ShowNavTreeCommand}" />
            <Button Grid.Column="1" Classes="inspector-tab" ctl:SelectedClass.IsSelected="{Binding IsProjectAiTab}"
                    Content="{Binding ProjectAiText}" Command="{Binding ShowProjectAiCommand}" />
          </Grid>
        </Border>

        <!-- 标签内容区：Grid 叠层（天然 Stretch），隐藏的标签不占空间 -->
        <Grid>
          <!-- 标签内容 1：导航树（章节树 + 大纲入口）-->
          <DockPanel IsVisible="{Binding IsNavTreeTab}">
            <!-- 原为无任何视觉属性的空 Border（纯 padding 壳），改回 StackPanel + Margin -->
            <StackPanel DockPanel.Dock="Top" Margin="10,10,10,4" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="subtle" Padding="10,6" ToolTip.Tip="{Binding OutlineText}" AutomationProperties.Name="{Binding OutlineText}" Command="{Binding InsertOutlineCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <Path Classes="icon" Width="15" Height="15"
                            Data="M5,4 L14,4 L19,9 L19,20 L5,20 Z M14,4 L14,9 L19,9 M8,13 L16,13 M8,16 L14,16" />
                      <TextBlock Text="{Binding OutlineText}" Classes="caption" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Classes="subtle" Padding="10,6" Content="{Binding ImportText}" Command="{Binding ToggleImportPanelCommand}" />
                </StackPanel>
                <!-- 导入表单：去掉描边盒，改为左缘强调脊的「展开工作区」 -->
                <Border Classes="detail-row accent"
                        Margin="0,4,0,2"
                        Padding="13,3,0,3"
                        IsVisible="{Binding IsImportPanelOpen}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding ImportTitle}" Classes="subtitle" />
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding ImportChapterIdText}" Classes="caption" />
                      <TextBox Text="{Binding ImportChapterId, Mode=TwoWay}"
                               AutomationProperties.Name="{Binding ImportChapterIdText}" />
                      <TextBlock Text="{Binding ImportChapterIdErrorText}"
                                 Classes="caption"
                                 Foreground="{DynamicResource Ariadne.StatusError}"
                                 IsVisible="{Binding HasImportChapterIdError}" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding ImportChapterTitleText}" Classes="caption" />
                      <TextBox Text="{Binding ImportChapterTitle, Mode=TwoWay}"
                               AutomationProperties.Name="{Binding ImportChapterTitleText}" />
                      <TextBlock Text="{Binding ImportChapterTitleErrorText}"
                                 Classes="caption"
                                 Foreground="{DynamicResource Ariadne.StatusError}"
                                 IsVisible="{Binding HasImportChapterTitleError}" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding ImportOrderText}" Classes="caption" />
                      <NumericUpDown Value="{Binding ImportOrder, Mode=TwoWay}"
                                     Minimum="0"
                                     Maximum="9223372036854775807"
                                     Increment="1"
                                     FormatString="0"
                                     AutomationProperties.Name="{Binding ImportOrderText}" />
                      <TextBlock Text="{Binding ImportOrderErrorText}"
                                 Classes="caption"
                                 Foreground="{DynamicResource Ariadne.StatusError}"
                                 IsVisible="{Binding HasImportOrderError}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ImportSourceGroupText}" Classes="inspector-label" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding ImportSourcePathText}" Classes="caption" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBox Grid.Column="0"
                               Text="{Binding ImportSourcePath, Mode=TwoWay}"
                               PlaceholderText="{Binding ImportSourcePlaceholder}"
                               AutomationProperties.Name="{Binding ImportSourcePathText}" />
                      <Button Grid.Column="1" Classes="secondary" Content="{Binding BrowseImportSourceText}" Command="{Binding BrowseImportSourceCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding ImportSourceErrorText}"
                               Classes="caption"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Ariadne.StatusError}"
                               IsVisible="{Binding HasImportSourceError}" />
                    <TextBlock Text="{Binding ImportTargetGroupText}" Classes="inspector-label" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding ImportTargetPathText}" Classes="caption" />
                    <TextBox Text="{Binding ImportTargetPath, Mode=TwoWay}"
                             PlaceholderText="{Binding ImportTargetPlaceholder}"
                             AutomationProperties.Name="{Binding ImportTargetPathText}" />
                    <TextBlock Text="{Binding ImportTargetErrorText}"
                               Classes="caption"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Ariadne.StatusError}"
                               IsVisible="{Binding HasImportTargetError}" />
                    <TextBlock Text="{Binding ImportTargetPreviewText}"
                               Classes="caption"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Ariadne.StatusInfo}"
                               IsVisible="{Binding HasImportTargetPreview}" />
                    <TextBlock Text="{Binding ImportConflictText}"
                               Classes="caption"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Ariadne.StatusWarning}"
                               IsVisible="{Binding HasImportConflict}" />
                    <CheckBox IsChecked="{Binding AllowImportOverwrite, Mode=TwoWay}"
                              Content="{Binding ImportOverwriteText}"
                              IsVisible="{Binding HasImportConflict}" />
                    <TextBlock Text="{Binding ImportConfirmationText}"
                               Classes="caption"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasImportConfirmation}" />
                    <Button Classes="primary" HorizontalAlignment="Right" Content="{Binding ImportText}" Command="{Binding ImportCommand}" />
                  </StackPanel>
                </Border>
            </StackPanel>
            <ScrollViewer Margin="8,4">
              <StackPanel Spacing="8">
                <!-- F19：正式总结投影。加载失败与合法空态分开，确认历史不混入正式知识。
                     去盒：外层 layer 盒 + 内部 4 个 soft-panel 盒（共 5 层描边）
                     统一改为标题 + 明细竖脊行，只靠留白与竖线分层。 -->
                <StackPanel Spacing="10" Margin="2,6,2,4" IsVisible="{Binding HasSummaryContext}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Grid.Column="0" Text="{Binding SummaryTitle}" Classes="inspector-label" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding SummaryChapterHeading}" Classes="subtle" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding SummaryLoadingText}"
                               Classes="caption"
                               IsVisible="{Binding IsSummaryLoading}" />
                    <!-- 错误：竖脊转错误色（色 + 位置双通道，不只靠颜色） -->
                    <Border Classes="detail-row"
                            BorderBrush="{DynamicResource Ariadne.StatusError}"
                            IsVisible="{Binding HasSummaryError}">
                      <TextBlock Text="{Binding SummaryErrorText}" Classes="caption" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="{Binding SummaryEmptyText}"
                               Classes="caption"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ShowSummaryEmpty}" />

                    <StackPanel Spacing="2" IsVisible="{Binding ShowSummaryContent}">
                      <Border Classes="detail-row" IsVisible="{Binding HasActiveSummarySegment}">
                        <TextBlock Text="{Binding ActiveSummarySegmentText}" Classes="caption" TextWrapping="Wrap" />
                      </Border>

                      <Border Classes="detail-row accent" IsVisible="{Binding HasChapterSummary}">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding ChapterSummaryLabel}" Classes="caption" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding ChapterSummaryText}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>

                      <Border Classes="detail-row accent" IsVisible="{Binding HasStageSummary}">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding StageSummaryLabel}" Classes="caption" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding SummaryStageHeading}" Classes="subtle" />
                          <TextBlock Text="{Binding StageSummaryText}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>

                      <Expander Header="{Binding SummarySegmentsLabel}"
                                IsExpanded="True"
                                IsVisible="{Binding HasSummarySegments}">
                        <ItemsControl ItemsSource="{Binding SummarySegments}" Margin="0,6,0,0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WorksSummarySegmentItemViewModel}">
                              <Button Classes="nav"
                                      ctl:SelectedClass.IsSelected="{Binding IsSelected}"
                                      Command="{Binding RevealCommand}"
                                      ToolTip.Tip="{Binding RevealText}"
                                      AutomationProperties.Name="{Binding RevealText}"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Margin="0,0,0,4">
                                <StackPanel Spacing="3">
                                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" Classes="caption" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding SourceStateText}" Classes="subtle" />
                                  </Grid>
                                  <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                  <TextBlock Text="{Binding SourceText}" Classes="subtle" TextWrapping="Wrap" />
                                </StackPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Expander>

                      <Expander Header="{Binding SummaryEventsLabel}"
                                IsExpanded="True"
                                IsVisible="{Binding HasSummaryEvents}">
                        <ItemsControl ItemsSource="{Binding SummaryEvents}" Margin="0,6,0,0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WorksSummaryDetailItemViewModel}">
                              <Border Classes="detail-row">
                                <StackPanel Spacing="3">
                                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" Classes="caption" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Classes="subtle" />
                                  </Grid>
                                  <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Expander>

                      <Expander Header="{Binding SummaryChangesLabel}"
                                IsExpanded="True"
                                IsVisible="{Binding HasSummaryChanges}">
                        <ItemsControl ItemsSource="{Binding SummaryChanges}" Margin="0,6,0,0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WorksSummaryDetailItemViewModel}">
                              <Border Classes="detail-row">
                                <StackPanel Spacing="3">
                                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" Classes="caption" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Classes="subtle" />
                                  </Grid>
                                  <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Expander>

                      <Expander Header="{Binding SummaryForeshadowingLabel}"
                                IsExpanded="True"
                                IsVisible="{Binding HasSummaryForeshadowing}">
                        <ItemsControl ItemsSource="{Binding SummaryForeshadowing}" Margin="0,6,0,0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WorksSummaryDetailItemViewModel}">
                              <Border Classes="detail-row">
                                <StackPanel Spacing="3">
                                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" Classes="caption" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Classes="subtle" />
                                  </Grid>
                                  <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Expander>

                      <Expander Header="{Binding SummaryConfirmationsLabel}"
                                IsExpanded="False"
                                IsVisible="{Binding HasSummaryConfirmations}">
                        <ItemsControl ItemsSource="{Binding SummaryConfirmations}" Margin="0,6,0,0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WorksSummaryDetailItemViewModel}">
                              <Border Classes="detail-row">
                                <StackPanel Spacing="3">
                                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" Classes="caption" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Classes="subtle" />
                                  </Grid>
                                  <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Expander>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="8" IsVisible="{Binding IsWorksTreeContent}">
                  <!-- 搜索：原为 soft-panel 盒里再套一个自带边框的 TextBox（双层描边）。
                       改用与其他页一致的一体搜索壳，图标内嵌、只有一层边。 -->
                  <Border Classes="search-shell">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="2">
                      <Path Grid.Column="0"
                            Classes="icon"
                            Width="14"
                            Height="14"
                            Margin="9,0,0,0"
                            Opacity="0.55"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Data="{StaticResource Ariadne.Icon.Search}" />
                      <TextBox Grid.Column="1"
                               Classes="search-input"
                               Text="{Binding WorksTreeSearchText, Mode=TwoWay}"
                               PlaceholderText="{Binding WorksTreeSearchPlaceholder}"
                               AutomationProperties.Name="{Binding WorksTreeSearchName}" />
                    </Grid>
                  </Border>
                  <TreeView ItemsSource="{Binding VisibleWorksTreeRoots}"
                            SelectedItem="{Binding SelectedWorksTreeNode, Mode=TwoWay}"
                            SelectionMode="Single"
                            AutoScrollToSelectedItem="True"
                            Background="Transparent"
                            BorderThickness="0"
                            AutomationProperties.Name="{Binding NavTreeText}">
                    <TreeView.Styles>
                      <Style Selector="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                      </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                      <TreeDataTemplate DataType="{x:Type vm:WorksTreeItemViewModel}"
                                        ItemsSource="{Binding VisibleChildren}">
                        <Border Classes="works-tree-node"
                                Classes.current="{Binding IsCurrentDocument}"
                                ToolTip.Tip="{Binding DisplayPath}"
                                AutomationProperties.Name="{Binding AccessibleName}">
                          <Grid ColumnDefinitions="3,Auto,*,Auto" ColumnSpacing="7">
                            <Border Grid.Column="0"
                                    Width="3"
                                    CornerRadius="2"
                                    Background="{DynamicResource Ariadne.AccentPrimary}"
                                    IsVisible="{Binding IsCurrentDocument}" />
                            <Panel Grid.Column="1" Width="15" Height="15" VerticalAlignment="Center">
                              <Path Classes="icon" IsVisible="{Binding IsGlobalOutline}"
                                    Data="{StaticResource Ariadne.Icon.Workspace}" />
                              <Path Classes="icon" IsVisible="{Binding IsStageOutline}"
                                    Data="{StaticResource Ariadne.Icon.Templates}" />
                              <Path Classes="icon" IsVisible="{Binding IsChapter}"
                                    Data="{StaticResource Ariadne.Icon.Works}" />
                            </Panel>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Title}"
                                       Classes="caption"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding KindLabel}"
                                       Classes="subtle"
                                       VerticalAlignment="Center" />
                          </Grid>
                        </Border>
                      </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                  </TreeView>
                  <TextBlock Text="{Binding WorksTreeSearchEmptyText}"
                             Classes="caption"
                             TextWrapping="Wrap"
                             IsVisible="{Binding ShowWorksTreeSearchEmpty}" />
                </StackPanel>
                <TextBlock Text="{Binding WorksTreeLoadingText}" Classes="caption"
                           IsVisible="{Binding IsWorksTreeLoading}" TextWrapping="Wrap" />
                <Border Classes="soft-panel" Padding="10" IsVisible="{Binding IsWorksTreeError}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding WorksTreeErrorText}" Classes="caption" TextWrapping="Wrap" />
                    <Button Classes="secondary" Content="{Binding RetryWorksTreeText}" Command="{Binding RetryWorksTreeCommand}" />
                  </StackPanel>
                </Border>
                <!-- 侧栏索引空：主栏已有打响指全幅空态，此处只保留短提示 -->
                <Border Classes="empty-state" Padding="12,16" IsVisible="{Binding IsWorksTreeEmpty}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding EmptyIndexTitle}" Classes="subtitle" />
                    <TextBlock Text="{Binding EmptyIndexHint}" Classes="caption" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>

          <!-- 标签内容 2：项目 AI -->
          <Grid IsVisible="{Binding IsProjectAiTab}" RowDefinitions="*,Auto" HorizontalAlignment="Stretch">
            <ScrollViewer Grid.Row="0" Margin="12,8">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding ProjectAiAnswer}"
                           Classes="subtle"
                           TextWrapping="Wrap"
                           IsVisible="{Binding !HasProjectAiBubbles}" />
                <ItemsControl ItemsSource="{Binding ProjectAiBubbles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ChatBubbleViewModel}">
                      <Border Background="{Binding BubbleBackground}"
                              BorderBrush="{DynamicResource Ariadne.BorderMuted}"
                              BorderThickness="1"
                              CornerRadius="10"
                              Padding="12,8"
                              HorizontalAlignment="{Binding HorizontalAlignment}"
                              MaxWidth="320"
                              Margin="0,0,0,6">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding RoleLabel}" Classes="subtle" FontSize="11" />
                          <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="13" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Padding="12,10"
                    HorizontalAlignment="Stretch"
                    BorderBrush="{DynamicResource Ariadne.BorderMuted}" BorderThickness="0,1,0,0">
              <!-- 与工作区共用 ProjectAiComposer；输入面始终跟随实际对话栏宽度。 -->
              <ctl:ProjectAiComposer HorizontalAlignment="Stretch" />
            </Border>
          </Grid>
        </Grid>
      </DockPanel>
      </Border>

    </Panel>
  </Grid>
</UserControl>
