<UserControl
    x:Class="Ariadne.Desktop.Views.RunLogPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Ariadne.Desktop.Controls"
    xmlns:vm="clr-namespace:Ariadne.Desktop.ViewModels"
    x:DataType="vm:RunLogPageViewModel">
  <!-- 根容器透明：让 MainWindow 底层的径向光晕透上来 -->
  <Grid RowDefinitions="Auto,Auto,*" Background="Transparent">

    <Border Grid.Row="0"
            Classes="page-header">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <Border Grid.Column="0" Classes="page-header-mark" />
        <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="title" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <!-- U185-A：顶栏状态 chip。点直径收到 4px：chip 内距只有 10,3，
               默认 5px 会顶到胶囊上下边缘、读作「挤出来了」。 -->
          <Border Classes="chip" IsVisible="{Binding IsLoading}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding LoadingText}" Classes="caption" VerticalAlignment="Center" />
              <ctl:BusyDots IsActive="{Binding IsLoading}" DotDiameter="4" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Button Classes="secondary btn-compact"
                  Content="{Binding CopySelectedText}"
                  VerticalAlignment="Center"
                  Command="{Binding CopySelectedCommand}" />
          <Button Classes="secondary btn-compact"
                  Content="{Binding RefreshText}"
                  VerticalAlignment="Center"
                  Command="{Binding RefreshCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="command-strip">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
          <!-- 一体搜索壳：与模板市场同一 chrome，避免裸 TextBox + 孤立主色方钮 -->
          <Border Grid.Column="0"
                  Classes="search-shell"
                  MaxWidth="440"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Grid.Column="0"
                    Classes="icon"
                    Width="14"
                    Height="14"
                    Margin="8,0,0,0"
                    Opacity="0.55"
                    Data="{StaticResource Ariadne.Icon.Search}"
                    IsHitTestVisible="False" />
              <TextBox Grid.Column="1"
                       Classes="search-input"
                       Text="{Binding SearchQuery, Mode=TwoWay}"
                       PlaceholderText="{Binding SearchPlaceholder}"
                       AutomationProperties.Name="{Binding SearchPlaceholder}"
                       KeyDown="OnSearchKeyDown" />
              <Button Grid.Column="2"
                      Classes="search-submit"
                      Width="34"
                      Height="30"
                      Command="{Binding SearchCommand}"
                      ToolTip.Tip="{Binding SearchText}"
                      AutomationProperties.Name="{Binding SearchText}">
                <Path Classes="icon" Data="{StaticResource Ariadne.Icon.Search}" />
              </Button>
            </Grid>
          </Border>
          <ComboBox Grid.Column="1"
                    ItemsSource="{Binding LevelOptions}"
                    SelectedValue="{Binding SelectedLevel, Mode=TwoWay}"
                    SelectedValueBinding="{Binding Value}"
                    MinWidth="108"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding AllLevelsText}">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:RunLogLevelOption}">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox Grid.Column="2"
                    ItemsSource="{Binding KindOptions}"
                    SelectedValue="{Binding SelectedKind, Mode=TwoWay}"
                    SelectedValueBinding="{Binding Value}"
                    MinWidth="108"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding KindFilterText}">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:RunLogKindOption}">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <!-- U137：原来这里是三个自由文本框（工作流 ID / 运行 ID / 节点 ID），
             后端对它们是**精确等值**匹配，用户只能肉眼抄 UUID 再手敲，
             差一个字符就是空结果、且不给任何提示。现在改为：
             筛选来源只有"点明细里的 ID"，生效项以可移除 chip 呈现。
             工作流 ID 框一并删掉——桌面端 2026-07-20 起固定单画布约束，
             它恒为 "default"，永远只有一个可能值。 -->
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
          <ItemsControl Grid.Column="0"
                        ItemsSource="{Binding ActiveIdFilters}"
                        IsVisible="{Binding HasActiveIdFilters}"
                        VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:RunLogContextChipViewModel}">
                <!-- 生效的筛选 chip：点它=移除。带一个 × 让"可移除"这件事不用猜。 -->
                <Button Classes="chip-filter"
                        Margin="0,0,6,0"
                        Command="{Binding Command}"
                        AutomationProperties.Name="{Binding Label}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Label}" Classes="caption" VerticalAlignment="Center" />
                    <Path Classes="icon" Width="9" Height="9"
                          Data="{StaticResource Ariadne.Icon.Close}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- U205-F：原先这个键挂 `IsVisible="{Binding HasActiveFilter}"`，
               于是筛选一生效/一清空它就出现/消失，**把右边的「标记已读」横向推走**
               —— 与 `UI组件状态表.md:11`「不得改变布局尺寸」的约定冲突，
               且作者刚点完「清除筛选」，手还在原位时下一颗键已经挪到那儿了。
               改成**常驻 + 自动禁用**：`ClearFiltersCommand` 的 CanExecute 本来
               就是 HasActiveFilter（`RunLogPageViewModel.cs:64`，且已接
               NotifyCanExecuteChanged）⇒ 无筛选时它自己灰掉，宽度照占。
               **不用 Opacity=0 占位**：那会留下一个看不见但占着位置的东西，
               作者永远不知道「清除筛选」这个功能存在；灰键 + ToolTip 讲明
               启用条件是本项目已定的做法（画布审批历史键同款）。 -->
          <Button Grid.Column="1"
                  Classes="subtle"
                  Content="{Binding ClearFiltersText}"
                  Command="{Binding ClearFiltersCommand}"
                  ToolTip.Tip="{Binding ClearFiltersHintText}"
                  AutomationProperties.HelpText="{Binding ClearFiltersHintText}" />
          <!-- U205-A：「清除筛选」作用于筛选条件，「标记已读」改的是记录状态
               （且它不可撤销）—— 两类动作原先只隔 8px 等距。 -->
          <Border Grid.Column="2" Classes="group-divider" />
          <Button Grid.Column="3"
                  Classes="secondary"
                  Content="{Binding MarkReadText}"
                  Command="{Binding MarkReadCommand}" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- 外层不再统一内缩：日志流要铺满，只有文字类元素自己带页边距 -->
    <Grid Grid.Row="2" Margin="0,14,0,0" RowDefinitions="Auto,*,Auto">
      <!-- U185-A：日志流顶部的加载行。⚠️ 这里**必须保留外层 StackPanel 的
           Grid.Row 与 Margin**——原先 Margin="24,0,20,0" 是这一行独有的页边距
           （外层刻意不统一内缩，见上方注释），挪到内层文字上会让呼吸点贴到左边缘。 -->
      <StackPanel Grid.Row="0"
                  Orientation="Horizontal" Spacing="8"
                  Margin="24,0,20,0"
                  IsVisible="{Binding IsLoading}">
        <TextBlock Text="{Binding LoadingText}"
                   Classes="caption"
                   VerticalAlignment="Center" />
        <ctl:BusyDots IsActive="{Binding IsLoading}" VerticalAlignment="Center" />
      </StackPanel>

      <Border Grid.Row="1"
              Classes="empty-state"
              IsVisible="{Binding IsStandaloneError}"
              Margin="0,24,0,0">
        <StackPanel Spacing="8" HorizontalAlignment="Center" MaxWidth="420">
          <TextBlock Text="{Binding ErrorTitle}" Classes="empty-title" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding ErrorText}"
                     Classes="secondary"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextWrapping="Wrap" />
          <!-- U198-B：整页错误态**也**要有补救行。
               这一份不是「顺手再加一处」——下方那份渲染位挂在
               `IsVisible="{Binding ShowContent}"` 里，而 `ShowContent` 要求
               `HasLogs`（`RunLogPageViewModel.cs:117`）⇒ **一条日志都还没有时
               加载失败，走的正是这个整页错误态，下方那份建议根本不参与渲染**。
               而「一条日志都还没有」恰好就是作者第一次点运行失败时的状态，
               也就是 U198-B 要救的那个人。
               「属性接好了」不等于「作者看得见」：接线只保证有值，
               能不能到眼前取决于渲染位所在容器在**那个失败态下**是否可见。 -->
          <TextBlock Text="{Binding RecoveryText}"
                     Classes="caption"
                     Foreground="{DynamicResource Ariadne.StatusWarning}"
                     IsVisible="{Binding HasRecoveryText}"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite" />
          <Button Classes="secondary"
                  Content="{Binding RefreshText}"
                  Command="{Binding RefreshCommand}"
                  HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" IsVisible="{Binding ShowContent}">
        <Border Grid.Row="0"
                Classes="layer"
                BorderBrush="{DynamicResource Ariadne.StatusError}"
                BorderThickness="{DynamicResource Ariadne.Stroke.HairlineAll}"
                Padding="12,8"
                Margin="24,0,20,8"
                IsVisible="{Binding IsContentError}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding ErrorText}" Classes="secondary" TextWrapping="Wrap" />
            <Button Classes="secondary"
                    Content="{Binding RefreshText}"
                    Command="{Binding RefreshCommand}" />
          </StackPanel>
        </Border>
        <StackPanel Grid.Row="1" Spacing="3" Margin="24,0,20,8">
          <TextBlock Text="{Binding StatusText}"
                     Classes="caption"
                     Opacity="0.9" />
          <!-- U198-B：失败补救行。放在状态行下方、日志流上方，作者读完「怎么了」
               紧接着就是「下一步做什么」；没有建议时整条不占版面。 -->
          <TextBlock Text="{Binding RecoveryText}"
                     Classes="caption"
                     Foreground="{DynamicResource Ariadne.StatusWarning}"
                     IsVisible="{Binding HasRecoveryText}"
                     TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <!-- 去 card：日志流铺满，不套圆角描边盒子；行间发丝线已足够分层。 -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Logs}"
                 SelectedItem="{Binding SelectedLog, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 SelectionMode="Single">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0" />
              <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style Selector="Border.log-row.unread">
              <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentPrimary}" />
              <Setter Property="BorderThickness" Value="3,0,0,1" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:RunLogItemViewModel}">
              <Border Classes="stream-row log-row"
                      Classes.unread="{Binding IsUnread}"
                      Padding="24,12,20,12">
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="10" RowSpacing="6">
                  <TextBlock Grid.Row="0" Grid.Column="0"
                             Text="{Binding TimestampText}"
                             Classes="mono"
                             Width="142"
                             VerticalAlignment="Center"
                             Opacity="0.85" />
                  <Border Grid.Row="0" Grid.Column="1"
                          Classes="chip log-level"
                          Padding="8,2"
                          Classes.error="{Binding IsError}"
                          Classes.warning="{Binding IsWarning}"
                          Classes.info="{Binding IsInfo}">
                    <TextBlock Text="{Binding LevelText}" Classes="caption log-level-text" FontWeight="SemiBold" />
                  </Border>
                  <Border Grid.Row="0" Grid.Column="2" Classes="chip" Padding="8,2">
                    <TextBlock Text="{Binding KindText}" Classes="caption" />
                  </Border>
                  <TextBlock Grid.Row="0" Grid.Column="3"
                             Text="{Binding UnreadText}"
                             Classes="caption"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource Ariadne.AccentPrimary}"
                             HorizontalAlignment="Right"
                             IsVisible="{Binding IsUnread}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                             Text="{Binding Message}"
                             Classes="secondary"
                             TextWrapping="Wrap"
                             LineHeight="20" />
                  <!-- U137：ID 从纯 TextBlock 改为可点击 chip。此前用户唯一的
                       筛选路径是「肉眼记住 a3f9c2e1-… → 手敲进上面的框」，
                       而后端是精确等值匹配，差一个字符就是空结果。
                       点它即回填并重查——取值来自这条日志本身，敲错不可能发生。 -->
                  <ItemsControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                                ItemsSource="{Binding ContextChips}"
                                IsVisible="{Binding HasContext}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:RunLogContextChipViewModel}">
                        <!-- 行内 ID chip 比筛选区的紧一档：它是明细的一部分，
                             不该抢走消息正文的视觉权重。 -->
                        <Button Classes="chip-filter"
                                MinHeight="22"
                                Padding="8,2"
                                Margin="0,2,6,0"
                                Command="{Binding Command}"
                                ToolTip.Tip="{Binding Value}"
                                AutomationProperties.Name="{Binding Label}">
                          <TextBlock Text="{Binding Label}" Classes="caption mono" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <Border Grid.Row="1"
              Classes="empty-state"
              IsVisible="{Binding ShowEmpty}"
              VerticalAlignment="Center">
        <StackPanel Spacing="10" HorizontalAlignment="Center" MaxWidth="420">
          <ctl:EmptyStateArt Kind="RunLog" Width="200" Height="143" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding EmptyTitle}" Classes="empty-title" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding EmptyHint}"
                     Classes="caption"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="2"
                  Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  Spacing="10"
                  Margin="0,10,0,0"
                  IsVisible="{Binding ShowContent}">
        <Button Classes="secondary"
                Content="{Binding LoadMoreText}"
                Command="{Binding LoadMoreCommand}"
                IsVisible="{Binding HasMore}" />
        <!-- U185-A：「加载更多」的等待。这一处点击后按钮会消失、文字出现，
             若没有动效，用户无法区分「正在取下一页」与「取完了但没有更多」。 -->
        <StackPanel Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsLoadingMore}">
          <TextBlock Text="{Binding LoadingMoreText}"
                     Classes="caption"
                     VerticalAlignment="Center" />
          <ctl:BusyDots IsActive="{Binding IsLoadingMore}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
