<UserControl
    x:Class="Ariadne.Desktop.Views.TemplateMarketPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Ariadne.Desktop.Controls"
    xmlns:vm="clr-namespace:Ariadne.Desktop.ViewModels"
    x:Name="Root"
    x:DataType="vm:TemplateMarketPageViewModel"
    Loaded="OnLoaded">
  <!-- 根容器透明：让 MainWindow 底层的径向光晕透上来 -->
  <Grid RowDefinitions="Auto,*" Background="Transparent">

    <Border Grid.Row="0" Classes="page-header">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
      <Border Grid.Column="0" Classes="page-header-mark" />
      <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="title" VerticalAlignment="Center" />
      <Border Grid.Column="2"
              Classes="chip"
              VerticalAlignment="Center"
              Background="{DynamicResource Ariadne.BackgroundSubtle}"
              BorderBrush="{DynamicResource Ariadne.BorderMuted}">
        <TextBlock Text="{Binding CatalogSourceText}"
                   Classes="caption"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Ariadne.TextSecondary}" />
      </Border>
    </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel MaxWidth="1120" Margin="32,26,32,36">

        <!-- 搜索和标签构成连续命令区，结果卡片保持独立可操作单元。 -->
        <Border Classes="search-shell"
                MaxWidth="680"
                HorizontalAlignment="Left">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Path Grid.Column="0"
                  Classes="icon"
                  Width="16"
                  Height="16"
                  Margin="10,0,2,0"
                  Opacity="0.55"
                  Data="{StaticResource Ariadne.Icon.Search}"
                  IsHitTestVisible="False" />
            <TextBox Grid.Column="1"
                     x:Name="SearchBox"
                     Classes="search-input"
                     Text="{Binding SearchQuery, Mode=TwoWay}"
                     PlaceholderText="{Binding SearchPlaceholder}"
                     KeyDown="OnSearchKeyDown"
                     AutomationProperties.Name="{Binding SearchPlaceholder}" />
            <Button Grid.Column="2"
                    Classes="search-submit"
                    Command="{Binding SearchCommand}"
                    ToolTip.Tip="{Binding SearchText}"
                    AutomationProperties.Name="{Binding SearchText}">
              <Path Classes="icon" Data="{StaticResource Ariadne.Icon.Search}" />
            </Button>
          </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding Tags}"
                      IsEnabled="{Binding CanInteract}"
                      HorizontalAlignment="Left"
                      Margin="0,14,0,24">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:TemplateTagViewModel}">
              <Button Classes="chip-filter"
                      ctl:SelectedClass.IsSelected="{Binding IsSelected}"
                      Margin="0,0,8,8"
                      Padding="12,6"
                      Command="{Binding SelectCommand}"
                      Content="{Binding Title}"
                      AutomationProperties.Name="{Binding Title}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Templates}"
                      IsVisible="{Binding HasResults}"
                      IsEnabled="{Binding CanInteract}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="3" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:TemplateCardViewModel}">
              <Border Classes="card" Margin="6" Padding="0" MinHeight="178" ClipToBounds="True">
                <Grid RowDefinitions="4,*">
                  <Border Grid.Row="0" Background="{DynamicResource Ariadne.AccentPrimary}" />
                <DockPanel Grid.Row="1" Margin="18,15,18,16">
                  <StackPanel DockPanel.Dock="Top" Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="subtitle" TextTrimming="CharacterEllipsis" />
                      <Border Grid.Column="1" Classes="chip" Background="{DynamicResource Ariadne.AccentLight}" IsVisible="{Binding RequiresPermissions}">
                        <TextBlock Text="{Binding #Root.DataContext.PermissionText}" Classes="caption" Foreground="{DynamicResource Ariadne.AccentPrimary}" />
                      </Border>
                    </Grid>
                    <TextBlock Text="{Binding TagsText}" Classes="caption" TextWrapping="Wrap" Opacity="0.9" />
                  </StackPanel>
                  <StackPanel DockPanel.Dock="Bottom"
                              Orientation="Horizontal"
                              Spacing="8"
                              HorizontalAlignment="Right"
                              Margin="0,14,0,0">
                    <Button Classes="secondary btn-compact"
                            Content="{Binding #Root.DataContext.DetailText}"
                            Command="{Binding ShowDetailsCommand}" />
                    <Button Classes="primary btn-compact"
                            Content="{Binding #Root.DataContext.ImportText}"
                            Command="{Binding InstallCommand}" />
                  </StackPanel>
                </DockPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="empty-state"
                IsVisible="{Binding IsLoading}"
                Margin="8,24"
                HorizontalAlignment="Stretch">
          <!-- U185-A：加载态从「一行静态文字」补上呼吸点。
               ⚠️ `LiveSetting` 留在 TextBlock 上、**不要挪到外层 StackPanel**：
               屏幕阅读器播报的是文本内容，而 BusyDots 是纯视觉、
               自身 IsHitTestVisible=false 也无可读文本，
               把 live region 扩到容器只会让播报多带一段空节点。 -->
          <StackPanel Orientation="Horizontal" Spacing="8"
                      HorizontalAlignment="Center">
            <TextBlock Text="{Binding LoadingText}"
                       Classes="secondary"
                       VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite" />
            <ctl:BusyDots IsActive="{Binding IsLoading}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <Border Classes="empty-state"
                IsVisible="{Binding IsEmpty}"
                Margin="8,24"
                HorizontalAlignment="Stretch">
          <StackPanel Spacing="8" HorizontalAlignment="Center" MaxWidth="400">
            <ctl:EmptyStateArt Kind="Templates" Width="140" Height="100" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding EmptyText}"
                       Classes="secondary"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="empty-state"
                IsVisible="{Binding IsError}"
                Margin="8,24"
                HorizontalAlignment="Stretch">
          <StackPanel Spacing="10" HorizontalAlignment="Center" MaxWidth="420">
            <TextBlock Text="{Binding StatusText}"
                       Classes="secondary"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Assertive" />
            <!-- U198-B：失败补救行。模板页的错误态本来只有一句「怎么了」+ 一颗重试键，
                 而首次使用最常见的失败恰恰不是重试能解决的（没配服务商、没权限）。 -->
            <TextBlock Text="{Binding RecoveryText}"
                       Classes="caption"
                       Foreground="{DynamicResource Ariadne.StatusWarning}"
                       IsVisible="{Binding HasRecoveryText}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <Button Classes="secondary"
                    Content="{Binding RetryText}"
                    Command="{Binding SearchCommand}"
                    HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <Border Classes="empty-state"
                IsVisible="{Binding IsEndOfList}"
                Margin="8,18"
                HorizontalAlignment="Stretch">
          <TextBlock Text="{Binding EndOfListText}"
                     Classes="caption"
                     HorizontalAlignment="Center"
                     TextAlignment="Center" />
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,8">
          <Button Classes="secondary"
                  IsVisible="{Binding IsLoadMoreVisible}"
                  IsEnabled="{Binding CanLoadMore}"
                  Content="{Binding LoadMoreText}"
                  Command="{Binding LoadMoreCommand}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
