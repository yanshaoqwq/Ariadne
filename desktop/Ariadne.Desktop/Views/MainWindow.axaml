<Window
    x:Class="Ariadne.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Ariadne.Desktop.Controls"
    xmlns:vm="clr-namespace:Ariadne.Desktop.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    Width="1320"
    Height="820"
    MinWidth="760"
    MinHeight="480"
    CanResize="True"
    UseLayoutRounding="True"
    TextElement.FontSize="14"
    TextOptions.TextRenderingMode="SubpixelAntialias"

    RenderOptions.BitmapInterpolationMode="HighQuality"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="-1"
    WindowDecorations="None"
    TransparencyLevelHint="Mica, AcrylicBlur"
    Background="Transparent"
    WindowStartupLocation="CenterScreen"
    Title="{Binding AppName}">

  <!-- 外层圆角窗体：最大化时圆角/边框归零（U61） -->
  <Border
      x:Name="WindowChrome"
      Background="{DynamicResource Ariadne.WindowBase}"
      BorderBrush="{DynamicResource Ariadne.BorderStrong}"
      BorderThickness="1"
      CornerRadius="10"
      ClipToBounds="True">
    <Panel>
    <Grid RowDefinitions="54,Auto,Auto,*">

      <!-- ================= 顶栏（自定义标题栏 + 项目 + 预算） ================= -->
      <Grid
          Grid.Row="0"
          ColumnDefinitions="Auto,*,Auto,Auto"
          Background="{DynamicResource Ariadne.BackgroundSurface}"
          PointerPressed="OnTitleBarPointerPressed">

        <!-- 品牌轨道与左侧导航共用主题浅色材质。 -->
        <Border Grid.Column="0"
                Width="{Binding SidebarWidth}"
                Background="{DynamicResource Ariadne.BackgroundSubtle}"
                BorderBrush="{DynamicResource Ariadne.BorderMuted}"
                BorderThickness="0,0,1,0">
          <Panel>
            <!-- U162-A：这里必须是 OnAccent="False"。
                 OnAccent=true 走的是「Logo 压在一整片强调色上」那条路：笔画取
                 Ariadne.TextOnAccent（= 压在强调色块上的文字色），所以暗色主题下笔画是
                 #07110F 近黑，亮色下是纯白——两者都不是「主题色的 Logo」。
                 而这条品牌轨道的底是 Ariadne.BackgroundSubtle（亮 #E2E7E4 / 暗 #191C1E），
                 都不是强调色；on-accent 类只好自己补一块青绿圆角底来让白/黑笔画有对比度，
                 于是品牌标识退化成「一个色块徽章」。
                 OnAccent=false 走 CreateThemedBitmap：笔画 = Ariadne.AccentPrimary、
                 纸面 = BackgroundElevated，容器底为 Transparent（on-paper 类），
                 Logo 直接落在侧栏底上，笔画就是主题强调色。
                 ⚠️ WelcomeView 那处的 OnAccent="True" 是对的——它确实嵌在一块
                 AccentHover→AccentPressed 的渐变方块里，别一起改。 -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0"
                        VerticalAlignment="Center"
                        IsVisible="{Binding SidebarExpanded}">
              <ctl:BrandLogo Width="30" Height="30" OnAccent="False" VerticalAlignment="Center" />
              <TextBlock Text="{Binding AppName}"
                         Foreground="{DynamicResource Ariadne.TextPrimary}"
                         FontSize="15"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </StackPanel>
            <ctl:BrandLogo Width="30" Height="30" OnAccent="False"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding SidebarCollapsed}" />
          </Panel>
        </Border>

        <!-- 项目切换与运行状态：扁平化，无边框盒子，点击区域内含信号色条+文字+箭头 -->
        <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
          <Button Grid.Column="0"
                  Classes="subtle"
                  Padding="0"
                  Margin="14,0,8,0"
                  VerticalAlignment="Center"
                  ToolTip.Tip="{Binding ProjectMenuText}"
                  AutomationProperties.Name="{Binding ProjectMenuText}">
            <!-- 无背景/无边框：仅信号条+项目名+箭头组合 -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="4,6">
              <!-- 项目标记条改用主题强调色：原先的硬编码橙 Ariadne.Signal 与
                   青绿强调色系互斥，在顶栏里像一处随机噪点，也违反「颜色一律走
                   主题 token」的约定（UI视觉规范 §3.1）。 -->
              <Border Grid.Column="0" Width="4" Height="16" CornerRadius="2"
                      Background="{DynamicResource Ariadne.AccentPrimary}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="{Binding ProjectTitle}"
                         Classes="caption"
                         Foreground="{DynamicResource Ariadne.TextPrimary}"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         MaxWidth="210"
                         ToolTip.Tip="{Binding ProjectTitle}" />
              <Path Grid.Column="2" Classes="icon" Width="12" Height="12"
                    Data="{StaticResource Ariadne.Icon.ChevronDown}" />
            </Grid>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="{Binding CreateProjectText}" Command="{Binding CreateProjectCommand}" />
                <MenuItem Header="{Binding OpenProjectText}" Command="{Binding OpenProjectCommand}" />
                <Separator />
                <ItemsControl ItemsSource="{Binding ProjectMenuItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProjectMenuItemViewModel}">
                      <MenuItem Header="{Binding Name}" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding ProjectRoot}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Separator />
                <MenuItem Header="{Binding LeaveProjectText}" Command="{Binding LeaveProjectCommand}"
                          IsEnabled="{Binding HasOpenProject}" Classes="danger" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="8,0,14,0" MaxWidth="300">
            <Ellipse Width="6" Height="6" Fill="{DynamicResource Ariadne.TextSubtle}" />
            <TextBlock Text="{Binding HeaderStatusText}"
                       Classes="subtle"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="260"
                       ToolTip.Tip="{Binding HeaderStatusText}" />
          </StackPanel>
        </Grid>

        <!-- 预算遥测：扁平化，无边框，仅文本+进度条内联 -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding BudgetLabel}" Classes="caption" VerticalAlignment="Center" />
          <ProgressBar Width="64" Height="5" Minimum="0" Maximum="100"
                       Value="{Binding BudgetUsagePercent}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding BudgetStatusText}" Classes="caption"
                     VerticalAlignment="Center" MaxWidth="90"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding BudgetStatusText}" />
        </StackPanel>

        <!-- 窗口控制。U162-C：整组「再小一点、再低一点」。
             「低一点」= 垂直位置更靠下，用 4px 上边距实现，**不改成
             VerticalAlignment="Bottom"**——那会让它贴住下方维护横幅的边界，
             窗口最大化时更明显。右边距 4→8：键位缩小后离窗角太近，
             与外层 10px 圆角的窗体边缘挤在一起。
             ⚠️ Center 对齐下上边距只产生**一半**位移：Avalonia 的 arrange 是
             `top + (slotH - top - bottom - h) / 2`，故 top=4 实际下移 2px
             （30px 键在 54px 行内从 y=12 挪到 y=14）。想再低就继续加这个值，
             别以为「设了 4 却只动了 2」是没生效。 -->
        <StackPanel
            Grid.Column="3"
            Orientation="Horizontal"
            Spacing="2"
            Margin="0,4,8,0"
            VerticalAlignment="Center"
            HorizontalAlignment="Right">
          <Button
              Classes="window-control"
              ToolTip.Tip="{Binding MinimizeWindowText}"
              AutomationProperties.Name="{Binding MinimizeWindowText}"
              Click="OnMinimizeClicked">
            <Path Classes="icon minimize" Data="{StaticResource Ariadne.Icon.Minimize}" />
          </Button>
          <Button
              Classes="window-control"
              ToolTip.Tip="{Binding MaximizeWindowText}"
              AutomationProperties.Name="{Binding MaximizeWindowText}"
              Click="OnMaximizeClicked">
            <Path x:Name="MaximizeRestoreIcon"
                  Classes="icon"
                  Data="{StaticResource Ariadne.Icon.Maximize}" />
          </Button>
          <Button
              Classes="window-control close"
              ToolTip.Tip="{Binding CloseWindowText}"
              AutomationProperties.Name="{Binding CloseWindowText}"
              Click="OnCloseClicked">
            <Path Classes="icon" Data="{StaticResource Ariadne.Icon.Close}" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- D3：项目维护门禁横幅（active/failed） -->
      <Border Grid.Row="1"
              IsVisible="{Binding IsMaintenanceBlocking}"
              Background="{DynamicResource Ariadne.LogWarningBg}"
              BorderBrush="{DynamicResource Ariadne.StatusWarning}"
              BorderThickness="0,0,0,1"
              Padding="12,6">
        <TextBlock Text="{Binding MaintenanceBannerText}"
                   TextWrapping="Wrap"
                   Classes="body"
                   Foreground="{DynamicResource Ariadne.StatusWarning}" />
      </Border>

      <!-- U1：默认只显示本地化摘要，作者主动展开后才显示脱敏诊断。 -->
      <Border Grid.Row="2"
              IsVisible="{Binding HasDiagnostic}"
              Background="{DynamicResource Ariadne.LogWarningBg}"
              BorderBrush="{DynamicResource Ariadne.StatusWarning}"
              BorderThickness="0,0,0,1"
              Padding="12,6">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="{Binding DiagnosticTitleText}"
                       Classes="caption" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding DiagnosticSummaryText}"
                       Classes="caption" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="subtle" Command="{Binding ToggleDiagnosticCommand}"
                    Content="{Binding DiagnosticToggleText}"
                    AutomationProperties.Name="{Binding DiagnosticToggleText}" />
            <Button Grid.Column="3" Classes="subtle" Command="{Binding ClearDiagnosticCommand}"
                    Content="{Binding DiagnosticClearText}"
                    AutomationProperties.Name="{Binding DiagnosticClearText}" />
          </Grid>
          <Border IsVisible="{Binding IsDiagnosticExpanded}"
                  Background="{DynamicResource Ariadne.BackgroundSubtle}"
                  BorderBrush="{DynamicResource Ariadne.BorderMuted}"
                  BorderThickness="1" CornerRadius="4" Padding="8">
            <!-- U153：MaxHeight 必须挂 ScrollViewer 而不是 TextBlock。
                 同样的写法在两类控件上语义相反：ScrollViewer 上是「限高可滚」，
                 TextBlock 上是「裁掉多余」——且裁切发生在测量阶段，
                 TextBlock 向父级上报的 DesiredSize 已被钉死，外层再包滚动也救不回来。
                 原先 MaxHeight="96" 让 40 行调用栈只剩 17.6% 可见，
                 而按钮文案是「展开详情」，功能与文案直接矛盾。
                 限高从 96 放宽到 320（与 ConfirmDialogView 的弹窗限高同值）：
                 「展开详情」承接的是排障最需要看全的脱敏诊断，
                 96px 只有 7 行，连一屏调用栈都装不下；320 约 24 行，
                 既让常见诊断一眼看完，又不至于让顶栏吃掉半屏。 -->
            <ScrollViewer MaxHeight="320"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <TextBlock Text="{Binding DiagnosticDetailText}" Classes="caption"
                         TextWrapping="Wrap" />
            </ScrollViewer>
          </Border>
        </StackPanel>
      </Border>

      <!-- ================= 主体：侧栏 + 内容 ================= -->
      <Grid Grid.Row="3" ColumnDefinitions="Auto,*">

        <!-- 左侧栏：折叠时仅图标（U66）。
             导轨是「凹槽」，选中纸片朝左撬起并留在槽内，故 ClipToBounds=True 保持槽缘干净。
             横向微渐变：右侧（靠内容区）略深，形成一道极淡的内阴影，
             让凹槽真的看起来是凹的，纸片撬起才有依据。 -->
        <Border
            Grid.Column="0"
            Width="{Binding SidebarWidth}"
            BorderBrush="{DynamicResource Ariadne.BorderMuted}"
            BorderThickness="0,0,1,0"
            ClipToBounds="True">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
              <GradientStop Offset="0" Color="{DynamicResource Ariadne.Color.BackgroundSurface}" />
              <GradientStop Offset="0.55" Color="{DynamicResource Ariadne.Color.BackgroundSubtle}" />
              <GradientStop Offset="1" Color="{DynamicResource Ariadne.Color.BackgroundSubtle}" />
            </LinearGradientBrush>
          </Border.Background>
          <DockPanel Margin="0,8,0,0">

            <Button
                DockPanel.Dock="Top"
                Classes="rail-toggle"
                Margin="12,2,12,10"
                HorizontalAlignment="Left"
                Width="40"
                Height="36"
                Command="{Binding ToggleSidebarCommand}"
                ToolTip.Tip="{Binding ToggleSidebarText}"
                AutomationProperties.Name="{Binding ToggleSidebarText}">
              <Path Classes="icon" Data="{StaticResource Ariadne.Icon.Menu}" />
            </Button>

            <!-- 底部：版本 + 反馈 -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,14" Spacing="2">
              <Border Height="1" Margin="12,6" Background="{DynamicResource Ariadne.BorderMuted}" />
              <Button Classes="nav rail-nav"
                      Classes.collapsed="{Binding SidebarCollapsed}"
                      Command="{Binding OpenVersionCommand}"
                      ToolTip.Tip="{Binding VersionToolTipText}"
                      AutomationProperties.Name="{Binding VersionText}">
                <Panel>
                  <!-- 展开：首列 3px 空占位，与导航项的左脊网格对齐，图标不错位 -->
                  <Grid ColumnDefinitions="3,31,*" Margin="0,0,10,0" IsVisible="{Binding SidebarExpanded}">
                    <Path Grid.Column="1" Classes="icon" Width="16" Height="16" Data="{StaticResource Ariadne.Icon.Info}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding VersionText}" Classes="caption"
                               VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                  </Grid>
                  <!-- 折叠 -->
                  <Grid ColumnDefinitions="3,*" Width="40" IsVisible="{Binding SidebarCollapsed}">
                    <Path Grid.Column="1" Classes="icon" Width="16" Height="16" Data="{StaticResource Ariadne.Icon.Info}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                </Panel>
              </Button>
              <Button Classes="nav rail-nav"
                      Classes.collapsed="{Binding SidebarCollapsed}"
                      Command="{Binding OpenFeedbackCommand}"
                      ToolTip.Tip="{Binding FeedbackToolTipText}"
                      AutomationProperties.Name="{Binding FeedbackText}">
                <Panel>
                  <Grid ColumnDefinitions="3,31,*" Margin="0,0,10,0" IsVisible="{Binding SidebarExpanded}">
                    <Path Grid.Column="1" Classes="icon" Width="16" Height="16" Data="{StaticResource Ariadne.Icon.Feedback}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding FeedbackText}" Classes="caption" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </Grid>
                  <Grid ColumnDefinitions="3,*" Width="40" IsVisible="{Binding SidebarCollapsed}">
                    <Path Grid.Column="1" Classes="icon" Width="16" Height="16" Data="{StaticResource Ariadne.Icon.Feedback}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                </Panel>
              </Button>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,2,0,0" Spacing="2">
                <!-- U66：模板在 App.DataTemplates（NavigationItemViewModel 单源） -->
                <ItemsControl ItemsSource="{Binding PrimaryNavigationItems}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- 上组/下组之间的 52px 大间隔（ui设计方案 §左侧栏）。
                     纯留白分组，不画线——少一条线就少一个盒子。 -->
                <Panel Height="52" />

                <ItemsControl ItemsSource="{Binding SecondaryNavigationItems}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- 主内容区：底层铺一层极淡的径向亮斑（中上偏亮 → 四周略沉），
             给大片空白一个光心，避免「一整块死灰」。纯装饰，不吃命中。 -->
        <Panel Grid.Column="1">
          <Border Background="{DynamicResource Ariadne.BackgroundMain}" />
          <Border IsHitTestVisible="False" Opacity="0.55">
            <Border.Background>
              <RadialGradientBrush GradientOrigin="50%,18%" Center="50%,18%" RadiusX="78%" RadiusY="92%">
                <GradientStop Offset="0" Color="{DynamicResource Ariadne.Color.BackgroundElevated}" />
                <GradientStop Offset="1" Color="Transparent" />
              </RadialGradientBrush>
            </Border.Background>
          </Border>
          <ContentControl Content="{Binding CurrentPage}" />
        </Panel>
      </Grid>
      <!-- ================= 全局弹窗遮罩 ================= -->
      <Border x:Name="DialogScrim"
              Grid.Row="1"
              Grid.RowSpan="3"
              Background="{DynamicResource Ariadne.Scrim}"
              IsVisible="{Binding Dialog.IsOpen}"
              PointerPressed="OnDialogScrimPressed">
        <ContentControl Content="{Binding Dialog.ActiveDialog}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="24"
                        MaxHeight="{Binding $parent[Border].Bounds.Height}"
                        FontFamily="{DynamicResource Ariadne.Font.Ui}" />
      </Border>
    </Grid>
    </Panel>
  </Border>
</Window>
