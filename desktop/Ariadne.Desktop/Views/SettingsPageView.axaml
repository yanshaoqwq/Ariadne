<UserControl
    x:Class="Ariadne.Desktop.Views.SettingsPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Ariadne.Desktop.Controls"
    xmlns:vm="clr-namespace:Ariadne.Desktop.ViewModels"
    x:DataType="vm:SettingsPageViewModel">
  <UserControl.Styles>
    <!-- U145：标识/别名选择器。AutoCompleteBox 内层就是 TextBox，槽色与焦点描边
         全部沿用主题基础样式；这里只补等宽字体（标识符要看清 l/1/I 的差别）
         与候选面板限高。选择器必须带类型前缀，裸 .identifier-picker 会 AVLN2200。
         与 WorkspacePageView 各留一份：两个页面都要用，而主题文件此轮不动。 -->
    <Style Selector="AutoCompleteBox.identifier-picker">
      <Setter Property="FontFamily" Value="{DynamicResource Ariadne.Font.Mono}" />
      <Setter Property="MaxDropDownHeight" Value="240" />
    </Style>
    <Style Selector="ListBox.settings-section-index">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <!-- U178-A 骨架占位行。颜色只取主题令牌：BackgroundSubtle 是「比页底稍重一档」
         的那一级，正好读作「这里将来有东西但还没到」，而不是一个实心控件。
         选择器带 Border 类型前缀——裸 .settings-skeleton-row 会在编译期报 AVLN2200。
         **刻意不加脉动/闪光动画**：会一直跑到数据回来，在最慢的那台机器上正好是
         最抢眼的时候；且全项目当前零 Animation/KeyFrame，为一处骨架引入第一个
         无限循环动画不划算。静态占位块已经把「在读」这件事说清了。 -->
    <Style Selector="Border.settings-skeleton-row">
      <Setter Property="Height" Value="34" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="CornerRadius" Value="{DynamicResource Ariadne.Radius.Medium}" />
      <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundSubtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.BorderMuted}" />
      <Setter Property="BorderThickness" Value="{DynamicResource Ariadne.Stroke.HairlineAll}" />
    </Style>
    <!-- 索引项无底色块无描边：文字悬在空白上，状态全部由左侧导轨段与字色承担。
         U162-F：项距 0,5 → 0,7。TextWrapping=Wrap 下长标题折行后，
         5px 上下内边距让相邻两项在视觉上黏成一团，分不出是两条还是一条折行。
         字色从 Ariadne.TextMuted 改为 Ariadne.TextSubtle：**前者全主题零定义**
         （headless 实测 TryGetResource=False），DynamicResource 找不到 key 时
         **不报错也不回落**，属性保持未设值，于是索引字色一直是基础样式的
         TextPrimary（亮 #1B1F22）——即「未选中态本该更淡」这个设计从未生效，
         选中/未选中只差字重与导轨色。TextSubtle 是主题里真实存在的那一档。 -->
    <Style Selector="ListBox.settings-section-index ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0,7" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextSubtle}" />
    </Style>
    <!-- 字色必须直选到 TextBlock：主题里 `<Style Selector="TextBlock">` 把
         Foreground 设在每个 TextBlock 自己身上（Style 优先级），
         宿主上的值只以 Inherited 传下来，压不动它（U162-E 同一处实测结论）。
         上面 ListBoxItem 那条 Foreground 保留是给非 TextBlock 子级兜底。 -->
    <Style Selector="ListBox.settings-section-index ListBoxItem TextBlock.index-label">
      <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextSubtle}" />
    </Style>
    <!-- 导轨段：每项左侧一条 2px 竖线，未选中时用 BorderMuted 画出连续的一整条导轨
         （项紧邻排列，段与段首尾相接 ⇒ 看起来是一条贯穿索引的细线），
         选中项那一段换成强调色。这比孤立圆点更能表达「在整体的哪一段」，
         且与 U162-E 的下划线选中语汇一致——同一个产品里选中态应当是同一套语言。
         ⚠️ 导轨只覆盖索引项自身的高度，不贯穿整页：那是「悬浮索引」与「分栏」
         的分界线，:244 记录的「不占布局列、不画全高栏」是已定夺的决定。 -->
    <Style Selector="ListBox.settings-section-index ListBoxItem Border.index-rail-segment">
      <Setter Property="Background" Value="{DynamicResource Ariadne.BorderMuted}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox.settings-section-index ListBoxItem:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.settings-section-index ListBoxItem:pointerover TextBlock.index-label">
      <Setter Property="Foreground" Value="{DynamicResource Ariadne.TextPrimary}" />
    </Style>
    <Style Selector="ListBox.settings-section-index ListBoxItem:pointerover Border.index-rail-segment">
      <Setter Property="Background" Value="{DynamicResource Ariadne.BorderStrong}" />
    </Style>
    <Style Selector="ListBox.settings-section-index ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.settings-section-index ListBoxItem:selected TextBlock.index-label">
      <Setter Property="Foreground" Value="{DynamicResource Ariadne.AccentPrimary}" />
    </Style>
    <Style Selector="ListBox.settings-section-index ListBoxItem:selected Border.index-rail-segment">
      <Setter Property="Background" Value="{DynamicResource Ariadne.AccentPrimary}" />
    </Style>
    <!-- 选中态的默认 ListBoxItem 模板会画一层底，这里连模板层一起压平 -->
    <Style Selector="ListBox.settings-section-index ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.settings-section-index ListBoxItem:focus">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- 悬浮保存钮：圆形。圆角给到 24（= 半宽）才是真圆而非圆角方。
         投影挂在外层 Border 上——BoxShadow 是 Border 的属性，Button 没有。 -->
    <Style Selector="Button.settings-save-fab">
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.settings-tabs">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <!-- U162-E：标签页选中态从「底色块 + 四边描边」改为下划线。
         ⚠️ 未选中态也必须占住那 2px 底边（BorderBrush=Transparent），
         否则选中/未选中的**布局高度不同**，切换标签时整条会上下跳动。
         这就是把原先的 BorderThickness="1"（四边）换成 "0,0,0,2" 的原因，
         而不是换成 "0"——几何必须恒定，可见性才交给颜色。
         CornerRadius 归零：下划线是一条直边，7px 圆角会让它两端翘起来。 -->
    <Style Selector="ListBox.settings-tabs ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBox.settings-tabs ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundHover}" />
    </Style>
    <!-- 下划线态：不铺底、不描四边，仅底边一条强调色 2px + 字色转强调。
         BorderThickness 四值顺序是 左,上,右,下。
         必须声明在通用 ListBox.settings-tabs ListBoxItem **之后**：
         Avalonia 同优先级按文档顺序后者胜，没有 CSS 那种特异性权重（U154 踩过）。
         ⚠️ 这里**不设 Foreground**（U162 报告建议设，实测无效，已证伪）：
         主题里 `<Style Selector="TextBlock">` 那条把 Foreground=TextPrimary 设在
         每个 TextBlock 自己身上，优先级是 Style；而宿主设值只能以 Inherited
         传到子级——Inherited 比 Style 弱，所以设在 ListBoxItem 上的字色
         **压不动模板里那个 TextBlock**（headless 实测：hostFg=Red 但 textFg 仍是
         #ff1b1f22）。字色必须直选到 TextBlock 上，见下一条。
         FontWeight 相反：主题没给 TextBlock 设过，所以它能正常继承下去（实测 DemiBold）。 -->
    <Style Selector="ListBox.settings-tabs ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.AccentPrimary}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- 选中标签的字色：必须直选到 TextBlock（理由见上一条）。 -->
    <Style Selector="ListBox.settings-tabs ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Ariadne.AccentPrimary}" />
    </Style>
    <!-- 必须连模板层一起压：ListBoxItem 的选中底真正画在模板内的
         PART_ContentPresenter 上，主题里那条全局规则
         `ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter`
         给它铺了 AccentLight。设在宿主 ListBoxItem 上的 Background="Transparent"
         压不掉它——两者作用在**不同对象**上，宿主的值只会以 Template 优先级
         经 TemplateBinding 下传，而带伪类的规则是 StyleTrigger 优先级（数值更小=更强）。
         本条与那条全局规则同为 StyleTrigger，靠「局部样式后应用」取胜，
         与页内索引 :51-54 那条是同一手法（实测过 PART_ContentPresenter 的
         BackgroundDiagnostic：未选中 = Template，选中 = StyleTrigger）。
         Foreground 也要一起压：那条全局规则连字色都改了。 -->
    <Style Selector="ListBox.settings-tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Ariadne.AccentPrimary}" />
    </Style>
    <Style Selector="ListBox.settings-tabs ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Ariadne.BackgroundHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Ariadne.AccentPrimary}" />
    </Style>
    <!-- U110：工具开关虽已勾选，但被硬权限 policy 否决（目前只有 web-search 有此判定）。 -->
    <Style Selector="CheckBox.policy-blocked">
      <Setter Property="Foreground" Value="{DynamicResource Ariadne.StatusWarning}" />
    </Style>
    <!-- U146：失效路径 chip。选择器必须带元素类型前缀（裸 .path-chip-dead 会报 AVLN2200），
         且这两条要声明在通用 chip-filter 之后才压得住——Avalonia 同优先级按文档顺序后者胜，
         没有 CSS 那种特异性权重。这里靠 Classes.path-chip-dead 绑定 IsUnavailable 触发。 -->
    <Style Selector="Button.chip-filter.path-chip-dead">
      <Setter Property="BorderBrush" Value="{DynamicResource Ariadne.StatusWarning}" />
      <Setter Property="Background" Value="{DynamicResource Ariadne.LogWarningBg}" />
    </Style>
    <Style Selector="Button.chip-filter.path-chip-dead TextBlock.path-chip-label">
      <Setter Property="Foreground" Value="{DynamicResource Ariadne.StatusWarning}" />
      <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <!-- U146：路径 chip 列表的统一模板，7 个站点共用一份。
         原先每处是一个 AcceptsReturn 的 TextBox 装换行分隔列表，导致单条无法校验、
         看不出哪条已失效、首尾空格静默出错。改成 chip 后每条独立、带存在性标注。
         复用主题已有的 Button.chip-filter，不新造视觉语汇。 -->
    <DataTemplate x:Key="PathChipListTemplate" DataType="{x:Type vm:PathChipListViewModel}">
      <StackPanel Spacing="6">
        <!-- 空列表给字而不是留白：留白让人以为界面没加载完 -->
        <TextBlock Text="{Binding EmptyText}"
                   Classes="caption"
                   IsVisible="{Binding !HasChips}" />
        <ItemsControl ItemsSource="{Binding Chips}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:PathChipViewModel}">
              <!-- 点 chip = 移除这一条，与运行记录页的筛选 chip 同一手势。
                   × 图标用矢量 Path（禁用图标字体：Segoe Fluent Icons 在 Linux 缺失会成豆腐块）。 -->
              <Button Classes="chip-filter"
                      Classes.path-chip-dead="{Binding IsUnavailable}"
                      Margin="0,0,6,6"
                      Command="{Binding RemoveCommand}"
                      ToolTip.Tip="{Binding AccessibleName}"
                      AutomationProperties.Name="{Binding AccessibleName}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding PathText}"
                             Classes="caption path-chip-label"
                             VerticalAlignment="Center" />
                  <Path Classes="icon" Width="9" Height="9"
                        Data="{StaticResource Ariadne.Icon.Close}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- 失效条目的说明文字：只置灰不给字，用户无从知道是「目录被删」还是「指到文件上」。 -->
        <ItemsControl ItemsSource="{Binding Chips}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:PathChipViewModel}">
              <TextBlock IsVisible="{Binding HasUnavailableText}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource Ariadne.StatusWarning}"
                         Text="{Binding AccessibleName}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- 手输入口 + 目录选择器。留单行输入框是为了键盘用户不必依赖选择器；
             AcceptsReturn 保持默认 false——这里一次只加一条，回车即提交。 -->
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0"
                   Text="{Binding DraftPath, Mode=TwoWay}"
                   PlaceholderText="{Binding DraftPlaceholder}"
                   AutomationProperties.Name="{Binding DraftPlaceholder}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Grid.Column="1"
                  Classes="secondary"
                  Content="{Binding AddText}"
                  Command="{Binding AddCommand}" />
          <Button Grid.Column="2"
                  Classes="secondary"
                  Content="{Binding BrowseText}"
                  Command="{Binding BrowseCommand}" />
        </Grid>
        <!-- 逐条校验的错误：这就是「单条无法校验」那条后果的正解。
             错的那条进不了列表，且当场说明原因（不是只灰掉按钮）。 -->
        <TextBlock Text="{Binding DraftError}"
                   IsVisible="{Binding HasDraftError}"
                   Classes="caption"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Ariadne.StatusError}"
                   AutomationProperties.LiveSetting="Assertive" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <!-- 根容器透明：让 MainWindow 底层的径向光晕透上来 -->
  <Grid RowDefinitions="Auto,*" Background="Transparent">

    <Border
        Grid.Row="0"
        Classes="page-header"
        Padding="28,16,28,12">
      <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="12">
          <Border Grid.Row="0" Grid.Column="0" Classes="page-header-mark" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Title}" Classes="title" VerticalAlignment="Center" />
          <Button Grid.Row="0" Grid.Column="2"
                  Classes="secondary"
                  Content="{Binding RestoreCurrentTabText}"
                  Command="{Binding RestoreCurrentTabCommand}" />
          <Button Grid.Row="0" Grid.Column="3"
                  Classes="secondary"
                  Content="{Binding RestoreRecommendedDefaultsText}"
                  Command="{Binding RestoreRecommendedDefaultsCommand}" />
          <Border Grid.Row="0" Grid.Column="4" Classes="chip" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="{Binding StatusText}"
                       Classes="caption"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="{Binding StatusText}"
                       AutomationProperties.LiveSetting="Assertive" />
          </Border>
          <ScrollViewer Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <ListBox ItemsSource="{Binding Tabs}"
                     Classes="settings-tabs"
                     SelectedItem="{Binding NavigationSelection, Mode=TwoWay}"
                     SelectionMode="Single"
                     Background="Transparent">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SettingsTabViewModel}">
                  <!-- 下内边距 7→9（U162-E）：2px 下划线紧贴文字底会显得挤，
                       多 2px 让线与字之间有一口气。上下不对称是刻意的——
                       下划线在下方，视觉重心本来就要往上提一点才居中。 -->
                  <TextBlock Text="{Binding Title}"
                             MinWidth="84"
                             Padding="13,7,13,9"
                             TextAlignment="Center"
                             AutomationProperties.Name="{Binding Title}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>
          <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
                     Text="{Binding RecoveryText}"
                     Classes="caption"
                     Foreground="{DynamicResource Ariadne.StatusWarning}"
                     IsVisible="{Binding HasRecoveryText}"
                     TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite" />
      </Grid>
    </Border>

    <!-- 页内索引 = 无分栏「悬浮索引」。
         它不再占据布局列、不画全高栏、不加分栏边界：内容区铺满整宽，
         索引只是一列浮在内容之上、贴左缘垂直居中的文字锚点。
         内容 ScrollViewer 左侧留出余量，正文不会跑到索引底下。 -->
    <Panel Grid.Row="1">
      <ScrollViewer x:Name="SettingsContentScroll" Padding="196,26,36,32">
        <StackPanel MaxWidth="1040" HorizontalAlignment="Stretch" Spacing="14">
        <Border Classes="stream-list"
                IsVisible="{Binding HasSectionLoadFailures}">
          <ItemsControl ItemsSource="{Binding SectionLoadFailures}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:SettingsSectionLoadFailureViewModel}">
                <Border Classes="stream-row" Padding="14,9">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0"
                            Width="4"
                            Height="20"
                            CornerRadius="2"
                            Background="{DynamicResource Ariadne.StatusWarning}"
                            VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}"
                                 Classes="secondary"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Message}"
                                 Classes="caption"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Classes="secondary btn-compact"
                            Content="{Binding RetryText}"
                            Command="{Binding RetryCommand}"
                            VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
        <Panel x:Name="SettingsContentHost" HorizontalAlignment="Stretch">

          <StackPanel IsVisible="{Binding IsGeneralSelected}" IsEnabled="{Binding IsGeneralEditable}" Spacing="18">
            <TextBlock Text="{Binding GeneralTitle}" Classes="title" />
            <TextBlock Text="{Binding GeneralScopeHelpText}" Classes="caption" TextWrapping="Wrap" />
            <Border Classes="settings-section" Padding="22">
              <StackPanel Spacing="14">
                <TextBlock x:Name="ProjectSectionAnchor" Text="{Binding ProjectSectionTitle}" Classes="subtitle" />
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="180,*" RowSpacing="10" ColumnSpacing="18">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ProjectNameLabel}" Classes="secondary" VerticalAlignment="Center" />
                  <TextBox Grid.Row="0" Grid.Column="1"
                           Text="{Binding ProjectName, Mode=TwoWay}"
                           AutomationProperties.Name="{Binding ProjectNameLabel}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ProjectRootLabel}" Classes="secondary" VerticalAlignment="Top" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProjectRoot}" Classes="mono" TextWrapping="Wrap"
                             AutomationProperties.Name="{Binding ProjectRootLabel}" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Classes="settings-section" Padding="22">
              <StackPanel Spacing="14">
                <TextBlock x:Name="DirectoriesSectionAnchor" Text="{Binding DirectoriesSectionTitle}" Classes="subtitle" />
                <Border Classes="notice warning">
                  <TextBlock Text="{Binding DirectorySwitchWarningText}" Classes="caption" TextWrapping="Wrap" />
                </Border>
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="180,*,Auto" RowSpacing="12" ColumnSpacing="12">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DocumentsDirLabel}" Classes="secondary" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DocumentsDir, Mode=TwoWay}"
                         AutomationProperties.Name="{Binding DocumentsDirLabel}" />
                <Button Grid.Row="0" Grid.Column="2" Classes="secondary" Content="{Binding BrowseFolderText}" Command="{Binding BrowseDocumentsDirCommand}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding WorkflowsDirLabel}" Classes="secondary" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WorkflowsDir, Mode=TwoWay}"
                         AutomationProperties.Name="{Binding WorkflowsDirLabel}" />
                <Button Grid.Row="1" Grid.Column="2" Classes="secondary" Content="{Binding BrowseFolderText}" Command="{Binding BrowseWorkflowsDirCommand}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding SkillsDirLabel}" Classes="secondary" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SkillsDir, Mode=TwoWay}"
                         AutomationProperties.Name="{Binding SkillsDirLabel}" />
                <Button Grid.Row="2" Grid.Column="2" Classes="secondary" Content="{Binding BrowseFolderText}" Command="{Binding BrowseSkillsDirCommand}" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding ExportsDirLabel}" Classes="secondary" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ExportsDir, Mode=TwoWay}"
                         AutomationProperties.Name="{Binding ExportsDirLabel}" />
                <Button Grid.Row="3" Grid.Column="2" Classes="secondary" Content="{Binding BrowseFolderText}" Command="{Binding BrowseExportsDirCommand}" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Classes="settings-section" Padding="22">
              <StackPanel Spacing="14">
                <TextBlock x:Name="ProjectMemorySectionAnchor" Text="{Binding ProjectMemorySectionTitle}" Classes="subtitle" />
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="180,*" RowSpacing="10" ColumnSpacing="18">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ProjectMemoryLabel}" Classes="secondary" VerticalAlignment="Top" />
                  <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding ProjectMemory, Mode=TwoWay}"
                         PlaceholderText="{Binding ProjectMemoryPlaceholder}"
                         AutomationProperties.Name="{Binding ProjectMemoryLabel}"
                         AutomationProperties.HelpText="{Binding ProjectMemoryPlaceholder}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="150" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsModelsSelected}" IsEnabled="{Binding IsModelsEditable}" Spacing="18">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
              <TextBlock Grid.Column="0" Text="{Binding ModelsTitle}" Classes="title" />
              <Button Grid.Column="1" Classes="secondary" Content="{Binding TestProviderDraftText}" Command="{Binding TestProviderDraftCommand}" />
              <Button Grid.Column="2" Classes="secondary" Content="{Binding RefreshText}" Command="{Binding RefreshModelsCommand}" />
            </Grid>
            <TextBlock Text="{Binding ProviderScopeHelpText}" Classes="caption" TextWrapping="Wrap" />
            <Border Classes="settings-section" Padding="22">
              <StackPanel Spacing="14">
                <TextBlock x:Name="ProviderSectionAnchor" Text="{Binding ProviderSectionTitle}" Classes="subtitle" />
                <Grid ColumnDefinitions="240,*" ColumnSpacing="20">
                <!-- 多供应商列表 -->
                <DockPanel Grid.Column="0">
                  <!-- ProviderStatus 去重：右侧编辑器已有「状态」一行（ProviderStatusLabel +
                       ProviderStatus），此处左栏再渲染同一字符串，屏上并排重复两遍。 -->
                  <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
                    <TextBlock Text="{Binding ProviderListTitle}" Classes="subtitle" />
                  </StackPanel>
                  <Button DockPanel.Dock="Bottom"
                          Classes="secondary"
                          HorizontalAlignment="Stretch"
                          Margin="0,12,0,0"
                          Content="{Binding AddProviderText}"
                          Command="{Binding AddProviderCommand}" />
                  <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ProviderOptions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProviderOptionViewModel}">
                          <Button Classes="nav"
                                  ctl:SelectedClass.IsSelected="{Binding IsSelected}"
                                  Command="{Binding SelectCommand}"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  Margin="0,0,0,6"
                                  Padding="12,10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                              <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ProviderId}" Classes="mono" FontSize="{DynamicResource Ariadne.Size.Micro}" Opacity="0.85" />
                              </StackPanel>
                              <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center" Padding="8,2">
                                <TextBlock Text="{Binding KeyStatus}" Classes="caption" />
                              </Border>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>

                <!-- 当前供应商编辑 -->
                <StackPanel Grid.Column="1" Spacing="12">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Grid.Column="0" Text="{Binding ProviderEditorTitle}" Classes="subtitle" VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Classes="danger"
                            Content="{Binding RemoveProviderText}"
                            Command="{Binding RemoveProviderCommand}" />
                  </Grid>
                  <TextBlock Text="{Binding LegacyOtherProviderMessage}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding IsLegacyOtherProvider}" />
                  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="140,*" RowSpacing="12" ColumnSpacing="14" IsEnabled="{Binding IsProviderEditorEditable}">
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ProviderTypeLabel}" Classes="secondary" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              ItemsSource="{Binding ProviderTypeOptions}"
                              SelectedValue="{Binding ProviderType, Mode=TwoWay}"
                              SelectedValueBinding="{Binding Value}"
                              AutomationProperties.Name="{Binding ProviderTypeLabel}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingsValueOption">
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding ProviderDisplayNameLabel}" Classes="secondary" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ProviderDisplayName, Mode=TwoWay}"
                             AutomationProperties.Name="{Binding ProviderDisplayNameLabel}" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding BaseUrlLabel}" Classes="secondary" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Text="{Binding ProviderBaseUrl, Mode=TwoWay}"
                             PlaceholderText="{Binding BaseUrlPlaceholder}"
                             AutomationProperties.Name="{Binding BaseUrlLabel}"
                             AutomationProperties.HelpText="{Binding BaseUrlPlaceholder}" />
                    <WrapPanel Grid.Row="4" Grid.Column="1">
                      <CheckBox Margin="0,0,18,8" IsChecked="{Binding ProviderEnabled, Mode=TwoWay}" Content="{Binding ProviderEnabledText}" />
                    </WrapPanel>
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding ApiKeyLabel}" Classes="secondary" VerticalAlignment="Center" />
                    <!-- U205-E / U195-I：作者填完 key 想点「保存密钥」，右边紧挨着
                         就是不可逆的「吊销密钥」，`ColumnSpacing=10` 对两者一视同仁。
                         按同一条约定加组边界。danger 色已在区分"它是危险的"，
                         组边界区分的是"它不属于保存这一组"——两者不重复。 -->
                    <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                      <TextBox Grid.Column="0"
                               Text="{Binding ApiKey, Mode=TwoWay}"
                               PlaceholderText="{Binding ApiKeyPlaceholder}"
                               PasswordChar="*"
                               AutomationProperties.Name="{Binding ApiKeyLabel}"
                               AutomationProperties.HelpText="{Binding ApiKeyPlaceholder}" />
                      <Button Grid.Column="1" Classes="secondary" Content="{Binding SaveKeyText}" Command="{Binding SaveProviderKeyCommand}" />
                      <Border Grid.Column="2" Classes="group-divider" />
                      <Button Grid.Column="3" Classes="danger" Content="{Binding RevokeKeyText}" Command="{Binding RevokeProviderKeyCommand}" />
                    </Grid>
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding ProviderStatusLabel}" Classes="secondary" VerticalAlignment="Top" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ProviderStatus}" Classes="caption" TextWrapping="Wrap" />
                  </Grid>
                  <Expander Header="{Binding AdvancedSettingsText}">
                    <!-- U135：服务 ID 是后端分配的标识，用户永远改不了它。
                         原来用 `TextBox IsReadOnly="True"` 承载，而主题没有任何
                         `:readonly` 伪类样式，于是它与可编辑输入框像素级同款：
                         点一下同样亮 2px 强调色描边、同样抢走焦点、还照样占 Tab 停靠位，
                         但一个字也打不进去——最坏的一类假控件。
                         改为 SelectableTextBlock：无槽无边框（可编辑→有槽，只读→无槽），
                         仍可框选复制；Focusable=False 让它彻底退出焦点与 Tab 序列。 -->
                    <Grid Margin="0,10,0,0" ColumnDefinitions="140,*,Auto" ColumnSpacing="14">
                      <TextBlock Grid.Column="0" Text="{Binding ProviderIdLabel}" Classes="secondary" VerticalAlignment="Center" />
                      <SelectableTextBlock x:Name="ProviderIdDisplay"
                                           Grid.Column="1"
                                           Text="{Binding ProviderId}"
                                           Classes="mono"
                                           Focusable="False"
                                           IsTabStop="False"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           AutomationProperties.Name="{Binding ProviderIdLabel}" />
                      <!-- 只读值唯一的正当诉求是「拿出去用」，所以给一个显式复制动作，
                           而不是让用户去戳一个假输入框。文字按钮而非图标：
                           仓库没有 Copy 矢量 geometry，而图标字体在 Linux 上会渲染成豆腐块。 -->
                      <Button Grid.Column="2"
                              Classes="subtle"
                              Padding="8,3"
                              Content="{Binding CopyProviderIdText}"
                              Click="OnCopyProviderId"
                              ToolTip.Tip="{Binding CopyProviderIdText}"
                              AutomationProperties.Name="{Binding CopyProviderIdText}" />
                    </Grid>
                  </Expander>
                </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="settings-section" Padding="22" IsEnabled="{Binding IsProviderEditorEditable}">
              <StackPanel Spacing="12">
                <TextBlock x:Name="AvailableModelsSectionAnchor" Text="{Binding AvailableModelsSectionTitle}" Classes="subtitle" />
                <!-- U205-D：列定义多出的那个 Auto 是给数据行里「移除」前的组分隔线占位的。
                     表头与数据行的 ColumnDefinitions **必须逐字一致**，否则列宽各算一套、
                     表头文字会与它标注的那一列错开（这类错位不报错，只是看起来"标题写错了"）。 -->
                <Grid ColumnDefinitions="2*,150,105,105,105,Auto,Auto" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="{Binding ModelIdColumnLabel}" Classes="caption" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Text="{Binding ModelCapabilityColumnLabel}" Classes="caption" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="2" Text="{Binding ModelContextColumnLabel}" Classes="caption" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="3" Text="{Binding ModelInputCostColumnLabel}" Classes="caption" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="4" Text="{Binding ModelOutputCostColumnLabel}" Classes="caption" TextWrapping="Wrap" />
                </Grid>
                <ItemsControl ItemsSource="{Binding ProviderModels}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProviderModelEditorRow}">
                      <Grid ColumnDefinitions="2*,150,105,105,105,Auto,Auto" ColumnSpacing="8" Margin="0,3">
                        <StackPanel Grid.Column="0" Spacing="3">
                          <!-- U145：模型 ID 的候选就是刷新/测试连接从服务商拉回的目录，
                               产品已经知道这批 id，此前却让用户对着文档手抄。
                               仍可手打列表外的值——新模型常常还没进 /models 接口。 -->
                          <AutoCompleteBox Classes="identifier-picker"
                                           Text="{Binding ModelId, Mode=TwoWay}"
                                           ItemsSource="{Binding FetchedModelIdCandidates}"
                                           FilterMode="ContainsOrdinal"
                                           MinimumPrefixLength="0"
                                           IsTextCompletionEnabled="False"
                                           AutomationProperties.Name="{Binding ModelIdColumnLabel}"
                                           AutomationProperties.HelpText="{Binding ModelIdError}" />
                          <TextBlock Text="{Binding ModelIdError}" Classes="caption" Foreground="{DynamicResource Ariadne.StatusError}" IsVisible="{Binding HasModelIdError}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                          <ComboBox ItemsSource="{Binding ProviderCapabilityOptions}" SelectedValue="{Binding Capability, Mode=TwoWay}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Label}" AutomationProperties.Name="{Binding ModelCapabilityColumnLabel}" AutomationProperties.HelpText="{Binding CapabilityError}" />
                          <TextBlock Text="{Binding CapabilityError}" Classes="caption" Foreground="{DynamicResource Ariadne.StatusError}" IsVisible="{Binding HasCapabilityError}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="3">
                          <TextBox Text="{Binding MaxContextTokens, Mode=TwoWay}" AutomationProperties.Name="{Binding ModelContextColumnLabel}" AutomationProperties.HelpText="{Binding MaxContextTokensError}" />
                          <TextBlock Text="{Binding MaxContextTokensError}" Classes="caption" Foreground="{DynamicResource Ariadne.StatusError}" IsVisible="{Binding HasMaxContextTokensError}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="3">
                          <TextBox Text="{Binding InputCost, Mode=TwoWay}" AutomationProperties.Name="{Binding ModelInputCostColumnLabel}" AutomationProperties.HelpText="{Binding InputCostError}" />
                          <TextBlock Text="{Binding InputCostError}" Classes="caption" Foreground="{DynamicResource Ariadne.StatusError}" IsVisible="{Binding HasInputCostError}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Spacing="3">
                          <TextBox Text="{Binding OutputCost, Mode=TwoWay}" AutomationProperties.Name="{Binding ModelOutputCostColumnLabel}" AutomationProperties.HelpText="{Binding OutputCostError}" />
                          <TextBlock Text="{Binding OutputCostError}" Classes="caption" Foreground="{DynamicResource Ariadne.StatusError}" IsVisible="{Binding HasOutputCostError}" TextWrapping="Wrap" />
                        </StackPanel>
                        <!-- U205-D：删除键原先与同行 5 个输入控件等距 8px 并列 ⇒ 作者在改
                             上下文长度 / 单价这些数字时，**手指移动路径上就横着一个删除键**，
                             误点即丢掉整条模型配置（含已填的价格，重填要回服务商文档查）。
                             这里加一道组边界把「编辑这一行」与「删掉这一行」分开。
                             ⚠️ 刻意**不做成 hover 才显形**：那会让「哪些行可删」变得不可预知，
                             键盘/读屏用户更是完全找不到它（报告 D 条已权衡过这条路）。 -->
                        <Border Grid.Column="5" Classes="group-divider" />
                        <Button Grid.Column="6" Classes="subtle" Content="{Binding RemoveModelText}" Command="{Binding RemoveCommand}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="secondary" Content="{Binding AddModelText}" HorizontalAlignment="Left" Command="{Binding AddProviderModelCommand}" />
              </StackPanel>
            </Border>

            <Border Classes="settings-section" Padding="22" IsEnabled="{Binding IsProviderEditorEditable}">
              <StackPanel Spacing="14">
                <TextBlock x:Name="EmbeddingSectionAnchor" Text="{Binding EmbeddingSectionTitle}" Classes="subtitle" />
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="180,*" RowSpacing="12" ColumnSpacing="18">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DefaultLlmRouteLabel}" Classes="secondary" VerticalAlignment="Center" />
                  <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding DefaultLlmRouteOptions}" SelectedItem="{Binding SelectedDefaultLlmRoute, Mode=TwoWay}" AutomationProperties.Name="{Binding DefaultLlmRouteLabel}" DisplayMemberBinding="{Binding DisplayName}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding DefaultEmbeddingRouteLabel}" Classes="secondary" VerticalAlignment="Center" />
                  <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding DefaultEmbeddingRouteOptions}" SelectedItem="{Binding SelectedDefaultEmbeddingRoute, Mode=TwoWay}" AutomationProperties.Name="{Binding DefaultEmbeddingRouteLabel}" DisplayMemberBinding="{Binding DisplayName}" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding DefaultRerankerRouteLabel}" Classes="secondary" VerticalAlignment="Center" />
                  <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding DefaultRerankerRouteOptions}" SelectedItem="{Binding SelectedDefaultRerankerRoute, Mode=TwoWay}" AutomationProperties.Name="{Binding DefaultRerankerRouteLabel}" DisplayMemberBinding="{Binding DisplayName}" />
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding DefaultSearchRouteLabel}" Classes="secondary" VerticalAlignment="Center" />
                  <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding DefaultSearchRouteOptions}" SelectedItem="{Binding SelectedDefaultSearchRoute, Mode=TwoWay}" AutomationProperties.Name="{Binding DefaultSearchRouteLabel}" DisplayMemberBinding="{Binding DisplayName}" />
                </Grid>
              </StackPanel>
            </Border>

          </StackPanel>

          <StackPanel IsVisible="{Binding IsPresetsSelected}" Spacing="18">
            <TextBlock Text="{Binding PresetsTitle}" Classes="title" />
            <TextBlock Text="{Binding PresetScopeHelpText}" Classes="caption" TextWrapping="Wrap" />
            <Border Classes="settings-section" Padding="22" IsEnabled="{Binding IsPresetsEditable}">
              <StackPanel Spacing="12">
                <TextBlock x:Name="ModelAliasesSectionAnchor" Text="{Binding ModelAliasesTitle}" Classes="subtitle" />
                <TextBlock Text="{Binding ModelAliasesHelpText}" Classes="caption" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="1.2*,2*" ColumnSpacing="12">
                  <TextBlock Grid.Column="0" Text="{Binding ModelAliasTargetLabel}" Classes="caption" />
                  <TextBlock Grid.Column="1" Text="{Binding PresetNodeModelLabel}" Classes="caption" />
                </Grid>
                <ItemsControl ItemsSource="{Binding ModelAliases}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ModelAliasViewModel}">
                      <Grid ColumnDefinitions="1.2*,2*" ColumnSpacing="12" Margin="0,4,0,4">
                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableLlmModelTargetOptions}"
                                  SelectedItem="{Binding SelectedTargetOption, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding DisplayName}"
                                  HorizontalAlignment="Stretch">
                          <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WorkflowModelOption}">
                              <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="settings-section" Padding="22" IsEnabled="{Binding IsPresetsEditable}">
              <StackPanel Spacing="14">
                <TextBlock x:Name="DefaultsSectionAnchor" Text="{Binding DefaultsSectionTitle}" Classes="subtitle" />
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="180,*" RowSpacing="12" ColumnSpacing="18">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DefaultModelLabel}" Classes="secondary" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding AvailableLlmModelOptions}"
                          SelectedItem="{Binding SelectedDefaultModelOption, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding DefaultModelLabel}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:WorkflowModelOption}">
                      <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding DefaultTimeoutLabel}" Classes="secondary" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DefaultTimeoutMs, Mode=TwoWay}"
                         AutomationProperties.Name="{Binding DefaultTimeoutLabel}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding DefaultBudgetLabel}" Classes="secondary" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DefaultBudgetUsd, Mode=TwoWay}"
                         AutomationProperties.Name="{Binding DefaultBudgetLabel}" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="settings-section" Padding="22" IsEnabled="{Binding IsTemplateRepositoryEditable}">
              <StackPanel Spacing="14">
                <TextBlock x:Name="TemplatesSectionAnchor" Text="{Binding TemplatesSectionTitle}" Classes="subtitle" />
                <Grid ColumnDefinitions="180,*" ColumnSpacing="18">
                  <TextBlock Grid.Column="0" Text="{Binding TemplateRepositorySourceLabel}" Classes="secondary" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding TemplateRepositorySourceText}" VerticalAlignment="Center" />
                </Grid>
                <Button Classes="secondary"
                        HorizontalAlignment="Left"
                        Content="{Binding OpenTemplateMarketText}"
                        Command="{Binding OpenTemplateMarketCommand}" />
                <Expander Header="{Binding AdvancedTemplateRepositoryText}">
                  <StackPanel Margin="0,12,0,0" Spacing="12">
                    <TextBlock Text="{Binding TemplateRepositoryLabel}" Classes="secondary" />
                    <TextBox Text="{Binding TemplateRepositoryBaseUrl, Mode=TwoWay}"
                             AutomationProperties.Name="{Binding TemplateRepositoryLabel}" />
                    <!-- U205-E：「恢复官方模板库」（丢弃当前地址，不可撤销）与「保存」
                         原先等距 10px 并排 —— 与 U195-I（保存密钥/吊销密钥）是同一个写法。
                         本轮定下的约定：**不可逆操作不得与保存类操作等距并排**，
                         中间必须有一道可见的组边界（而不是把 10px 调成 20px：
                         量的差别在不同 DPI / 缩放下会退化，边界不会）。 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                      <Button Classes="secondary"
                              Content="{Binding RestoreOfficialTemplateRepositoryText}"
                              Command="{Binding RestoreOfficialTemplateRepositoryCommand}" />
                      <Border Classes="group-divider" />
                      <Button Classes="primary"
                              Content="{Binding SaveTemplateRepositoryText}"
                              Command="{Binding SaveTemplateRepositoryCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsAutomationSelected}" IsEnabled="{Binding IsAutomationEditable}" Spacing="18">
            <TextBlock Text="{Binding AutomationTitle}" Classes="title" />
            <TextBlock Text="{Binding AutomationScopeHelpText}" Classes="caption" TextWrapping="Wrap" />
            <Border Classes="settings-section" Padding="22">
              <StackPanel Spacing="14">
                <TextBlock x:Name="BudgetSectionAnchor" Text="{Binding BudgetSectionTitle}" Classes="subtitle" />
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="180,*" RowSpacing="12" ColumnSpacing="18">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding BudgetLabel}" Classes="secondary" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding BudgetUsd, Mode=TwoWay}"
                         ToolTip.Tip="{Binding BudgetHelpText}"
                         AutomationProperties.Name="{Binding BudgetLabel}"
                         AutomationProperties.HelpText="{Binding BudgetHelpText}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding PreauthorizedBudgetLabel}" Classes="secondary" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding PreauthorizedUsd, Mode=TwoWay}"
                         ToolTip.Tip="{Binding PreauthorizedHelpText}"
                         AutomationProperties.Name="{Binding PreauthorizedBudgetLabel}"
                         AutomationProperties.HelpText="{Binding PreauthorizedHelpText}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding SpentLabel}" Classes="secondary" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SpentText}" Classes="caption" VerticalAlignment="Center"
                           AutomationProperties.Name="{Binding SpentLabel}" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="settings-section" Padding="22">
              <StackPanel Spacing="14">
                <TextBlock x:Name="ConfirmationsSectionAnchor"
                           Text="{Binding ConfirmationsSectionTitle}"
                           Classes="subtitle"
                           ToolTip.Tip="{Binding ConfirmationPolicyHelpText}"
                           AutomationProperties.HelpText="{Binding ConfirmationPolicyHelpText}" />
                <Grid ColumnDefinitions="180,*" ColumnSpacing="14">
                  <TextBlock Grid.Column="0" Text="{Binding ConfirmationProfileLabel}" Classes="secondary" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1"
                            ItemsSource="{Binding ConfirmationProfileOptions}"
                            SelectedItem="{Binding SelectedConfirmationProfile, Mode=TwoWay}"
                            AutomationProperties.Name="{Binding ConfirmationProfileLabel}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:SettingsValueOption}">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
                <TextBlock Text="{Binding ConfirmationProfileHelpText}" Classes="caption" TextWrapping="Wrap" />
                <Expander Header="{Binding AdvancedConfirmationPoliciesText}"
                          IsExpanded="{Binding AreAdvancedConfirmationPoliciesExpanded, Mode=TwoWay}">
                  <StackPanel Spacing="10" Margin="0,8,0,0">
                <Grid ColumnDefinitions="*,180,180" ColumnSpacing="12">
                  <TextBlock Grid.Column="1" Text="{Binding NormalModeLabel}" Classes="caption" />
                  <TextBlock Grid.Column="2" Text="{Binding AutoModePolicyLabel}" Classes="caption" />
                </Grid>
                <!-- 按总结机制分组。 -->
                <ItemsControl ItemsSource="{Binding ConfirmationPolicyGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ConfirmationPolicyGroupViewModel}">
                      <!-- 原为无任何视觉属性的空 Border（纯 padding 壳），改回 StackPanel -->
                      <StackPanel Margin="0,4,0,10" Spacing="8">
                          <TextBlock Text="{Binding Title}" Classes="subtitle" FontWeight="SemiBold" />
                          <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="{x:Type vm:ConfirmationPolicyViewModel}">
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,180,180" ColumnSpacing="12" RowSpacing="8" Margin="0,3,0,10">
                                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                  <ComboBox Grid.Row="0" Grid.Column="1"
                                            ItemsSource="{Binding ConfirmationNormalPolicyOptions}"
                                            SelectedValue="{Binding NormalPolicySelection, Mode=TwoWay}"
                                            SelectedValueBinding="{Binding Value}"
                                            DisplayMemberBinding="{Binding Label}"
                                            AutomationProperties.Name="{Binding Label}"
                                            AutomationProperties.HelpText="{Binding NormalModeLabel}" />
                                  <ComboBox Grid.Row="0" Grid.Column="2"
                                            ItemsSource="{Binding ConfirmationAutoModePolicyOptions}"
                                            SelectedValue="{Binding AutoModePolicySelection, Mode=TwoWay}"
                                            SelectedValueBinding="{Binding Value}"
                                            DisplayMemberBinding="{Binding Label}"
                                            AutomationProperties.Name="{Binding Label}"
                                            AutomationProperties.HelpText="{Binding AutoModePolicyLabel}" />
                                  <Expander Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                            IsVisible="{Binding AutoModeAutoApproval}"
                                            IsEnabled="{Binding AutoModeAutoApproval}"
                                            IsExpanded="{Binding IsApprovalPromptExpanded, Mode=TwoWay}"
                                            Header="{Binding ApprovalPromptLabel}">
                                    <StackPanel Margin="0,6,0,0" Spacing="4">
                                      <TextBox Text="{Binding ApprovalPrompt, Mode=TwoWay}"
                                               PlaceholderText="{Binding ApprovalPromptPlaceholder}"
                                               AcceptsReturn="True"
                                               TextWrapping="Wrap"
                                               MinHeight="68"
                                               AutomationProperties.Name="{Binding ApprovalPromptLabel}"
                                               AutomationProperties.HelpText="{Binding ApprovalPromptError}" />
                                      <TextBlock Text="{Binding ApprovalPromptError}"
                                                 Classes="caption"
                                                 Foreground="{DynamicResource Ariadne.StatusError}"
                                                 IsVisible="{Binding HasApprovalPromptError}"
                                                 TextWrapping="Wrap" />
                                    </StackPanel>
                                  </Expander>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>

            <Border Classes="settings-section" Padding="22">
              <StackPanel Spacing="14">
                <TextBlock x:Name="RuntimeSectionAnchor" Text="{Binding RuntimeSectionTitle}" Classes="subtitle" />
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="220,*" RowSpacing="12" ColumnSpacing="18">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding WorkflowDefaultTimeoutLabel}" Classes="secondary" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding WorkflowDefaultTimeoutMs, Mode=TwoWay}"
                         AutomationProperties.Name="{Binding WorkflowDefaultTimeoutLabel}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding MaxLoopIterationsLabel}" Classes="secondary" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MaxLoopIterations, Mode=TwoWay}"
                         AutomationProperties.Name="{Binding MaxLoopIterationsLabel}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding MaxToolRoundsLabel}" Classes="secondary" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MaxToolRounds, Mode=TwoWay}"
                         AutomationProperties.Name="{Binding MaxToolRoundsLabel}" />
                <!-- U111：原第 3 行「运行态自动保存 (ms)」输入框已移除（2026-08-08）。
                     它是纯假开关——后端零消费点；而接线会削弱持久性（运行态现在每次
                     状态跃迁同步落盘，按 ms 节流会在崩溃时丢窗口内的跃迁），
                     故选择移除而非接线。 -->
                <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding CheckpointEnabled, Mode=TwoWay}" Content="{Binding CheckpointEnabledLabel}" />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding RunEventRetentionLabel}" Classes="secondary" VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding RunEventRetentionDays, Mode=TwoWay}"
                         AutomationProperties.Name="{Binding RunEventRetentionLabel}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsPermissionsSelected}" IsEnabled="{Binding IsPermissionsEditable}" Spacing="18">
            <TextBlock Text="{Binding PermissionsTitle}" Classes="title" />
            <TextBlock Text="{Binding PermissionsScopeHelpText}" Classes="caption" TextWrapping="Wrap" />
            <Border Classes="notice warning" Margin="0,0,0,4" IsVisible="{Binding HasCompatibilityPermissionScopes}">
              <TextBlock Text="{Binding CompatibilityPermissionScopesText}" Classes="caption" TextWrapping="Wrap" />
            </Border>
            <Border Classes="settings-section" Padding="22">
              <StackPanel Spacing="12">
                <!-- 小节标题去掉：PermissionProfileLabel 既做标题又做下方 ComboBox 的
                     字段名，屏上重复两遍。ComboBox 已有 AutomationProperties.Name，
                     语义无损。CapabilitiesSectionAnchor 也从这里移走——它本应落在
                     真正的「能力」标题上（见下方 CapabilitiesSectionTitle）。 -->
                <ComboBox ItemsSource="{Binding PermissionProfileOptions}"
                          SelectedItem="{Binding SelectedPermissionProfile, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.Name="{Binding PermissionProfileLabel}"
                          AutomationProperties.HelpText="{Binding PermissionProfileHelpText}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsValueOption}">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding PermissionProfileHelpText}"
                           Classes="caption"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Expander Header="{Binding AdvancedPermissionsText}"
                      IsExpanded="{Binding AreAdvancedPermissionsExpanded, Mode=TwoWay}">
              <StackPanel Margin="0,12,0,0" Spacing="18">
            <Border Classes="settings-section" Padding="22">
              <StackPanel Spacing="12">
                <!-- 索引锚点落在真正的「能力」标题上（原先错挂在权限档案标签，
                     导致左侧索引点「能力」会跳到上一小节）。 -->
                <TextBlock x:Name="CapabilitiesSectionAnchor"
                           Text="{Binding CapabilitiesSectionTitle}"
                           Classes="subtitle"
                           ToolTip.Tip="{Binding GlobalDefaultsHelpText}"
                           AutomationProperties.HelpText="{Binding GlobalDefaultsHelpText}" />
                <WrapPanel>
                  <CheckBox Margin="0,0,18,8" IsChecked="{Binding AllowNetwork, Mode=TwoWay}" Content="{Binding AllowNetworkText}" />
                  <CheckBox Margin="0,0,18,8" IsEnabled="{Binding AllowNetwork}" IsChecked="{Binding AllowWebSearch, Mode=TwoWay}" Content="{Binding AllowWebSearchText}" />
                  <CheckBox Margin="0,0,18,8" IsEnabled="{Binding AllowNetwork}" IsChecked="{Binding AllowHttpSkill, Mode=TwoWay}" Content="{Binding AllowHttpSkillText}" />
                  <CheckBox Margin="0,0,18,8" IsEnabled="{Binding AllowNetwork}" IsChecked="{Binding AllowWasmNetwork, Mode=TwoWay}" Content="{Binding AllowWasmNetworkText}" />
                  <CheckBox Margin="0,0,18,8" IsChecked="{Binding AllowSecretRead, Mode=TwoWay}" Content="{Binding AllowSecretReadText}" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding ScopedPermissionProfiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PermissionScopeProfileViewModel}">
                  <Border Classes="settings-section" Padding="22" Margin="0,0,0,14">
                    <StackPanel Spacing="12">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Classes="subtitle" />
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding InheritGlobal, Mode=TwoWay}"
                                  Content="{Binding InheritGlobalText}" />
                      </Grid>
                      <StackPanel IsEnabled="{Binding IsOverrideEnabled}" Spacing="12">
                        <WrapPanel>
                          <CheckBox Margin="0,0,18,8" IsChecked="{Binding AllowNetwork, Mode=TwoWay}" Content="{Binding AllowNetworkText}" />
                          <CheckBox Margin="0,0,18,8" IsEnabled="{Binding AllowNetwork}" IsChecked="{Binding AllowWebSearch, Mode=TwoWay}" Content="{Binding AllowWebSearchText}" />
                          <CheckBox Margin="0,0,18,8" IsEnabled="{Binding AllowNetwork}" IsChecked="{Binding AllowHttpSkill, Mode=TwoWay}" Content="{Binding AllowHttpSkillText}" />
                          <CheckBox Margin="0,0,18,8" IsEnabled="{Binding AllowNetwork}" IsChecked="{Binding AllowWasmNetwork, Mode=TwoWay}" Content="{Binding AllowWasmNetworkText}" />
                          <CheckBox Margin="0,0,18,8" IsChecked="{Binding AllowSecretRead, Mode=TwoWay}" Content="{Binding AllowSecretReadText}" />
                        </WrapPanel>
                        <!-- U146 站点 3/4（作用域权限覆盖）：文本框 + 外挂「浏览」按钮 → chip 列表。
                             「浏览」按钮收进模板内部了（chip 列表自带 BrowseCommand），
                             所以这里不再需要外层那个 Grid 分两列。 -->
                        <TextBlock Text="{Binding ReadableRootsLabel}"
                                   Classes="caption" />
                        <ContentControl Content="{Binding ReadableRootChips}"
                                        ContentTemplate="{StaticResource PathChipListTemplate}" />
                        <TextBlock Text="{Binding WritableRootsLabel}"
                                   Classes="caption" />
                        <ContentControl Content="{Binding WritableRootChips}"
                                        ContentTemplate="{StaticResource PathChipListTemplate}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="settings-section" Padding="22">
              <StackPanel Spacing="14">
                <TextBlock x:Name="ToolControlsSectionAnchor" Text="{Binding ToolControlsSectionTitle}" Classes="subtitle" />
                <ItemsControl ItemsSource="{Binding ToolControlGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ToolControlGroupViewModel}">
                      <StackPanel Spacing="10" Margin="0,0,0,18">
                        <TextBlock Text="{Binding DisplayName}" Classes="secondary" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SafeToolsTitle}"
                                   Classes="caption"
                                   IsVisible="{Binding HasSafeControls}" />
                        <ItemsControl ItemsSource="{Binding SafeControls}" IsVisible="{Binding HasSafeControls}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ToolControlItemViewModel}">
                              <CheckBox Margin="0,0,18,8"
                                        IsThreeState="{Binding CanInherit}"
                                        IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                        Content="{Binding DisplayName}"
                                        Classes.policy-blocked="{Binding IsBlockedByPolicy}"
                                        ToolTip.Tip="{Binding PolicyBlockedHint}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Classes="notice warning" IsVisible="{Binding HasDangerControls}" Margin="0,6,0,0">
                          <StackPanel Spacing="8">
                            <TextBlock Text="{Binding DangerToolsTitle}"
                                       Foreground="{DynamicResource Ariadne.StatusWarning}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DangerToolsHelp}"
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding DangerControls}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ToolControlItemViewModel}">
                                  <CheckBox Margin="0,0,18,8"
                                            IsThreeState="{Binding CanInherit}"
                                            IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                            Content="{Binding DisplayName}"
                                            Foreground="{DynamicResource Ariadne.StatusWarning}"
                                            ToolTip.Tip="{Binding PolicyBlockedHint}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <!-- U164-A：节点类型预设从「预设」页搬到这里。
                 它的主体是按节点类型的权限覆盖 + 工具覆盖，与上方 tool_controls（全局工具）、
                 下方 paths 是同一组概念的不同作用域；分在两页时用户要弄清
                 「这个节点能不能联网」得来回切页签。
                 ⚠️ IsEnabled 仍绑 IsPresetsEditable 而不是 IsPermissionsEditable：
                 页签归属是 UI 概念，脏页/保存 section 是数据概念，两者刻意不统一——
                 这些字段仍由 presets section 写回（SavePresetsAsync）。
                 顺手「统一」成 IsPermissionsEditable 会在预设读取失败、权限读取成功时
                 放开一片没有基线的表单。 -->
            <Border Classes="settings-section" Padding="22" IsEnabled="{Binding IsPresetsEditable}">
              <StackPanel Spacing="12">
                <TextBlock x:Name="NodePresetsSectionAnchor" Text="{Binding NodePresetsSectionTitle}" Classes="subtitle" />
                <Grid ColumnDefinitions="1.2*,2*,130,120" ColumnSpacing="12">
                  <TextBlock Grid.Column="0" Text="{Binding PresetNodeTypeLabel}" Classes="caption" />
                  <TextBlock Grid.Column="1" Text="{Binding PresetNodeModelLabel}" Classes="caption" />
                  <TextBlock Grid.Column="2" Text="{Binding PresetNodeTimeoutLabel}" Classes="caption" />
                  <TextBlock Grid.Column="3" Text="{Binding PresetNodeBudgetLabel}" Classes="caption" />
                </Grid>
                <ItemsControl ItemsSource="{Binding NodePresets}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NodeTypePresetViewModel}">
                      <StackPanel Spacing="8" Margin="0,4,0,10">
                        <Grid ColumnDefinitions="1.2*,2*,130,120" ColumnSpacing="12">
                          <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" TextWrapping="Wrap" />
                          <ComboBox Grid.Column="1"
                                    ItemsSource="{Binding AvailableLlmModelOptions}"
                                    SelectedItem="{Binding SelectedModelOption, Mode=TwoWay}"
                                    AutomationProperties.Name="{Binding PresetNodeModelLabel}"
                                    HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                              <DataTemplate DataType="{x:Type vm:WorkflowModelOption}">
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <TextBox Grid.Column="2"
                                   Text="{Binding TimeoutMs, Mode=TwoWay}"
                                   AutomationProperties.Name="{Binding PresetNodeTimeoutLabel}" />
                          <TextBox Grid.Column="3"
                                   Text="{Binding BudgetUsd, Mode=TwoWay}"
                                   AutomationProperties.Name="{Binding PresetNodeBudgetLabel}" />
                        </Grid>
                        <Expander Header="{Binding PresetAccessTitle}">
                          <Border Classes="detail-row accent" Margin="0,8,0,2" Padding="14,3,0,3">
                            <StackPanel Spacing="10">
                              <CheckBox IsChecked="{Binding Permissions.InheritGlobal, Mode=TwoWay}"
                                        Content="{Binding Permissions.InheritNodePermissionsText}" />
                              <StackPanel IsEnabled="{Binding Permissions.IsOverrideEnabled}" Spacing="8">
                                <WrapPanel>
                                  <CheckBox Margin="0,0,18,8" IsChecked="{Binding Permissions.AllowNetwork, Mode=TwoWay}" Content="{Binding Permissions.AllowNetworkText}" />
                                  <CheckBox Margin="0,0,18,8" IsEnabled="{Binding Permissions.AllowNetwork}" IsChecked="{Binding Permissions.AllowWebSearch, Mode=TwoWay}" Content="{Binding Permissions.AllowWebSearchText}" />
                                  <CheckBox Margin="0,0,18,8" IsEnabled="{Binding Permissions.AllowNetwork}" IsChecked="{Binding Permissions.AllowHttpSkill, Mode=TwoWay}" Content="{Binding Permissions.AllowHttpSkillText}" />
                                  <CheckBox Margin="0,0,18,8" IsEnabled="{Binding Permissions.AllowNetwork}" IsChecked="{Binding Permissions.AllowWasmNetwork, Mode=TwoWay}" Content="{Binding Permissions.AllowWasmNetworkText}" />
                                  <CheckBox Margin="0,0,18,8" IsChecked="{Binding Permissions.AllowSecretRead, Mode=TwoWay}" Content="{Binding Permissions.AllowSecretReadText}" />
                                </WrapPanel>
                                <!-- U146 站点 1/2（节点预设的权限覆盖）：换行分隔文本框 → chip 列表。
                                     标签是必须的：原先只有 AutomationProperties.Name，
                                     视力正常的用户靠 PlaceholderText 猜这框是「可读」还是「可写」。 -->
                                <TextBlock Text="{Binding Permissions.ReadableRootsLabel}"
                                           Classes="caption" />
                                <ContentControl Content="{Binding Permissions.ReadableRootChips}"
                                                ContentTemplate="{StaticResource PathChipListTemplate}" />
                                <TextBlock Text="{Binding Permissions.WritableRootsLabel}"
                                           Classes="caption" />
                                <ContentControl Content="{Binding Permissions.WritableRootChips}"
                                                ContentTemplate="{StaticResource PathChipListTemplate}" />
                              </StackPanel>
                              <TextBlock Text="{Binding PresetToolsTitle}" Classes="caption" FontWeight="SemiBold" />
                              <ItemsControl ItemsSource="{Binding ToolControls}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="{x:Type vm:ToolControlItemViewModel}">
                                    <CheckBox Margin="0,0,18,8"
                                              IsThreeState="True"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              Content="{Binding DisplayName}" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>
                        </Expander>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Classes="settings-section" Padding="22">
              <StackPanel Spacing="14">
                <TextBlock x:Name="PathsSectionAnchor" Text="{Binding PathsSectionTitle}" Classes="subtitle" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="8">
                  <TextBlock Text="{Binding ReadableRootsLabel}" Classes="secondary" />
                  <!-- U146 站点 5（全局可读根）：chip 列表自带添加 / 浏览，原「浏览」按钮并入模板。 -->
                  <ContentControl Content="{Binding ReadableRootChips}"
                                  ContentTemplate="{StaticResource PathChipListTemplate}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                  <TextBlock Text="{Binding WritableRootsLabel}" Classes="secondary" />
                  <!-- U146 站点 6（全局可写根） -->
                  <ContentControl Content="{Binding WritableRootChips}"
                                  ContentTemplate="{StaticResource PathChipListTemplate}" />
                </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <!-- U176：凭据保护的补救入口。
                 原缺陷是一条死胡同：新项目默认就是 Locked（secrets.rs:584-588），
                 此时保存 Provider 密钥必定失败，诊断文案
                 `ui.settings.misc.diagnostics.recovery.secrets` 让用户
                 「在配置页为密钥配置本地主密码」——而配置页根本没有这个入口。
                 后端两条命令一直都在（ipc.rs:924/:931），缺的只是前端三层接线。

                 IsEnabled 刻意**不绑** IsPermissionsEditable：这两个动作是即时命令，
                 不依赖权限 section 的读取基线。若权限读取失败就把它们灰掉，
                 恰恰会在「后端有问题」的时候锁死用户唯一的补救出路——
                 与本条缺陷同型（把补救入口挡在故障后面）。 -->
            <Border Classes="settings-section" Padding="22">
              <StackPanel Spacing="12">
                <TextBlock x:Name="SecretProtectionSectionAnchor"
                           Text="{Binding SecretProtectionTitle}"
                           Classes="subtitle" />
                <SelectableTextBlock Text="{Binding SecretProtectionStatusText}"
                                     Classes="caption"
                                     TextWrapping="Wrap"
                                     AutomationProperties.LiveSetting="Polite" />
                <!-- 锁定态要把「保存密钥会失败」直说，不能只摆两个按钮让用户猜该点哪个。 -->
                <Border Classes="notice warning" IsVisible="{Binding IsSecretStoreLocked}">
                  <TextBlock Text="{Binding SecretStoreLockedHint}"
                             Classes="caption"
                             TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="{Binding SecretMasterPasswordLabel}" Classes="secondary" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBox Grid.Column="0"
                           Text="{Binding SecretMasterPassword, Mode=TwoWay}"
                           PlaceholderText="{Binding SecretMasterPasswordPlaceholder}"
                           PasswordChar="*"
                           AutomationProperties.Name="{Binding SecretMasterPasswordLabel}"
                           AutomationProperties.HelpText="{Binding SecretMasterPasswordHint}">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding SetSecretMasterPasswordCommand}" />
                    </TextBox.KeyBindings>
                  </TextBox>
                  <Button Grid.Column="1"
                          Classes="secondary"
                          Content="{Binding SetSecretMasterPasswordText}"
                          Command="{Binding SetSecretMasterPasswordCommand}" />
                </Grid>
                <!-- 说明里含「进程内存、重启要重输」与「忘记不可恢复」两件事，
                     两条都查证过后端行为，不是保险话术：主密码无任何写盘点，
                     后端也没有任何重置/找回命令。 -->
                <TextBlock Text="{Binding SecretMasterPasswordHint}"
                           Classes="caption"
                           TextWrapping="Wrap" />
                <!-- 明文那条的警告用 StatusWarning：它是「你正在放弃一层保护」，
                     不是操作失败，所以不取 StatusError。 -->
                <TextBlock Text="{Binding AllowPlaintextSecretsWarning}"
                           Classes="caption"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Ariadne.StatusWarning}" />
                <Button Classes="danger"
                        HorizontalAlignment="Left"
                        Content="{Binding AllowPlaintextSecretsText}"
                        Command="{Binding AllowUnprotectedSecretsCommand}" />
              </StackPanel>
            </Border>
              </StackPanel>
            </Expander>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsPersonalizationSelected}" IsEnabled="{Binding IsPersonalizationEditable}" Spacing="18">
            <TextBlock Text="{Binding PersonalizationTitle}" Classes="title" />
            <TextBlock Text="{Binding PersonalizationScopeHelpText}" Classes="caption" TextWrapping="Wrap" />
            <Border Classes="settings-section" Padding="22">
              <StackPanel Spacing="14">
                <TextBlock x:Name="LanguageSectionAnchor" Text="{Binding LanguageSectionTitle}" Classes="subtitle" />
                <Grid ColumnDefinitions="180,*" ColumnSpacing="18">
                  <TextBlock Grid.Column="0" Text="{Binding LanguageLabel}" Classes="secondary" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1"
                            ItemsSource="{Binding LanguageOptions}"
                            SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                            SelectedValueBinding="{Binding Code}"
                            AutomationProperties.Name="{Binding LanguageLabel}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:LanguageOption}">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </StackPanel>
            </Border>
            <!-- 调色板：对齐 settings-theme-spec §6，分组 swatch 卡片（无 WebUI） -->
            <Border Classes="settings-section" Padding="22">
              <StackPanel Spacing="18">
                <TextBlock x:Name="ThemeSectionAnchor"
                           Text="{Binding ThemeSectionTitle}"
                           Classes="subtitle"
                           ToolTip.Tip="{Binding ThemePaletteHelpText}"
                           AutomationProperties.HelpText="{Binding ThemePaletteHelpText}" />

                <!-- 按组排版的调色板卡片 -->
                <ItemsControl ItemsSource="{Binding ThemeGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ThemeGroupViewModel}">
                      <StackPanel Spacing="10" Margin="0,0,0,16">
                        <TextBlock Text="{Binding Title}" Classes="secondary" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Options}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ThemeOption}">
                              <Button Classes="theme-swatch"
                                      ctl:SelectedClass.IsSelected="{Binding IsSelected}"
                                      Command="{Binding SelectCommand}"
                                      Margin="0,0,10,10"
                                      MinHeight="118"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Padding="14,12">
                                <StackPanel Spacing="8">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <Border Grid.Column="1" Width="10" Height="10" CornerRadius="5"
                                            Background="{DynamicResource Ariadne.AccentPrimary}"
                                            IsVisible="{Binding IsSelected}"
                                            VerticalAlignment="Top" Margin="6,2,0,0" />
                                  </Grid>
                                  <Border Height="28" CornerRadius="{DynamicResource Ariadne.Radius.Medium}" ClipToBounds="True">
                                    <Grid ColumnDefinitions="*,*,*">
                                      <Border Grid.Column="0" Background="{Binding SwatchMain}" />
                                      <Border Grid.Column="1" Background="{Binding SwatchSurface}" />
                                      <Border Grid.Column="2" Background="{Binding SwatchBrand}" />
                                    </Grid>
                                  </Border>
                                  <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" Opacity="0.9" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 主题自定义三色：折叠色块点开调色板；可跟随系统并分别调昼/夜 -->
                <Border Height="1" Background="{DynamicResource Ariadne.BorderMuted}" Margin="0,4" />
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding ThemeCustomThreeLabel}" Classes="subtitle" />
                  <TextBlock Text="{Binding ThemeCustomThreeHint}" Classes="caption" TextWrapping="Wrap" />
                </StackPanel>
                <Border Classes="detail-row accent" Margin="0,2,0,4" Padding="14,3,0,3">
                  <StackPanel Spacing="12">
                    <CheckBox IsChecked="{Binding ThemeFollowSystemColors, Mode=TwoWay}"
                              Content="{Binding ThemeFollowSystemColorsText}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ThemeFollowSystemColors}">
                      <Button Classes="tab"
                              ctl:SelectedClass.IsSelected="{Binding IsEditingDayThemeColors}"
                              Content="{Binding ThemeEditDayText}"
                              Command="{Binding SelectThemeEditDayCommand}"
                              MinWidth="72" Padding="12,6" />
                      <Button Classes="tab"
                              ctl:SelectedClass.IsSelected="{Binding IsEditingNightThemeColors}"
                              Content="{Binding ThemeEditNightText}"
                              Command="{Binding SelectThemeEditNightCommand}"
                              MinWidth="72" Padding="12,6" />
                    </StackPanel>
                    <UniformGrid Columns="3" Margin="0,0,0,4">
                      <Button Classes="theme-color-slot"
                              ctl:SelectedClass.IsSelected="{Binding IsThemeMainChannelActive}"
                              Command="{Binding SelectThemeMainChannelCommand}"
                              Margin="0,0,8,0"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Padding="10,8">
                        <StackPanel Spacing="6">
                          <TextBlock Text="{Binding ThemeMainColorLabel}" Classes="caption" />
                          <Border Height="28" CornerRadius="{DynamicResource Ariadne.Radius.Medium}"
                                  Background="{Binding ThemeMainColorEditor.PreviewBrush}"
                                  BorderBrush="{DynamicResource Ariadne.BorderDefault}"
                                  BorderThickness="{DynamicResource Ariadne.Stroke.HairlineAll}" />
                        </StackPanel>
                      </Button>
                      <Button Classes="theme-color-slot"
                              ctl:SelectedClass.IsSelected="{Binding IsThemeSurfaceChannelActive}"
                              Command="{Binding SelectThemeSurfaceChannelCommand}"
                              Margin="0,0,8,0"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Padding="10,8">
                        <StackPanel Spacing="6">
                          <TextBlock Text="{Binding ThemeSurfaceColorLabel}" Classes="caption" />
                          <Border Height="28" CornerRadius="{DynamicResource Ariadne.Radius.Medium}"
                                  Background="{Binding ThemeSurfaceColorEditor.PreviewBrush}"
                                  BorderBrush="{DynamicResource Ariadne.BorderDefault}"
                                  BorderThickness="{DynamicResource Ariadne.Stroke.HairlineAll}" />
                        </StackPanel>
                      </Button>
                      <Button Classes="theme-color-slot"
                              ctl:SelectedClass.IsSelected="{Binding IsThemeBrandChannelActive}"
                              Command="{Binding SelectThemeBrandChannelCommand}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Padding="10,8">
                        <StackPanel Spacing="6">
                          <TextBlock Text="{Binding ThemeBrandColorLabel}" Classes="caption" />
                          <Border Height="28" CornerRadius="{DynamicResource Ariadne.Radius.Medium}"
                                  Background="{Binding ThemeBrandColorEditor.PreviewBrush}"
                                  BorderBrush="{DynamicResource Ariadne.BorderDefault}"
                                  BorderThickness="{DynamicResource Ariadne.Stroke.HairlineAll}" />
                        </StackPanel>
                      </Button>
                    </UniformGrid>
                    <!-- 折叠色块；点击弹出完整调色板（无全页变黑） -->
                    <ctl:SpectrumColorPicker SelectedHex="{Binding ActiveThemeColorHex, Mode=TwoWay}"
                                             AccessibleName="{Binding ActiveThemeColorLabel}" />
                  </StackPanel>
                </Border>

                <Border Height="1" Background="{DynamicResource Ariadne.BorderMuted}" Margin="0,4" />
                <TextBlock Text="{Binding ColorMapHintText}" Classes="caption" TextWrapping="Wrap" />

                <!-- Git 自动色 -->
                <StackPanel Spacing="8" Margin="0,4,0,0">
                  <TextBlock Text="{Binding GitAutoColorLabel}" Classes="secondary" FontWeight="SemiBold" />
                  <ctl:SpectrumColorPicker SelectedHex="{Binding GitAutoColor, Mode=TwoWay}"
                                           AccessibleName="{Binding GitAutoColorLabel}" />
                </StackPanel>

                <!-- Git 手动色 -->
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding GitManualColorLabel}" Classes="secondary" FontWeight="SemiBold" />
                  <ctl:SpectrumColorPicker SelectedHex="{Binding GitManualColor, Mode=TwoWay}"
                                           AccessibleName="{Binding GitManualColorLabel}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Classes="settings-section" Padding="22">
              <StackPanel Spacing="14">
                <TextBlock x:Name="WorkspaceSectionAnchor" Text="{Binding WorkspaceSectionTitle}" Classes="subtitle" />
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="180,*" RowSpacing="12" ColumnSpacing="18">
                  <CheckBox Grid.Row="0" Grid.Column="1"
                            IsChecked="{Binding ProjectPanelVisible, Mode=TwoWay}"
                            Content="{Binding ProjectPanelVisibleText}" />
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                    <CheckBox IsChecked="{Binding ReduceMotion, Mode=TwoWay}"
                              Content="{Binding ReduceMotionText}" />
                    <TextBlock Text="{Binding ReduceMotionHintText}"
                               Classes="caption"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsRetrievalSelected}" Spacing="18">
            <TextBlock Text="{Binding RetrievalTitle}" Classes="title" />
            <Border Classes="settings-section" Padding="22" IsEnabled="{Binding IsRetrievalEditable}">
              <StackPanel Spacing="14">
                <TextBlock x:Name="RetrievalSectionAnchor" Text="{Binding RetrievalSectionTitle}" Classes="subtitle" />
                <TextBlock Text="{Binding RetrievalScopeHelpText}" Classes="caption" TextWrapping="Wrap" />
                <CheckBox IsChecked="{Binding VectorEnabled, Mode=TwoWay}" Content="{Binding VectorEnabledText}" />
                <StackPanel Spacing="12" IsVisible="{Binding IsVectorConfigurationVisible}">
                  <Grid ColumnDefinitions="220,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="{Binding VectorBackendLabel}" Classes="secondary" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding VectorBackendOptions}"
                              SelectedValue="{Binding VectorBackend, Mode=TwoWay}"
                              SelectedValueBinding="{Binding Value}"
                              AutomationProperties.Name="{Binding VectorBackendLabel}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingsValueOption">
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>
                  <Grid ColumnDefinitions="220,*" ColumnSpacing="18" IsVisible="{Binding IsExternalQdrantBackend}">
                    <StackPanel Grid.Column="0" Spacing="12">
                      <TextBlock Text="{Binding QdrantHostLabel}" Classes="secondary" Height="34" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding QdrantPortLabel}" Classes="secondary" Height="34" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding QdrantAuthModeLabel}" Classes="secondary" Height="34" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="12">
                      <TextBox Text="{Binding QdrantHost, Mode=TwoWay}" AutomationProperties.Name="{Binding QdrantHostLabel}" />
                      <TextBox Text="{Binding QdrantPort, Mode=TwoWay}" AutomationProperties.Name="{Binding QdrantPortLabel}" />
                      <ComboBox ItemsSource="{Binding QdrantAuthModeOptions}"
                                SelectedValue="{Binding QdrantAuthMode, Mode=TwoWay}"
                                SelectedValueBinding="{Binding Value}"
                                AutomationProperties.Name="{Binding QdrantAuthModeLabel}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:SettingsValueOption">
                            <TextBlock Text="{Binding Label}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                  </Grid>
                  <CheckBox IsChecked="{Binding QdrantUseTls, Mode=TwoWay}"
                            Content="{Binding QdrantTlsText}"
                            IsVisible="{Binding IsExternalQdrantBackend}" />
                  <Grid ColumnDefinitions="220,*" ColumnSpacing="18" IsVisible="{Binding IsQdrantApiKeyAuth}">
                    <TextBlock Grid.Column="0" Text="{Binding QdrantApiKeyLabel}" Classes="secondary" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBox Text="{Binding QdrantApiKey, Mode=TwoWay}"
                               PlaceholderText="{Binding QdrantApiKeyPlaceholder}"
                               PasswordChar="*"
                               AutomationProperties.Name="{Binding QdrantApiKeyLabel}"
                               AutomationProperties.HelpText="{Binding QdrantApiKeyErrorText}" />
                      <TextBlock Text="{Binding QdrantApiKeyErrorText}"
                                 Classes="caption"
                                 Foreground="{DynamicResource Ariadne.StatusError}"
                                 IsVisible="{Binding HasQdrantApiKeyError}"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding QdrantApiKeyStatusText}" Classes="caption" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
                <Expander Header="{Binding AdvancedSettingsText}"
                          IsExpanded="{Binding AreAdvancedRetrievalSettingsExpanded, Mode=TwoWay}">
                  <Grid Margin="0,12,0,0" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="220,*" RowSpacing="12" ColumnSpacing="18">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding VectorCollectionLabel}" Classes="secondary" VerticalAlignment="Center" IsVisible="{Binding IsVectorConfigurationVisible}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding VectorCollection, Mode=TwoWay}" IsVisible="{Binding IsVectorConfigurationVisible}" AutomationProperties.Name="{Binding VectorCollectionLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding VectorDimensionsLabel}" Classes="secondary" VerticalAlignment="Center" IsVisible="{Binding IsVectorConfigurationVisible}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding VectorDimensions, Mode=TwoWay}" IsVisible="{Binding IsVectorConfigurationVisible}" AutomationProperties.Name="{Binding VectorDimensionsLabel}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding QdrantDataDirLabel}" Classes="secondary" VerticalAlignment="Center" IsVisible="{Binding IsQdrantSidecarBackend}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding QdrantDataDir, Mode=TwoWay}" IsVisible="{Binding IsQdrantSidecarBackend}" AutomationProperties.Name="{Binding QdrantDataDirLabel}" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding ChunkSizeLabel}" Classes="secondary" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ChunkSizeChars, Mode=TwoWay}" AutomationProperties.Name="{Binding ChunkSizeLabel}" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding ChunkOverlapLabel}" Classes="secondary" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ChunkOverlapChars, Mode=TwoWay}" AutomationProperties.Name="{Binding ChunkOverlapLabel}" />
                  </Grid>
                </Expander>
                <CheckBox IsChecked="{Binding RerankerEnabled, Mode=TwoWay}" Content="{Binding RerankerEnabledText}" />
              </StackPanel>
            </Border>
            <Border Classes="settings-section" Padding="22" IsEnabled="{Binding IsAppRuntimeEditable}">
              <StackPanel Spacing="14">
                <TextBlock x:Name="AppRuntimeSectionAnchor" Text="{Binding AppRuntimeSectionTitle}" Classes="subtitle" />
                <TextBlock Text="{Binding AppRuntimeScopeHelpText}" Classes="caption" TextWrapping="Wrap" />
                <Expander Header="{Binding AdvancedSettingsText}"
                          IsExpanded="{Binding AreAdvancedAppRuntimeSettingsExpanded, Mode=TwoWay}">
                  <Grid Margin="0,12,0,0" RowDefinitions="Auto,Auto" ColumnDefinitions="220,*" RowSpacing="12" ColumnSpacing="18">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding QdrantBinaryPathLabel}" Classes="secondary" VerticalAlignment="Center" />
                    <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBox Grid.Column="0" Text="{Binding QdrantBinaryPath, Mode=TwoWay}" AutomationProperties.Name="{Binding QdrantBinaryPathLabel}" />
                      <Button Grid.Column="1" Classes="secondary" Content="{Binding BrowseFileText}" Command="{Binding BrowseQdrantBinaryCommand}" />
                    </Grid>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding QdrantStartupTimeoutLabel}" Classes="secondary" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding QdrantStartupTimeoutMs, Mode=TwoWay}" AutomationProperties.Name="{Binding QdrantStartupTimeoutLabel}" />
                  </Grid>
                </Expander>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsVersionControlSelected}" Spacing="18">
            <TextBlock Text="{Binding VersionControlTitle}" Classes="title" />
            <Border Classes="settings-section" Padding="22" IsEnabled="{Binding IsGitEditable}">
              <StackPanel Spacing="14">
                <TextBlock x:Name="GitSectionAnchor" Text="{Binding GitSectionTitle}" Classes="subtitle" />
                <WrapPanel>
                  <CheckBox Margin="0,0,18,8" IsChecked="{Binding TrackDocuments, Mode=TwoWay}" Content="{Binding TrackDocumentsText}" />
                  <CheckBox Margin="0,0,18,8" IsChecked="{Binding TrackWorkflows, Mode=TwoWay}" Content="{Binding TrackWorkflowsText}" />
                  <CheckBox Margin="0,0,18,8" IsChecked="{Binding TrackSkills, Mode=TwoWay}" Content="{Binding TrackSkillsText}" />
                  <CheckBox Margin="0,0,18,8" IsChecked="{Binding TrackNonSensitiveConfig, Mode=TwoWay}" Content="{Binding TrackConfigText}" />
                </WrapPanel>
                <TextBlock Text="{Binding IgnoredPathsLabel}" Classes="secondary" />
                <!-- U146 站点 7（Git 忽略路径）：这些是项目内相对路径，
                     所以 chip 列表建在 requireAbsolute=false 上；体检时会拼上项目根再看存在性。 -->
                <ContentControl Content="{Binding IgnoredPathChips}"
                                ContentTemplate="{StaticResource PathChipListTemplate}" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsSupportSelected}" Spacing="18">
            <TextBlock Text="{Binding SupportTitle}" Classes="title" />
            <Border Classes="settings-section" Padding="22">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock x:Name="DiagnosticsSectionAnchor" Text="{Binding DiagnosticsSectionTitle}" Classes="subtitle" />
                    <TextBlock Text="{Binding DiagnosticsStatusText}" Classes="caption" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Classes="secondary"
                          Content="{Binding RefreshDiagnosticsText}"
                          Command="{Binding RefreshDiagnosticsCommand}" />
                  <Button Grid.Column="2"
                          Classes="secondary"
                          Content="{Binding CopyDiagnosticsText}"
                          IsEnabled="{Binding HasDiagnosticsItems}"
                          Click="OnCopyDiagnostics" />
                </Grid>
                <TextBlock Text="{Binding DiagnosticsEmptyText}"
                           Classes="caption"
                           IsVisible="{Binding !HasDiagnosticsItems}" />
                <ItemsControl ItemsSource="{Binding DiagnosticsItems}"
                              IsVisible="{Binding HasDiagnosticsItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsDiagnosticItemViewModel}">
                      <!-- 诊断行：N 条各自套盒 → 竖脊明细行 -->
                      <Border Classes="detail-row">
                        <Grid ColumnDefinitions="1.1*,110,2*,2*" ColumnSpacing="12">
                          <TextBlock Grid.Column="0" Text="{Binding Component}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="caption" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="2" Text="{Binding Reason}" Classes="caption" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="3" Text="{Binding RecoveryAction}" Classes="caption" TextWrapping="Wrap" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Classes="settings-section" Padding="22">
              <StackPanel Spacing="14">
                <TextBlock x:Name="TutorialSectionAnchor" Text="{Binding TutorialText}" Classes="subtitle" />
                <Button Classes="secondary" HorizontalAlignment="Left" Content="{Binding OpenTutorialText}" Command="{Binding ShowTutorialCommand}" AutomationProperties.Name="{Binding OpenTutorialText}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Panel>
        </StackPanel>
      </ScrollViewer>

      <!-- U178-A：首次加载骨架态。
           配置页 LoadAsync 一次并发发 14+ 次 IPC，此前这段等待里页面是空白的
           （`IsLoading` 有实现、有维护，但本文件全文零引用 ⇒ 界面上没有消费点）。
           现在铺三条占位行，用户看到的是「在读」而不是「空的」。

           为什么绑 ShowLoadingSkeleton 而不是 IsLoading：「取消改动」也会置真
           IsLoading，那时页面上已有真实值，抽走再放回来比不做过渡更糟。
           骨架只在「还没有任何分区落过值」时铺，先到的分区立刻显示。

           形状刻意用等宽递减的三条圆角块（宽度 260/200/320）：它模仿的是下面
           「标签 + 输入行」的排布节奏，不是通用 loading 图形——骨架要能预告
           即将出现的东西，否则只是另一种空白。 -->
      <Border IsVisible="{Binding ShowLoadingSkeleton}"
              IsHitTestVisible="False"
              Padding="196,26,36,32"
              VerticalAlignment="Top"
              HorizontalAlignment="Stretch">
        <StackPanel Spacing="18" MaxWidth="1040" HorizontalAlignment="Left">
          <TextBlock Text="{Binding LoadingText}"
                     Classes="subtitle"
                     AutomationProperties.LiveSetting="Polite"
                     AutomationProperties.Name="{Binding LoadingText}" />
          <TextBlock Text="{Binding LoadingHintText}"
                     Classes="caption"
                     Foreground="{DynamicResource Ariadne.TextSubtle}" />
          <StackPanel Spacing="12" Margin="0,6,0,0">
            <Border Classes="settings-skeleton-row" Width="260" />
            <Border Classes="settings-skeleton-row" Width="200" />
            <Border Classes="settings-skeleton-row" Width="320" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 章节索引：贴左缘垂直居中，无浮层无描边无投影——文字直接悬在空白上，
           靠左侧一条细导轨成列。索引是导览而非控件，给它一个面反而抢走正文的主次。
           窄窗（Window.compact）下仍整块隐藏。
           U162-F：**去掉了 MaxHeight="470"**，不换成 token 也不加转换器。
           470 是魔数（不随字号走，调大正文字号后版心跟不上），而它想表达的
           「不超过内容区高度」本就是**默认行为**：这个 Border 在 Panel 里
           VerticalAlignment=Center，测量约束已经是「Panel 高减去 24+24 边距」，
           ListBox 自带的 ScrollViewer(Auto) 会在超出时接手。
           顺带一条事实：当前每个页签最多 4 个小节（SettingsNavigationCatalog），
           实测高度约 124px，470 这个上限**从来没有生效过**——
           它是个既是魔数又不起作用的数字，删掉比包装成 token 更诚实。 -->
      <Border Classes="settings-index-rail"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Margin="18,24,0,24"
              Width="166"
              Background="Transparent">
        <ListBox x:Name="SettingsSectionIndex"
                 Classes="settings-section-index"
                 ItemsSource="{Binding CurrentTabSectionIndexItems}"
                 SelectedItem="{Binding SectionNavigationSelection, Mode=TwoWay}"
                 SelectionMode="Single"
                 HorizontalAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsSectionNavigationItemViewModel}">
              <!-- 左侧导轨段（2px 竖线）承担「这是一条目录项」和「当前在哪一段」两件事：
                   段与段首尾相接，未选中的淡色段连成一条完整导轨，选中那一段转强调色。
                   VerticalAlignment=Stretch 是关键：段高必须等于项高，
                   否则段之间会出现缝隙，「一条连续导轨」这个效果就没了。
                   取代原先居中的 5px 圆点——孤立圆点表达不出「在整体的哪一段」，
                   而且 5px 在亮色主题的淡色上几乎不可见。 -->
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Grid.Column="0"
                        Classes="index-rail-segment"
                        Width="2"
                        VerticalAlignment="Stretch" />
                <!-- MaxLines=2 + 省略号：Width=166 下三行标题会把项撑得很高，
                     整条索引跟着变长。截断后必须给 ToolTip 才看得到全称
                     （原先只有 AutomationProperties.Name，读屏能读、眼睛看不到）。 -->
                <TextBlock Grid.Column="1"
                           Classes="index-label"
                           Text="{Binding Title}"
                           FontSize="12.5"
                           TextWrapping="Wrap"
                           MaxLines="2"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           ToolTip.Tip="{Binding Title}"
                           AutomationProperties.Name="{Binding Title}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- 保存：右下角悬浮圆钮。各分页原本各自散着一个「保存」按钮（有的两个），
           作者要在长页里找它；收成一个固定落点后，位置与「改哪页存哪页」都不再需要想。
           只在本页有未保存改动时出现——没改动时它没有意义，露着反而让人怀疑漏了什么。 -->
      <Border HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="0,0,28,22"
              Width="48" Height="48"
              CornerRadius="24"
              IsVisible="{Binding HasUnsavedChanges}"
              BoxShadow="{DynamicResource Ariadne.Shadow.Flyout}">
        <Button Classes="primary settings-save-fab"
                Width="48" Height="48"
                Padding="0"
                Command="{Binding SaveCurrentTabCommand}"
                ToolTip.Tip="{Binding SaveCurrentTabText}"
                AutomationProperties.Name="{Binding SaveCurrentTabText}">
          <Path Classes="icon" Width="19" Height="19" Stretch="Uniform"
                Stroke="{DynamicResource Ariadne.TextOnAccent}"
                StrokeThickness="1.6"
                Data="M5,4 L15,4 L20,9 L20,20 L5,20 Z M8,4 L8,10 L15,10 L15,4 M9,20 L9,14 L16,14 L16,20" />
        </Button>
      </Border>
    </Panel>
  </Grid>
</UserControl>
