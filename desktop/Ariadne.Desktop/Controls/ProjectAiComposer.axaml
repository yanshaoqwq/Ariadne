<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Ariadne.Desktop.Controls"
             x:Class="Ariadne.Desktop.Controls.ProjectAiComposer"
             HorizontalAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             x:CompileBindings="False">
  <!--
    作品页 / 工作区共用的项目 AI 输入区。
    边框焦点走主题 Border.ai-composer:focus-within（唯一允许主题色描边的输入面）。
    内层 TextBox 无边框，靠外层一体 chrome + 光标反馈。

    ⚠️ U148：内层压平**不能只靠内联属性**。下面 TextBox 上的
    `BorderThickness="0"` / `Background="Transparent"` 语义正确（内层确实不该有边框），
    但它们设在 TextBox **自身**，而主题的焦点样式设在**模板内的
    `Border#PART_BorderElement`**——两者作用对象不同、压根不冲突，
    所以谁也没盖掉谁，于是一次聚焦画出两条主题色线（外框一条 + 内层一条）。
    真正生效的压平在主题里：`Border.ai-composer TextBox /template/ Border#PART_BorderElement`
    （声明位置必须在通用 TextBox 样式之后，否则会被盖掉，见 U154）。
    **别把内联属性当成压平手段**——它治不了模板层，只会让人以为治了。
  -->
  <!-- U164-E：**布局模型改了**，从「三行竖排」变成「单格叠放」。
       用户定的形状：「整个对话框应该是只有对话框大小，而其它控件都是浮在上方的」。

       ⚠️ **`MinHeight` 已连根删除，不要加回来。** 这不是「换了个更准的数」，
       是让高度不再由一个独立的数声明：
       - 旧模型 `RowDefinitions="Auto,*,Auto"` 下三个控件竖着抢高度，
         173 = 27 + 8 + 72 + 8 + 36 + 20 + 2，那笔加法**算得没错**，
         但它必须与 padding / spacing / 字号**逐项同步**，其中任一项变动
         （U144 的输入线改造就动了 padding）差值就重新出现。
         这个数因此失效过**两次**（128 → 173 → 实需 178），
         每次都是「把算出来的数抄进 XAML」这个修法本身的问题（U148 第三步）。
       - 现在高度只由 TextBox 的 `MinHeight="72"` 决定，外框自然包住它
         ⇒ **没有第二个数需要同步**，也就没有可漂移的余地。
       想限制「输入面不要无限长高」请挂 `MaxHeight` 在本 Border 或宿主行上
       （那才是限高的正确落点），不要恢复 `MinHeight`。

       AutoMode 已移到本控件**外面**（见宿主 `ProjectAiPanel`）：用户要求它
       「离开对话框，浮在对话框上，并没有任何边框」，且对话框高度不该包含它。
       发送键**仍在框内**、压在右下角遮住对话框——两者刻意分属不同层。 -->
  <Border Classes="ai-composer"
          HorizontalAlignment="Stretch"
          Padding="12,10">
    <!-- ⚠️ 单格 Panel，不是 Grid 的多行。改回 RowDefinitions 会让高度
         重新变成「输入框 + 发送键」之和，U164-E 就白做了。
         ⚠️ 发送键必须声明在 TextBox **之后**：Panel 里后声明的在上层，
            反过来它会被输入框盖住、点不到。 -->
    <Panel>
      <!-- ⚠️ 右侧让位用 `Padding` 而**不是** `Margin`：
           `Margin` 会缩小 TextBox 本体的可视区，滚动条与选区高亮跟着内缩，
           视觉上又变出一个内框——那正是 U148 花力气消掉的东西。
           `Padding` 只让文字避让，控件本身仍满格。
           44 = 发送键 36 + 右缘间隙 4 + 文字与键之间 4。 -->
      <TextBox Text="{Binding ProjectAiMessage, Mode=TwoWay}"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               BorderThickness="0"
               Background="Transparent"
               FontSize="13"
               MinHeight="72"
               MinWidth="0"
               HorizontalAlignment="Stretch"
               HorizontalContentAlignment="Stretch"
               Padding="0,0,44,0"
               VerticalContentAlignment="Top"
               VerticalAlignment="Stretch"
               PlaceholderText="{Binding ProjectAiPlaceholder}" />
      <Button Classes="primary"
              Width="36" Height="36" Padding="0"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Right"
              Margin="0,0,4,4"
              Command="{Binding SendProjectAiCommand}"
              ToolTip.Tip="{Binding ProjectAiText}"
              AutomationProperties.Name="{Binding ProjectAiText}">
        <Path Classes="icon" Width="16" Height="16"
              Stroke="{DynamicResource Ariadne.TextOnAccent}"
              Data="M4,12 L20,4 L14,20 L11,13 Z M11,13 L4,12" />
      </Button>
    </Panel>
  </Border>
</UserControl>
