<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ariadne.Desktop.Controls.EmptyStateArt"
             IsHitTestVisible="False">
  <!-- 模型线描空态 + Accent 重着色；无手写 Path 堆砌 -->
  <Panel>
    <Image x:Name="ArtImage"
           Stretch="Uniform"
           HorizontalAlignment="Center"
           VerticalAlignment="Center" />

    <!-- 次要页仍用轻量线描（非三主空态） -->
    <!-- 欢迎页空态 = Ariadne 之线尚未起头：一个线结 + 一根渐细渐淡的线，
         线走到一半就散进空白，正对应「还没有最近项目」。
         不用渐变笔刷（渐变到 Transparent 会在中段发灰），改用三段同色异透明度的
         首尾相接曲线，控制点保持切线连续，肉眼是一根连贯的线。 -->
    <Viewbox x:Name="WelcomeQuillArt" Stretch="Uniform" IsVisible="False">
      <Canvas Width="160" Height="72">
        <!-- 线结光晕：与首屏品牌徽记同一套光环语汇，让空态与页头呼应 -->
        <Ellipse Canvas.Left="12" Canvas.Top="30" Width="32" Height="32" Opacity="0.14">
          <Ellipse.Fill>
            <RadialGradientBrush GradientOrigin="50%,50%" Center="50%,50%" RadiusX="50%" RadiusY="50%">
              <GradientStop Offset="0.5" Color="{DynamicResource Ariadne.Color.AccentPrimary}" />
              <GradientStop Offset="1" Color="Transparent" />
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <!-- 线结本体：唯一的实心点，是整幅画的重心 -->
        <Ellipse Canvas.Left="24" Canvas.Top="42" Width="8" Height="8"
                 Fill="{DynamicResource Ariadne.AccentPrimary}" />
        <!-- 线的三段：粗→细、实→虚，首尾共点 -->
        <Path Stroke="{DynamicResource Ariadne.AccentPrimary}" StrokeThickness="2"
              StrokeLineCap="Round" Data="M28,46 C46,46 50,26 68,24" />
        <Path Stroke="{DynamicResource Ariadne.AccentPrimary}" StrokeThickness="1.6"
              StrokeLineCap="Round" Opacity="0.45" Data="M68,24 C86,22 92,44 110,46" />
        <Path Stroke="{DynamicResource Ariadne.AccentPrimary}" StrokeThickness="1.2"
              StrokeLineCap="Round" Opacity="0.18" Data="M110,46 C126,48 138,40 150,28" />
      </Canvas>
    </Viewbox>

    <Viewbox x:Name="RunLogArt" Stretch="Uniform" IsVisible="False">
      <Canvas Width="80" Height="64">
        <Path Stroke="{DynamicResource Ariadne.TextSubtle}" StrokeThickness="1.4" StrokeLineCap="Round"
              Data="M18,14 L62,14 M18,26 L54,26 M18,38 L58,38 M18,50 L48,50" />
        <Path Stroke="{DynamicResource Ariadne.AccentPrimary}" StrokeThickness="2" StrokeLineCap="Round"
              Data="M12,14 L12,14.01 M12,26 L12,26.01 M12,38 L12,38.01 M12,50 L12,50.01" />
      </Canvas>
    </Viewbox>

    <Viewbox x:Name="TemplatesArt" Stretch="Uniform" IsVisible="False">
      <Canvas Width="80" Height="64">
        <Path Stroke="{DynamicResource Ariadne.AccentPrimary}" StrokeThickness="1.5" StrokeLineCap="Round"
              Data="M16,12 L36,12 L36,32 L16,32 Z M44,12 L64,12 L64,32 L44,32 Z M16,40 L36,40 L36,56 L16,56 Z" />
        <Path Stroke="{DynamicResource Ariadne.TextSubtle}" StrokeThickness="1.3" StrokeLineCap="Round"
              Data="M44,40 L64,40 L64,56 L44,56 Z M20,18 L32,18 M20,24 L28,24" />
      </Canvas>
    </Viewbox>

    <Viewbox x:Name="ProjectAiArt" Stretch="Uniform" IsVisible="False">
      <Canvas Width="80" Height="64">
        <Path Stroke="{DynamicResource Ariadne.AccentPrimary}" StrokeThickness="1.6" StrokeLineCap="Round"
              Data="M18,14 L54,14 Q60,14 60,20 L60,34 Q60,40 54,40 L34,40 L24,50 L26,40 L18,40 Q12,40 12,34 L12,20 Q12,14 18,14 Z" />
        <Path Stroke="{DynamicResource Ariadne.TextSubtle}" StrokeThickness="1.3" StrokeLineCap="Round"
              Data="M22,24 L50,24 M22,32 L42,32" />
      </Canvas>
    </Viewbox>
  </Panel>
</UserControl>
